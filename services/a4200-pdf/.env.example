# HTTP listen port (Coolify: expose the same port)
PORT=8787

# DUKIntegrator paths (defaults match the Docker image layout)
DUK_JAR=/duk/dist/DUKIntegrator.jar
DUK_HOME=/duk/dist

# Request / Java limits
MAX_BODY_BYTES=26214400
REQUEST_TIMEOUT_MS=120000
JAVA_TIMEOUT_MS=90000

# Rate limiting
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000

# CORS (comma-separated origins allowed to call POST /a4200)
CORS_ORIGINS=https://tapselo.com,https://www.tapselo.com

# Behind Coolify/Cloudflare: set to 1 to rate-limit by CF-Connecting-IP / X-Forwarded-For
# TRUST_PROXY=1

# ZIP ingestion limits
MAX_ZIP_ENTRIES=64
MAX_UNZIPPED_BYTES=83886080
