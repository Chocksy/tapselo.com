---
// E1 menu bar on every marketing page: Produs, Pentru, Resurse panels (one box that grows from the chosen
// trigger, K1 moment 07 gray pill), phone menu with accordions. Sticky; hides on scroll down, returns on scroll up.
// Contract for sticky sub-bars: html[data-bar-hidden] while hidden, --bar-h for its height (global.css).
import SiteLogo from "./SiteLogo.astro";
import { tools, GUIDE_GROUPS, groupCount, guides } from "../data/resources.ts";

const svg = (d: string, s = 18, w = 1.8) =>
  `<svg width="${s}" height="${s}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="${w}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const I: Record<string, string> = {
  pc: '<rect x="2.5" y="4" width="19" height="13" rx="2"/><path d="M8 21h8M12 17v4"/>',
  ph: '<rect x="6" y="2" width="12" height="20" rx="2.5"/><path d="M11 18h2"/>',
  cd: '<rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20M6 15h4"/>',
  ad: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>',
  eq: '<path d="M6 9V3h12v6"/><rect x="3" y="9" width="18" height="8" rx="2"/><path d="M7 14h10v7H7z"/>',
  fx: '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
  cm: '<path d="M12 3v18M5 7h14M5 7l-3 7h6zM19 7l-3 7h6z"/>',
  ai: '<path d="M12 3l2 5.5 5.5 2-5.5 2L12 18l-2-5.5-5.5-2 5.5-2z"/>',
};
const CH = svg('<path d="m6 9 6 6 6-6"/>', 13, 2.4);
const CHB = svg('<path d="m6 9 6 6 6-6"/>', 18, 2.2);
const SR = svg('<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>', 16, 2);

type Item = { ic: string; name: string; href: string; line: string; tag?: string };
// Pages that do not exist yet point to the homepage sections.
const PRODUCT: [string, Item[]][] = [
  ["Vânzare", [
    { ic: "pc", name: "Casa de marcat", href: "/program-casa-de-marcat-pe-calculator/", line: "Pe orice PC, bon pe Datecs, și fără net" },
    { ic: "ph", name: "Casă de marcat pe telefon", href: "/casa-de-marcat-pe-telefon/", line: "Cauți produsul sau scanezi cu camera", tag: "Nou" },
    { ic: "cd", name: "Plata cu cardul", href: "/#features", line: "Tap to Pay pe telefon. Fără abonament", tag: "Nou" },
  ]],
  ["Administrare", [
    { ic: "ad", name: "Admin", href: "/admin/", line: "Stoc, rețete, rapoarte și campanii" },
    { ic: "eq", name: "Echipamente", href: "/#echipamente", line: "Datecs FP-700, cântar Dibal, cititor USB" },
    { ic: "fx", name: "Toate funcțiile", href: "/#features", line: "Recepție NIR, cupoane, oferte și altele" },
  ]],
];
const SHOPS = [
  { c: "s-m", img: "kiosk-scanare", tag: "Ecran Scanare", soon: "", name: "Magazin alimentar", text: "Scanezi codul, cântarul pune greutatea, bonul iese pe Datecs.", href: "/#magazin", guide: "/ghid/deschide-minimarket-alimentara/", guideLabel: "Ghid: Cum deschizi o alimentară", dot: "#2563eb" },
  { c: "s-b", img: "kiosk-vitrina", tag: "Ecran Vitrină", soon: "în curând", name: "Brutărie, patiserie, cofetărie", text: "O atingere pe covrig, o bucată în coș. Pâinea la kg vine din cântar.", href: "/#brutarie", guide: "/ghid/deschide-brutarie-patiserie/", guideLabel: "Ghid: Cum deschizi o brutărie", dot: "#b45309" },
  { c: "s-c", img: "kiosk-bar", tag: "Ecran Bar", soon: "în curând", name: "Cafenea și bar", text: "Comenzi cu număr, ovăz și shot în plus pe același rând.", href: "/#cafenea", guide: "/ghid/deschide-cafenea-bistro/", guideLabel: "Ghid: Cum deschizi o cafenea", dot: "#c2410c" },
];
const MORE: Item[] = [
  { ic: "cm", name: "Comparație", href: "/comparatie/", line: "Tapselo lângă alte programe POS" },
  { ic: "ai", name: "Asistent AI", href: "/ai/", line: "Tapselo în Claude și ChatGPT" },
];
const TRIGGERS = [["pr", "Produs"], ["pe", "Pentru"], ["re", "Resurse"]] as const;
const AR = '<span class="sb-ar" aria-hidden="true">›</span>';
---

<div class="sb-scrim" aria-hidden="true"></div>
<header class="sb" data-sb>
  <nav aria-label="Principal">
    <div class="site-container sb-in">
      <a class="sb-brand" href="/"><SiteLogo class="sb-logo" />Tapselo</a>

      <div class="sb-trs" data-trs>
        <span class="sb-pill" aria-hidden="true"></span>
        {TRIGGERS.map(([p, t]) => (
          <button type="button" class="sb-t" data-p={p} aria-expanded="false" aria-controls={`sb-${p}`}>{t} <Fragment set:html={CH} /></button>
        ))}
        <a class="sb-t" href="/#pricing">Prețuri</a>
      </div>

      <span class="sb-sp"></span>
      <a class="sb-login" href="https://app.tapselo.com" data-tapselo-cta="header">Intră în cont</a>
      <a class="sb-cta" href="https://app.tapselo.com/?demo=1" data-tapselo-cta="header">Încearcă demo <Fragment set:html={svg('<path d="M5 12h14M13 6l6 6-6 6"/>', 15, 2.4)} /></a>
      <button type="button" class="sb-burger" aria-label="Deschide meniul" aria-expanded="false" aria-controls="sb-mm" data-mm-open>
        <Fragment set:html={svg('<path d="M4 7h16M4 12h16M4 17h16"/>', 20, 2.2)} />
      </button>

      <div class="sb-pos" data-pos>
        <div class="sb-dd" data-dd>
          <span class="sb-bg" data-bg></span>
          <i class="sb-ct" data-ct></i>

          <div class="sb-pa sb-p-pr" id="sb-pr" data-pa="pr">
            {PRODUCT.map(([h, items]) => (
              <div class="sb-col">
                <p class="sb-h6">{h}</p>
                {items.map((it) => (
                  <a class="sb-it" href={it.href}>
                    <span class="sb-ic" set:html={svg(I[it.ic])} />
                    <span><span class="sb-nm">{it.name}{it.tag && <em>{it.tag}</em>}</span><span class="sb-ln">{it.line}</span></span>
                  </a>
                ))}
              </div>
            ))}
            <div class="sb-side">
              <p class="sb-h6">Nou</p>
              <a class="sb-fc" href="/casa-de-marcat-pe-telefon/">
                <span class="sb-fm"><img data-src="/menu/phone-sale.webp" alt="" width="148" height="311" decoding="async" /></span>
                <span class="sb-fb"><b>Casa de marcat pe telefon</b><span class="sb-fd">Cauți produsul după nume sau scanezi codul cu camera.</span><u>Vezi pagina <Fragment set:html={AR} /></u></span>
              </a>
            </div>
            <div class="sb-ft"><span>Beta gratuit acum · 0 lei licențe</span><a href="/#pricing">Vezi prețurile <Fragment set:html={AR} /></a></div>
          </div>

          <div class="sb-pa sb-p-pe" id="sb-pe" data-pa="pe">
            <div class="sb-ph6"><b>PENTRU MAGAZINUL TĂU</b><span>Același cont. Ecranul de vânzare se potrivește cu ce vinzi.</span></div>
            <div class="sb-cds">
              {SHOPS.map((s) => (
                <div class={`sb-cd ${s.c}`}>
                  <span class="sb-cm"><img data-src={`/menu/${s.img}.webp`} alt="" width="282" height="162" decoding="async" /></span>
                  <div class="sb-cbd">
                    <span class="sb-tg">{s.tag}{s.soon && <i>· {s.soon}</i>}</span>
                    <span class="sb-cn">{s.name}</span>
                    <span class="sb-cp">{s.text}</span>
                    <div class="sb-cl"><a href={s.href}>Vezi pagina <Fragment set:html={AR} /></a><a href={s.guide}>{s.guideLabel} <Fragment set:html={AR} /></a></div>
                  </div>
                </div>
              ))}
            </div>
            <div class="sb-ft"><span>Toate trei: același admin, aceleași rapoarte, același Datecs.</span><a href="/comparatie/">Comparație cu alte programe <Fragment set:html={AR} /></a></div>
          </div>

          <div class="sb-pa sb-p-re" id="sb-re" data-pa="re">
            <div class="sb-col sb-col-u">
              <p class="sb-h6">Unelte gratuite · {tools.length} <a href="/unelte/">Toate uneltele <Fragment set:html={AR} /></a></p>
              <div class="sb-tl">{tools.map((t) => <a class:list={[{ hot: t.hot }]} href={t.href}>{t.title}</a>)}</div>
            </div>
            <div class="sb-col">
              <p class="sb-h6">Ghiduri · {guides.length} <a href="/ghid/">Tot ghidul <Fragment set:html={AR} /></a></p>
              {GUIDE_GROUPS.map((gr) => (
                <a class="sb-gg" href={`/ghid/#${gr.id}`}><span class="sb-gn">{gr.label}<span class="sb-n">{groupCount(gr.id)}</span></span><span class="sb-gs">{gr.blurb}</span></a>
              ))}
            </div>
            <div class="sb-side">
              <p class="sb-h6">Mai mult</p>
              {MORE.map((it) => (
                <a class="sb-it" href={it.href}>
                  <span class="sb-ic" set:html={svg(I[it.ic])} />
                  <span><span class="sb-nm">{it.name}</span><span class="sb-ln">{it.line}</span></span>
                </a>
              ))}
            </div>
            <div class="sb-ft"><i>Cele mai folosite unelte</i></div>
          </div>
        </div>
      </div>
    </div>
  </nav>
</header>

<div class="mm" id="sb-mm" data-mm role="dialog" aria-modal="true" aria-label="Meniu" hidden>
    <div class="mm-h">
      <a class="sb-brand" href="/"><SiteLogo class="sb-logo" />Tapselo</a>
      <button type="button" class="mm-x" aria-label="Închide meniul" data-mm-close set:html={svg('<path d="M18 6 6 18M6 6l12 12"/>', 20, 2.2)} />
    </div>
    <details class="mm-acc">
      <summary>Produs <Fragment set:html={CHB} /></summary>
      <div class="mm-bd">
        {PRODUCT.flatMap(([, items]) => items).map((it) => (
          <a class="sb-it" href={it.href}>
            <span class="sb-ic" set:html={svg(I[it.ic])} />
            <span><span class="sb-nm">{it.name}{it.tag && <em>{it.tag}</em>}</span><span class="sb-ln">{it.line}</span></span>
          </a>
        ))}
      </div>
    </details>
    <details class="mm-acc">
      <summary>Pentru <Fragment set:html={CHB} /></summary>
      <div class="mm-bd">
        {SHOPS.map((s) => <a class="mm-sl" href={s.href}><i style={`background:${s.dot}`}></i>{s.name}</a>)}
      </div>
    </details>
    <details class="mm-acc" data-mm-re>
      <summary>Resurse <Fragment set:html={CHB} /></summary>
      <div class="mm-bd">
        <label class="mm-q"><Fragment set:html={SR} /><input type="search" placeholder="Caută o unealtă sau un ghid" aria-label="Caută o unealtă sau un ghid" autocomplete="off" data-mm-q /></label>
        <div class="mm-rs" data-mm-rs hidden></div>
        <div data-mm-list>
          <a class="mm-sl" href="/unelte/">Unelte gratuite<span class="sb-n">{tools.length}</span></a>
          <p class="mm-h6">Ghiduri · {guides.length}</p>
          {GUIDE_GROUPS.map((gr) => <a class="mm-sl" href={`/ghid/#${gr.id}`}>{gr.label}<span class="sb-n">{groupCount(gr.id)}</span></a>)}
          <a class="mm-sl mm-sep" href="/comparatie/">Comparație</a>
          <a class="mm-sl" href="/ai/">Asistent AI</a>
        </div>
      </div>
    </details>
    <a class="mm-pl" href="/#pricing">Prețuri <Fragment set:html={svg('<path d="m9 6 6 6-6 6"/>', 18, 2.2)} /></a>
    <div class="mm-pb">
      <a class="mm-o" href="https://app.tapselo.com" data-tapselo-cta="header">Intră în cont</a>
      <a class="sb-cta" href="https://app.tapselo.com/?demo=1" data-tapselo-cta="header">Încearcă demo</a>
    </div>
</div>

<script>
  import { searchResources, TYPE_LABEL } from "../data/resources.ts";

  const root = document.documentElement;
  const bar = document.querySelector<HTMLElement>("[data-sb]")!;
  const trs = bar.querySelector<HTMLElement>("[data-trs]")!;
  const pill = trs.querySelector<HTMLElement>(".sb-pill")!;
  const ts = [...trs.querySelectorAll<HTMLButtonElement>("button.sb-t")];
  const allT = [...trs.querySelectorAll<HTMLElement>(".sb-t")];
  const pos = bar.querySelector<HTMLElement>("[data-pos]")!;
  const dd = bar.querySelector<HTMLElement>("[data-dd]")!;
  const bg = bar.querySelector<HTMLElement>("[data-bg]")!;
  const ct = bar.querySelector<HTMLElement>("[data-ct]")!;
  const ps = [...dd.querySelectorAll<HTMLElement>("[data-pa]")];
  const ORD: Record<string, number> = { pr: 0, pe: 1, re: 2 };
  let cur: string | null = null;
  let tm = 0;

  // K1 07: one pill slides between triggers (transform only; scaleX from a 100px base).
  const movePill = (t: HTMLElement | null) => {
    if (!t) return void pill.classList.remove("on");
    const snap = !pill.classList.contains("on");
    pill.classList.toggle("snap", snap);
    pill.style.transform = `translateX(${t.offsetLeft}px) scaleX(${t.offsetWidth / 100})`;
    if (snap) void pill.offsetWidth;
    pill.classList.add("on");
    if (snap) requestAnimationFrame(() => pill.classList.remove("snap"));
  };

  const place = (p: string, snap: boolean) => {
    const t = ts.find((x) => x.dataset.p === p)!;
    const pa = ps.find((x) => x.dataset.pa === p)!;
    const W = pa.offsetWidth;
    const maxH = Math.max(...ps.map((x) => x.offsetHeight));
    const H = pa.offsetHeight;
    const host = pos.parentElement!.getBoundingClientRect();
    const cx = trs.offsetLeft + t.offsetLeft + t.offsetWidth / 2;
    // Keep the box 16px inside the viewport.
    const L = Math.max(16 - host.left, Math.min(cx - W * 0.3, innerWidth - 16 - host.left - W));
    dd.classList.toggle("snap", snap);
    dd.style.width = W + "px";
    dd.style.height = maxH + "px";
    pos.style.transform = `translateX(${L}px)`;
    bg.style.transform = `scaleY(${H / maxH})`;
    dd.style.setProperty("--ox", cx - L + "px");
    ct.style.transform = `translateX(${cx - L - 6}px) rotate(45deg)`;
  };

  // Menu thumbnails load on the first open only (the panels are hidden on every page until then).
  let imgs = false;
  const open = (p: string) => {
    clearTimeout(tm);
    if (cur === p) return;
    if (!imgs) {
      imgs = true;
      for (const im of dd.querySelectorAll<HTMLImageElement>("img[data-src]")) im.src = im.dataset.src!;
    }
    const was = cur;
    for (const x of ps) {
      const k = ORD[x.dataset.pa!], i = ORD[p];
      x.classList.toggle("on", k === i);
      x.classList.toggle("l", k < i);
      x.classList.toggle("r", k > i);
    }
    place(p, !was);
    if (!was) void dd.offsetWidth;
    dd.classList.add("show");
    root.dataset.menuOpen = "";
    for (const x of ts) x.setAttribute("aria-expanded", String(x.dataset.p === p));
    movePill(ts.find((x) => x.dataset.p === p)!);
    cur = p;
    if (!was) requestAnimationFrame(() => dd.classList.remove("snap"));
  };

  const close = () => {
    clearTimeout(tm);
    if (!cur) return;
    cur = null;
    dd.classList.remove("show");
    delete root.dataset.menuOpen;
    for (const x of ts) x.setAttribute("aria-expanded", "false");
    if (!trs.matches(":hover")) movePill(null);
  };
  const later = () => { clearTimeout(tm); tm = window.setTimeout(close, 260); };

  ts.forEach((t, i) => {
    t.addEventListener("pointerenter", (e) => {
      if (e.pointerType === "touch") return;
      clearTimeout(tm);
      tm = window.setTimeout(() => open(t.dataset.p!), cur ? 0 : 70);
    });
    // A mouse click only opens (hover already did); mouse users close by leaving. Keyboard (detail 0) and touch toggle.
    let pt = "";
    t.addEventListener("pointerdown", (e) => (pt = e.pointerType));
    t.addEventListener("click", (e) => {
      const mouse = e.detail > 0 && ((e as PointerEvent).pointerType || pt) === "mouse";
      if (cur === t.dataset.p && !mouse) close();
      else open(t.dataset.p!);
    });
    t.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        open(t.dataset.p!);
        setTimeout(() => ps.find((x) => x.dataset.pa === t.dataset.p)?.querySelector("a")?.focus(), 40);
      }
      if (e.key === "ArrowRight" || e.key === "ArrowLeft") {
        e.preventDefault();
        ts[(i + (e.key === "ArrowRight" ? 1 : ts.length - 1)) % ts.length].focus();
      }
    });
  });
  for (const t of allT) t.addEventListener("pointerenter", () => { if (!cur || !t.dataset.p) movePill(t); });
  trs.querySelector("a.sb-t")!.addEventListener("pointerenter", () => close());
  trs.addEventListener("pointerleave", () => { if (!cur) movePill(null); });
  for (const z of [trs, dd]) {
    z.addEventListener("pointerleave", later);
    z.addEventListener("pointerenter", () => clearTimeout(tm));
  }
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape" || !cur) return;
    const t = ts.find((x) => x.dataset.p === cur);
    const had = bar.contains(document.activeElement);
    close();
    if (had) t?.focus();
  });
  bar.addEventListener("focusout", (e) => { if (!bar.contains(e.relatedTarget as Node)) close(); });
  document.addEventListener("pointerdown", (e) => { if (cur && !bar.contains(e.target as Node)) close(); });
  addEventListener("resize", () => { if (cur) place(cur, true); });

  // Hide on scroll down, show on scroll up; never while a menu is open or focused.
  let lastY = scrollY;
  addEventListener("scroll", () => {
    const y = scrollY, d = y - lastY;
    if (Math.abs(d) < 6) return;
    const hide = d > 0 && y > 160 && !cur && !bar.contains(document.activeElement);
    if (hide) root.dataset.barHidden = "";
    else delete root.dataset.barHidden;
    lastY = y;
  }, { passive: true });
  bar.addEventListener("focusin", () => delete root.dataset.barHidden);

  // Phone menu.
  const mm = document.querySelector<HTMLElement>("[data-mm]")!;
  const burger = bar.querySelector<HTMLButtonElement>("[data-mm-open]")!;
  // Modal: while open, everything outside it is inert and Tab cycles inside it.
  let outside: HTMLElement[] = [];
  const setInert = (on: boolean) => {
    if (!on) return void (outside.forEach((x) => (x.inert = false)), (outside = []));
    for (let n: HTMLElement = mm; n !== document.body && n.parentElement; n = n.parentElement)
      for (const s of n.parentElement.children as HTMLCollectionOf<HTMLElement>)
        if (s !== n && !s.inert) (s.inert = true), outside.push(s);
  };
  const mmOpen = (on: boolean) => {
    if (mm.hidden === !on) return;
    mm.hidden = !on;
    burger.setAttribute("aria-expanded", String(on));
    root.classList.toggle("mm-lock", on);
    setInert(on);
    if (on) mm.querySelector<HTMLElement>("[data-mm-close]")!.focus();
    else burger.focus();
  };
  const tabbable = () =>
    [...mm.querySelectorAll<HTMLElement>("a[href], button, input, summary")].filter((x) => x.getClientRects().length && (x.checkVisibility?.() ?? true));
  burger.addEventListener("click", () => mmOpen(true));
  mm.querySelector("[data-mm-close]")!.addEventListener("click", () => mmOpen(false));
  document.addEventListener("keydown", (e) => {
    if (mm.hidden) return;
    if (e.key === "Escape") return mmOpen(false);
    if (e.key !== "Tab") return;
    const f = tabbable(), a = document.activeElement as HTMLElement | null;
    const i = a ? f.indexOf(a) : -1;
    if (i < 0 || (e.shiftKey && i === 0) || (!e.shiftKey && i === f.length - 1)) {
      e.preventDefault();
      f[e.shiftKey ? (i <= 0 ? f.length - 1 : i - 1) : i < 0 || i === f.length - 1 ? 0 : i + 1]?.focus();
    }
  });
  mm.addEventListener("click", (e) => { if ((e.target as HTMLElement).closest("a")) mmOpen(false); });

  const q = mm.querySelector<HTMLInputElement>("[data-mm-q]")!;
  const rs = mm.querySelector<HTMLElement>("[data-mm-rs]")!;
  const list = mm.querySelector<HTMLElement>("[data-mm-list]")!;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => `&#${c.charCodeAt(0)};`);
  q.addEventListener("input", () => {
    const v = q.value.trim();
    rs.hidden = !v;
    list.hidden = !!v;
    if (!v) return;
    const r = searchResources(v);
    rs.innerHTML = r.length
      ? r.slice(0, 8).map(({ r }) => `<a class="mm-sl" href="${r.href}"><em>${TYPE_LABEL[r.type]}</em>${esc(r.title)}</a>`).join("")
      : `<p class="mm-r0">Nimic pentru „${esc(v)}”. Încearcă „TVA”, „Z” sau „NIR”.</p>`;
  });
</script>

<style is:global>
  .sb-scrim { position: fixed; inset: 0; z-index: 49; background: rgba(246, 242, 233, .55); backdrop-filter: blur(4px); opacity: 0; pointer-events: none; transition: opacity .2s var(--ease-out-soft); }
  html[data-menu-open] .sb-scrim { opacity: 1; }
  .sb { position: sticky; top: 0; z-index: 50; height: var(--bar-h); background: color-mix(in srgb, var(--color-paper-white) 94%, transparent); backdrop-filter: blur(8px); transition: transform .24s var(--ease-out-soft); color: var(--color-ink); }
  .sb::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: radial-gradient(circle, var(--color-perf) .9px, transparent 1.1px) 0 0 / 6px 2px; pointer-events: none; }
  html[data-bar-hidden] .sb { transform: translateY(-100%); }
  .sb a { color: inherit; text-decoration: none; }
  .sb button { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
  .sb-in { position: relative; display: flex; align-items: center; height: var(--bar-h); }
  .sb-brand { display: flex; align-items: center; gap: 10px; font-size: 19px; font-weight: 650; letter-spacing: -.02em; margin-right: 30px; }
