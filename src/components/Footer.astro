---
import { Github } from "@lucide/astro";
import { internalPath } from "../lib/internal-url.ts";
import { CHATGPT_APP_URL } from "../lib/mcp/links.ts";
import {
  toolLinks,
  ruleGuideLinks,
  shopGuideLinks,
  articleLinks,
  guideHubLinks,
} from "../lib/site-directory.ts";
import OperatorLine from "./OperatorLine.astro";
import SiteLogo from "./SiteLogo.astro";
import WithdrawConsent from "./WithdrawConsent.astro";

const navClass = "text-sm font-medium text-text-on-primary-muted transition-colors hover:text-white";
const colTitle = "text-xs font-bold uppercase tracking-wide text-text-on-primary-muted";
const colLink = "text-sm text-text-on-primary-muted transition-colors hover:text-white";
---

<footer class="border-t border-white/10 bg-primary py-12">
  <div class="site-container">
    <div class="flex flex-col gap-10 lg:flex-row lg:items-start lg:justify-between">
      <div class="flex shrink-0 items-center gap-2 self-start">
        <SiteLogo class="h-7 w-7 rounded" />
        <span class="text-sm font-bold text-white">Tapselo POS</span>
      </div>

      <div class="grid flex-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
        <div>
          <p class={colTitle}>Produs</p>
          <div class="mt-3 flex flex-col gap-2">
            <a href={internalPath("/#features")} class={colLink}>Funcționalități</a>
            <a href={internalPath("/#how-it-works")} class={colLink}>Cum funcționează</a>
            <a href={internalPath("/#echipamente")} class={colLink}>Echipamente</a>
            <a href={internalPath("/program-gestiune-magazin")} class={colLink}>Program gestiune magazin</a>
            <a href={internalPath("/demo")} class={colLink}>Demo</a>
            <a href={internalPath("/#contact")} class={colLink}>Contact</a>
          </div>
        </div>
        <div>
          <p class={colTitle}>Unelte gratuite</p>
          <ul class="mt-3 space-y-2">
            <li><a href={internalPath("/unelte")} class={colLink}>Toate uneltele</a></li>
            {toolLinks.map((item) => (
              <li><a href={item.href} class={colLink}>{item.label}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <p class={colTitle}>Ghid magazine</p>
          <ul class="mt-3 space-y-2">
            {guideHubLinks.map((item) => (
              <li><a href={item.href} class={colLink}>{item.label}</a></li>
            ))}
            {ruleGuideLinks.map((item) => (
              <li><a href={item.href} class={colLink}>{item.label}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <p class={colTitle}>Deschide magazin</p>
          <ul class="mt-3 space-y-2">
            {shopGuideLinks.map((item) => (
              <li><a href={item.href} class={colLink}>{item.label}</a></li>
            ))}
          </ul>
          <p class={`${colTitle} mt-6`}>Articole</p>
          <ul class="mt-3 space-y-2">
            {articleLinks.map((item) => (
              <li><a href={item.href} class={colLink}>{item.label}</a></li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-x-6 gap-y-3 border-t border-white/10 pt-8">
      <a href={internalPath("/unelte")} class={navClass}>Unelte gratuite</a>
      <a href={internalPath("/ghid")} class={navClass}>Ghid</a>
      <a href={internalPath("/ai")} class={navClass}>Asistent AI</a>
      <a href={CHATGPT_APP_URL} target="_blank" rel="noopener noreferrer" class={navClass}>Deschideți în ChatGPT</a>
      <a href={internalPath("/comparatie")} class={navClass}>Comparație</a>
      <WithdrawConsent class={`${navClass} underline`} wrapClass="order-last basis-full text-center text-sm text-text-on-primary-muted" />
      <a
        href="https://github.com/Chocksy/tapselo-pos"
        target="_blank"
        rel="noopener noreferrer"
        class="text-text-on-primary-muted transition-colors hover:text-white"
        aria-label="GitHub repository"
      >
        <Github class="h-4 w-4" />
      </a>
    </div>

    <div class="mt-8 flex flex-col items-center gap-3 text-center">
      <OperatorLine />
      <p class="text-sm text-text-on-primary-muted">&copy; 2026 Tapselo. Toate drepturile rezervate.</p>
      <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
        <a href={internalPath("/privacy")} class="text-xs text-text-on-primary-muted transition-colors hover:text-white">Confidențialitate</a>
        <span class="text-xs text-text-on-primary-faint" aria-hidden="true">&middot;</span>
        <a href={internalPath("/extensii/verificare-cui/confidentialitate/")} class="text-xs text-text-on-primary-muted transition-colors hover:text-white">Extensie Verificare CUI</a>
        <span class="text-xs text-text-on-primary-faint" aria-hidden="true">&middot;</span>
        <a href={internalPath("/data-deletion")} class="text-xs text-text-on-primary-muted transition-colors hover:text-white">Ștergerea datelor</a>
        <span class="text-xs text-text-on-primary-faint" aria-hidden="true">&middot;</span>
        <a href={internalPath("/terms")} class="text-xs text-text-on-primary-muted transition-colors hover:text-white">Termeni</a>
        <span class="text-xs text-text-on-primary-faint" aria-hidden="true">&middot;</span>
        <a href={internalPath("/dpa")} class="text-xs text-text-on-primary-muted transition-colors hover:text-white">Acord de prelucrare a datelor</a>
      </div>
    </div>
  </div>
</footer>
