---
import { Check, ArrowRight } from "@lucide/astro";
import { internalPath } from "../lib/internal-url.ts";

const plans = [
  { name: "Start", price: 79, tills: "1 casă de marcat", note: "Pentru cafenele și magazine mici" },
  { name: "Magazin", price: 129, tills: "2 case de marcat", note: "Pentru magazine alimentare", featured: true },
];

const included = [
  "Casa de marcat care merge și fără internet",
  "Bon fiscal: conectezi imprimanta și gata",
  "Cântar integrat, prețul apare automat",
  "Rapoarte de vânzări cu recomandări automate",
  "Inventar cu telefonul, rețete și producție",
  "Clienți, cupoane și pagina de oferte",
  "Import produse din programul vechi",
  "Se actualizează singur, fără opriri",
];

const extras = [
  ["Casă de marcat în plus", "+39 lei"],
  ["Magazin în plus", "+99 lei"],
  ["Plătești 10 luni, primești 12", "anual"],
  ["În beta", "gratis"],
];
---

<section id="pricing" class="bg-surface py-24">
  <div class="mx-auto max-w-6xl px-6">
    <div class="max-w-2xl">
      <h2 class="animate-on-scroll font-display text-4xl italic text-primary sm:text-5xl">
        Prețuri simple. <span class="text-accent">Totul inclus.</span>
      </h2>
      <p class="animate-on-scroll animate-delay-100 mt-5 inline-flex items-center rounded-full bg-cash-light px-4 py-1.5 text-sm font-bold text-cash ring-1 ring-cash/30">
        Beta: totul e gratuit acum
      </p>
      <p class="animate-on-scroll animate-delay-100 mt-4 text-lg leading-relaxed text-text-secondary">
        Cât timp suntem în beta, Tapselo e gratuit, fără card. Prețurile de mai jos se aplică după beta și te anunțăm cu 30 de zile înainte.
        <a href={internalPath("/program-gestiune-magazin/")} class="font-semibold text-accent hover:underline">Vezi programul de gestiune pentru magazin</a>.
      </p>
      <p class="animate-on-scroll animate-delay-100 mt-3 text-base font-bold text-primary">
        Bonus: primele 20 de magazine din beta păstrează pe viață prețul de mai jos, fără scumpiri.
      </p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      {plans.map((plan) => (
        <div class:list={[
          "animate-on-scroll flex flex-col rounded-xl border bg-surface-white p-8 transition-shadow duration-300 hover:shadow-xl",
          plan.featured ? "border-accent ring-1 ring-accent" : "border-border",
        ]}>
          <h3 class="text-lg font-bold text-primary">Tapselo {plan.name}</h3>
          <p class="mt-1 text-sm text-text-secondary">{plan.note}</p>
          <p class="mt-6 flex items-baseline gap-3">
            <span class="font-display text-5xl italic text-cash">Gratis</span>
            <span class="text-sm font-medium text-text-secondary"><s>{plan.price} lei</s> / lună + TVA</span>
          </p>
          <p class="mt-2 text-sm font-bold text-text">{plan.tills}</p>
          <a
            href="https://app.tapselo.com"
            data-tapselo-cta="pricing"
            class:list={[
              "group mt-8 flex w-full items-center justify-center gap-2 rounded-md py-3.5 text-base font-bold transition-all active:scale-[0.98]",
              plan.featured ? "bg-accent text-white hover:bg-accent-hover hover:shadow-lg" : "bg-primary text-white hover:bg-primary-light hover:shadow-lg",
            ]}
          >
            Începe gratuit
            <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
          </a>
          <a href="https://app.tapselo.com/?demo=1" data-tapselo-cta="pricing" class="mt-3 text-center text-sm font-medium text-text-secondary underline-offset-4 hover:text-primary hover:underline">
            sau încearcă demo-ul
          </a>
        </div>
      ))}

      <div class="animate-on-scroll animate-from-right rounded-xl border border-border bg-surface-white p-8">
        <h3 class="text-lg font-bold text-primary">Ambele planuri includ:</h3>
        <ul class="mt-5 space-y-3">
          {included.map((item) => (
            <li class="flex items-start gap-3">
              <Check class="mt-0.5 h-5 w-5 shrink-0 text-success" />
              <span class="text-sm font-medium text-text">{item}</span>
            </li>
          ))}
        </ul>
        <dl class="mt-6 space-y-2 border-t border-border pt-5">
          {extras.map(([label, value]) => (
            <div class="flex justify-between gap-4 text-sm">
              <dt class="text-text-secondary">{label}</dt>
              <dd class="font-bold text-text">{value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>
