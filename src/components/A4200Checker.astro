---
import { ANAF_VALIDATOR_VERSIONS, XSD_BUNDLE, VERIFIED_ON } from "../lib/a4200/constants.ts";
import { formatDateRo } from "../lib/mcp/text.ts";
import { WIZARD_STEP_COUNT } from "../lib/a4200/wizard.ts";

const a4200PdfBase = import.meta.env.PUBLIC_A4200_PDF_URL?.replace(/\/$/, "") ?? "";
---

<div
  id="a4200-checker"
  class="mx-auto max-w-xl space-y-6"
  data-pdf-service={a4200PdfBase || undefined}
  data-wizard-steps={WIZARD_STEP_COUNT}
>
  <div class="space-y-2" aria-live="polite">
    <p id="a4200-progress" class="text-sm font-semibold text-accent">Pasul 1 din 4</p>
    <div
      class="h-2 overflow-hidden rounded-full bg-border-light"
      role="progressbar"
      id="a4200-progressbar"
      aria-valuemin="1"
      aria-valuemax={WIZARD_STEP_COUNT}
      aria-valuenow="1"
    >
      <div id="a4200-progress-fill" class="h-full w-1/4 bg-accent transition-all duration-300" />
    </div>
  </div>

  <!-- Step 1 -->
  <section id="a4200-step-1" class="a4200-step space-y-4" data-step="1" aria-labelledby="a4200-step-1-title">
    <h2 id="a4200-step-1-title" class="font-display text-2xl italic text-primary" tabindex="-1">
      Încarcă arhiva de la service
    </h2>
    <p class="text-sm leading-relaxed text-text-secondary">
      Poți încărca arhiva <strong>.zip</strong> primită de la service, un folder întreg sau fișierele individuale de pe stick.
      Verificarea inițială rulează pe calculatorul tău — nu trimitem conținutul către server la acest pas.
    </p>
    <div
      class="rounded-xl border-2 border-dashed border-border-light bg-surface p-6 text-center transition-colors sm:p-8"
      id="a4200-drop"
      data-active-class="border-accent bg-ticket-light/40"
    >
      <p class="text-base font-semibold text-primary sm:text-lg">Trage aici arhiva sau fișierele</p>
      <p class="mt-2 text-sm text-text-secondary">O arhivă .zip sau exportul lunar de la casă.</p>
      <label
        class="mt-5 inline-flex min-h-11 cursor-pointer items-center justify-center rounded-md bg-accent px-6 py-3 text-sm font-bold text-white hover:bg-accent-hover"
      >
        Alege fișiere
        <input type="file" id="a4200-file-input" class="hidden" multiple accept=".p7b,.xml,.zip,.p7s" />
      </label>
      <label
        class="mt-3 block cursor-pointer text-sm font-medium text-accent hover:text-accent-hover sm:inline-block sm:ml-3"
      >
        sau un folder întreg
        <input type="file" id="a4200-folder-input" class="hidden" webkitdirectory multiple />
      </label>
      <p id="a4200-file-hint" class="mt-4 text-xs text-text-muted" />
    </div>
  </section>

  <!-- Step 2 -->
  <section
    id="a4200-step-2"
    class="a4200-step hidden space-y-4"
    data-step="2"
    aria-labelledby="a4200-step-2-title"
    hidden
  >
    <h2 id="a4200-step-2-title" class="font-display text-2xl italic text-primary" tabindex="-1">Verificăm fișierele</h2>
    <div id="a4200-plain-summary" class="rounded-xl border border-border-light bg-surface p-5 text-sm leading-relaxed" />
    <div id="a4200-mixed-month-box" class="hidden space-y-3 rounded-xl border border-amber-200 bg-amber-50/80 p-4 text-sm" hidden />
    <ul id="a4200-info-lines" class="hidden list-disc space-y-1 pl-5 text-sm text-text-muted" />
    <ul id="a4200-missing-list" class="hidden list-disc space-y-2 pl-5 text-sm text-text-secondary" />
    <p id="a4200-step2-hint" class="text-sm text-text-muted" />
  </section>

  <!-- Step 3 -->
  <section
    id="a4200-step-3"
    class="a4200-step hidden space-y-4"
    data-step="3"
    aria-labelledby="a4200-step-3-title"
    hidden
  >
    <h2 id="a4200-step-3-title" class="font-display text-2xl italic text-primary" tabindex="-1">
      Descarcă PDF-ul și semnează-l
    </h2>
    <p class="text-sm leading-relaxed text-text-secondary">
      Generează PDF-ul declarației, semnează-l electronic cu certificatul firmei, apoi încarcă aici PDF-ul semnat. Îl
      pregătim automat pentru portalul ANAF.
    </p>
    {
      a4200PdfBase ? (
        <p class="text-xs text-text-muted">
          La generarea PDF, fișierele de la casă sunt trimise criptat către serverul Tapselo, procesate în memorie și
          șterse imediat după răspuns.
        </p>
      ) : (
        <p class="text-xs text-amber-800 rounded-md border border-amber-200 bg-amber-50/80 p-3">
          Generarea PDF nu este disponibilă momentan pe acest site. Poți folosi programul de la ANAF pe calculatorul tău
          sau reveni mai târziu.
        </p>
      )
    }
    <ol class="list-decimal space-y-2 pl-5 text-sm text-text-secondary">
      <li>Apasă butonul de mai jos și salvează PDF-ul pe calculator.</li>
      <li>
        Deschide <strong>certSIGN webSIGN</strong> (sau aplicația de semnare pe care o folosești) și semnează PDF-ul cu
        certificatul calificat al firmei.
      </li>
      <li>Încarcă PDF-ul semnat — îl pregătim pentru încărcarea la ANAF.</li>
    </ol>
    <div id="a4200-pdf-groups" class="hidden space-y-4" hidden />
    <p id="a4200-pdf-status" class="text-sm text-text-muted" />
    <a
      id="a4200-pdf-download"
      class="hidden min-h-11 items-center rounded-md border border-border px-4 py-2 text-sm font-semibold text-primary hover:border-accent"
      hidden
      download="Perioada_raportare.pdf"
    >
      Descarcă PDF generat
    </a>
    <div id="a4200-signed-upload-wrap" class="hidden mt-2 space-y-2" hidden>
      <label
        class="flex min-h-11 cursor-pointer items-center justify-center rounded-md border border-dashed border-border-light bg-surface px-4 py-3 text-sm font-medium text-primary hover:border-accent"
      >
        Încarcă PDF-ul semnat
        <input type="file" id="a4200-signed-pdf-input" class="hidden" accept=".pdf,application/pdf" />
      </label>
      <p id="a4200-anaf-ready-msg" class="hidden text-sm text-green-700" hidden />
      <a
        id="a4200-anaf-ready-download"
        class="hidden min-h-11 items-center rounded-md bg-accent px-4 py-2 text-sm font-bold text-white hover:bg-accent-hover"
        hidden
        download="declarare-anaf.pdf"
      >
        Descarcă fișierul pentru ANAF
      </a>
    </div>
  </section>

  <!-- Step 4 -->
  <section
    id="a4200-step-4"
    class="a4200-step hidden space-y-4"
    data-step="4"
    aria-labelledby="a4200-step-4-title"
    hidden
  >
    <h2 id="a4200-step-4-title" class="font-display text-2xl italic text-primary" tabindex="-1">
      Încarcă la ANAF și verifică recipisa
    </h2>
    <ol class="list-decimal space-y-3 pl-5 text-sm leading-relaxed text-text-secondary">
      <li>
        Deschide portalul
        <a href="https://decl.anaf.mfinante.gov.ro/WAS6DUS/" target="_blank" rel="noopener" class="text-accent hover:text-accent-hover"
          >decl.anaf.mfinante.gov.ro</a
        > și autentifică-te cu certificatul digital al firmei.
      </li>
      <li>Încarcă PDF-ul pregătit la pasul anterior (un singur fișier per depunere).</li>
      <li>
        După încărcare, verifică recipisa la
        <a href="https://stare.anaf.ro/StareD112" target="_blank" rel="noopener" class="text-accent hover:text-accent-hover"
          >stare.anaf.ro</a
        > — mesajul „Nu există erori de validare” confirmă că declarația a fost acceptată.
      </li>
      <li>Păstrează recipisa și PDF-ul semnat în arhiva firmei.</li>
    </ol>
  </section>

  <div class="sticky bottom-0 -mx-1 border-t border-border-light bg-white/95 px-1 py-3 backdrop-blur-sm sm:static sm:border-0 sm:bg-transparent sm:p-0">
    <button
      type="button"
      id="a4200-primary-btn"
      class="flex min-h-12 w-full items-center justify-center rounded-md bg-accent px-6 py-3 text-base font-bold text-white hover:bg-accent-hover disabled:cursor-not-allowed disabled:opacity-50"
    >
      Verifică arhiva
    </button>
    <button type="button" id="a4200-back-btn" class="mt-2 hidden w-full text-sm font-medium text-text-muted hover:text-primary">
      Înapoi
    </button>
  </div>

  <details id="a4200-tech-details" class="rounded-xl border border-border-light p-4 text-sm">
    <summary class="cursor-pointer font-semibold text-primary">Detalii tehnice</summary>
    <div class="mt-4 space-y-6">
      <div id="a4200-summary" class="hidden rounded-lg border border-border-light p-4" />
      <div id="a4200-z-table" class="hidden overflow-x-auto rounded-lg border border-border-light" />
      <div id="a4200-issues" class="hidden space-y-3" />

      <section>
        <h3 class="font-semibold text-primary">Decoder mesaje DUKIntegrator (.err.txt)</h3>
        <p class="mt-1 text-text-secondary">Lipește logul de erori pentru explicații în română.</p>
        <textarea
          id="a4200-errtxt"
          class="mt-3 w-full min-h-[100px] rounded-md border border-border-light bg-white p-3 text-sm text-text-secondary"
          placeholder="Liniile din fișierul .err.txt…"
        />
        <button
          type="button"
          id="a4200-decode-btn"
          class="mt-2 rounded-md border border-border px-4 py-2 text-sm font-semibold text-primary hover:border-accent"
        >
          Decodează mesajele
        </button>
        <div id="a4200-duk-out" class="mt-3 space-y-3" />
      </section>

      <p class="text-xs text-text-muted">
        Scheme XSD: {XSD_BUNDLE.a4200.file} v{XSD_BUNDLE.a4200.version}, {XSD_BUNDLE.a4203.file} v{XSD_BUNDLE.a4203.version}.
        Validator ANAF referință: A4200 {ANAF_VALIDATOR_VERSIONS.a4200Jar}, A4203 {ANAF_VALIDATOR_VERSIONS.a4203Jar}.
        Verificat la {formatDateRo(VERIFIED_ON)}.
      </p>
    </div>
  </details>
</div>

<script>
  import { ingestFileList } from "../lib/a4200/ingest.ts";
  import { buildCrossCheckInput } from "../lib/a4200/pipeline.ts";
  import { buildOpisCheckSummary, formatZ } from "../lib/a4200/check-summary.ts";
  import { validateAgainstXsd } from "../lib/a4200/validate-xsd.ts";
  import { explainXsdMessage } from "../lib/a4200/explain.ts";
  import { decodeDukErrTxt } from "../lib/a4200/duk-decoder.ts";
  import { stripPdfLtvIncrement } from "../lib/a4200/strip-pdf-ltv.ts";
  import type { CheckerIssue, ClassifiedFile } from "../lib/a4200/types.ts";
  import {
    collectP7bFromFiles,
    groupP7bLogicalNames,
    p7bPayloadsToZip,
  } from "../lib/a4200/collect-p7b.ts";
  import { groupCardLabel } from "../lib/a4200/mixed-month.ts";
  import { runFullUploadChecks, type GroupCheckResult } from "../lib/a4200/opis-groups.ts";
  import { trackToolUsed } from "../lib/analytics-client.ts";
  import {
    WIZARD_STEP_COUNT,
    buildUploadPlainSummary,
    countBlockingIssues,
    primaryButtonLabel,
    stepFocusTargetId,
    stepHeading,
  } from "../lib/a4200/wizard.ts";

  const PDF_SERVICE_URL = import.meta.env.PUBLIC_A4200_PDF_URL?.replace(/\/$/, "") ?? "";

  const root = document.getElementById("a4200-checker")!;
  const progressLabel = document.getElementById("a4200-progress")!;
  const progressBar = document.getElementById("a4200-progressbar")!;
  const progressFill = document.getElementById("a4200-progress-fill")!;
  const primaryBtn = document.getElementById("a4200-primary-btn") as HTMLButtonElement;
  const backBtn = document.getElementById("a4200-back-btn") as HTMLButtonElement;
  const drop = document.getElementById("a4200-drop")!;
  const fileInput = document.getElementById("a4200-file-input") as HTMLInputElement;
  const folderInput = document.getElementById("a4200-folder-input") as HTMLInputElement;
  const fileHint = document.getElementById("a4200-file-hint")!;
  const plainSummaryEl = document.getElementById("a4200-plain-summary")!;
  const mixedMonthBox = document.getElementById("a4200-mixed-month-box")!;
  const infoLinesEl = document.getElementById("a4200-info-lines")!;
  const missingListEl = document.getElementById("a4200-missing-list")!;
  const pdfGroupsEl = document.getElementById("a4200-pdf-groups")!;
  const step2Hint = document.getElementById("a4200-step2-hint")!;
  const summaryEl = document.getElementById("a4200-summary")!;
  const zTableEl = document.getElementById("a4200-z-table")!;
  const issuesEl = document.getElementById("a4200-issues")!;
  const errTxt = document.getElementById("a4200-errtxt") as HTMLTextAreaElement;
  const dukOut = document.getElementById("a4200-duk-out")!;
  const signedPdfInput = document.getElementById("a4200-signed-pdf-input") as HTMLInputElement;
  const signedUploadWrap = document.getElementById("a4200-signed-upload-wrap")!;
  const pdfStatus = document.getElementById("a4200-pdf-status");
  const pdfDownload = document.getElementById("a4200-pdf-download") as HTMLAnchorElement;
  const anafReadyMsg = document.getElementById("a4200-anaf-ready-msg")!;
  const anafReadyDownload = document.getElementById("a4200-anaf-ready-download") as HTMLAnchorElement;
  const activeClass = drop.dataset.activeClass ?? "";

  function hideActionLink(el: HTMLAnchorElement) {
    el.hidden = true;
    el.classList.add("hidden");
    el.classList.remove("inline-flex");
    el.removeAttribute("href");
  }

  function showActionLink(el: HTMLAnchorElement, href: string) {
    el.href = href;
    el.hidden = false;
    el.classList.remove("hidden");
    el.classList.add("inline-flex");
  }

  function resetStep3State() {
    pdfGenerated = false;
    step3AnafReady = false;
    hideActionLink(pdfDownload);
    hideActionLink(anafReadyDownload);
    anafReadyMsg.hidden = true;
    anafReadyMsg.classList.add("hidden");
    signedUploadWrap.hidden = true;
    signedUploadWrap.classList.add("hidden");
    signedPdfInput.value = "";
  }

  function updateStep3Ui() {
    if (pdfGenerated) {
      signedUploadWrap.hidden = false;
      signedUploadWrap.classList.remove("hidden");
    } else {
      signedUploadWrap.hidden = true;
      signedUploadWrap.classList.add("hidden");
    }
    if (currentStep === 3) {
      primaryBtn.classList.toggle("hidden", pdfGenerated && !step3AnafReady);
    } else {
      primaryBtn.classList.remove("hidden");
    }
  }

  let currentStep = 1;
  let schemas: { a4200: string; a4203: string } | null = null;
  let lastUploadFiles: File[] = [];
  let lastClassified: ClassifiedFile[] = [];
  let lastIssues: CheckerIssue[] = [];
  let lastGroups: GroupCheckResult[] = [];
  let lastPlainOk = false;
  let step3AnafReady = false;
  let pdfGenerated = false;

  function setStep(step: number) {
    currentStep = step;
    for (let s = 1; s <= WIZARD_STEP_COUNT; s++) {
      const panel = document.getElementById(`a4200-step-${s}`)!;
      const show = s === step;
      panel.classList.toggle("hidden", !show);
      panel.hidden = !show;
    }
    progressLabel.textContent = `Pasul ${step} din ${WIZARD_STEP_COUNT}`;
    progressBar.setAttribute("aria-valuenow", String(step));
    progressFill.style.width = `${(step / WIZARD_STEP_COUNT) * 100}%`;
    backBtn.classList.toggle("hidden", step <= 1);
    updatePrimaryButton();
    updateStep3Ui();
    const title = document.getElementById(stepFocusTargetId(step));
    title?.focus();
  }

  function updatePrimaryButton() {
    const hasFiles = lastUploadFiles.length > 0;
    primaryBtn.textContent = primaryButtonLabel(currentStep, {
      hasFiles,
      checksOk: lastPlainOk,
      onStep3ReadyForAnaf: step3AnafReady,
    });
    if (currentStep === 1) {
      primaryBtn.disabled = !hasFiles;
    } else if (currentStep === 2) {
      primaryBtn.disabled = false;
    } else if (currentStep === 3) {
      if (step3AnafReady) {
        primaryBtn.disabled = false;
      } else {
        primaryBtn.disabled = !lastPlainOk || !PDF_SERVICE_URL;
      }
    } else {
      primaryBtn.disabled = false;
    }
    // Update step titles to match wizard copy
    for (let s = 1; s <= WIZARD_STEP_COUNT; s++) {
      const el = document.getElementById(`a4200-step-${s}-title`);
      if (el) el.textContent = stepHeading(s);
    }
  }

  async function loadSchemas() {
    if (schemas) return schemas;
    const [a4200, a4203] = await Promise.all([
      fetch("/a4200/a4200_20180910.xsd").then((r) => r.text()),
      fetch("/a4200/a4203_20180927.xsd").then((r) => r.text()),
    ]);
    schemas = { a4200, a4203 };
    return schemas;
  }

  function renderTechnicalIssues(issues: CheckerIssue[]) {
    issuesEl.innerHTML = "";
    if (issues.length === 0) {
      issuesEl.classList.add("hidden");
      return;
    }
    issuesEl.classList.remove("hidden");
    for (const i of issues) {
      const card = document.createElement("article");
      card.className =
        "rounded-lg border p-4 " +
        (i.severity === "error" ? "border-red-200 bg-red-50/80" : "border-amber-200 bg-amber-50/80");
      const where = [i.file, i.line ? `linia ${i.line}` : "", i.field, i.code].filter(Boolean).join(" · ");
      card.innerHTML = `<h4 class="font-semibold text-primary">${i.title}</h4>
        ${where ? `<p class="mt-1 text-xs text-text-muted">${where}</p>` : ""}
        <p class="mt-2 text-sm text-text-secondary"><strong>Ce s-a întâmplat:</strong> ${i.ceInseamna}</p>
        <p class="mt-2 text-sm text-text-secondary"><strong>Ce poți face:</strong> ${i.ceFaci}</p>`;
      issuesEl.appendChild(card);
    }
  }

  function renderZTable(files: ClassifiedFile[]) {
    const { input } = buildCrossCheckInput(files);
    const summary = buildOpisCheckSummary(input);
    if (!summary) {
      zTableEl.classList.add("hidden");
      return;
    }
    zTableEl.classList.remove("hidden");
    const rows = summary.rows
      .map((r) => {
        const label =
          r.status === "present"
            ? `<span class="text-green-700">Prezent</span>`
            : r.status === "missing"
              ? `<span class="text-red-700">Lipsește</span>`
              : r.status === "duplicate"
                ? `<span class="text-amber-700">Duplicat</span>`
                : `<span class="text-amber-700">În afara opisului</span>`;
        const file = r.file ? `<span class="font-mono text-xs">${r.file}</span>` : "—";
        return `<tr class="border-t border-border-light"><td class="px-3 py-2 font-mono">${formatZ(r.z)}</td><td class="px-3 py-2">${label}</td><td class="px-3 py-2">${file}</td></tr>`;
      })
      .join("");
    zTableEl.innerHTML = `<h4 class="px-4 pt-4 text-sm font-semibold text-primary">Rapoarte Z din opis (${summary.zRangeLabel})</h4>
      <p class="px-4 pb-2 text-xs text-text-muted">CIF ${summary.cif} · NUI ${summary.nui} · ${summary.presentCount}/${summary.expectedCount} zile găsite</p>
      <table class="w-full text-left text-sm"><thead><tr class="bg-surface text-text-muted"><th class="px-3 py-2">Raport</th><th class="px-3 py-2">Stare</th><th class="px-3 py-2">Fișier</th></tr></thead><tbody>${rows}</tbody></table>`;
  }

  function renderTechnicalSummary(files: ClassifiedFile[], issues: CheckerIssue[]) {
    const { input } = buildCrossCheckInput(files);
    const opis = input.opis;
    const summary = buildOpisCheckSummary(input);
    const errs = issues.filter((x) => x.severity === "error").length;
    summaryEl.classList.remove("hidden");
    if (!opis || !summary) {
      summaryEl.innerHTML = `<p class="text-text-secondary">Fișiere analizate: ${files.length}. ${errs ? `${errs} problemă/probleme.` : "Lipsește fișierul de perioadă."}</p>`;
      return;
    }
    const ok = errs === 0;
    summaryEl.innerHTML = `<p class="font-semibold ${ok ? "text-green-700" : "text-red-700"}">${ok ? "Verificările locale au trecut" : `${errs} problemă/probleme`}</p>
      <ul class="mt-2 list-disc pl-5 text-xs text-text-secondary">
        <li>Interval în registru: <strong>${summary.zRangeLabel}</strong> (tip AMEF ${opis.tipAmef})</li>
        <li>Zile încărcate: <strong>${summary.presentCount}</strong> din ${summary.expectedCount}</li>
        <li>NUI: <span class="font-mono">${summary.nui}</span> · CIF: <span class="font-mono">${summary.cif}</span></li>
      </ul>`;
  }

  function enrichGroupsWithXsd(groups: GroupCheckResult[], xsd: CheckerIssue[]): GroupCheckResult[] {
    return groups.map((g) => {
      const names = new Set([g.group.opisFile, ...g.group.days.map((d) => d.file)]);
      const extra = xsd.filter((i) => !i.file || names.has(i.file));
      const issues = [...g.issues, ...extra];
      const readyForPdf =
        g.summary !== null &&
        g.summary.presentCount === g.summary.expectedCount &&
        countBlockingIssues(issues) === 0 &&
        g.group.days.length > 0;
      return { ...g, issues, readyForPdf };
    });
  }

  function renderPlainStep2(uploadIssues: CheckerIssue[], groups: GroupCheckResult[]) {
    const plain = buildUploadPlainSummary(uploadIssues, groups);
    lastPlainOk = plain.ok || groups.some((g) => g.readyForPdf);

    const headlineClass = plain.ok || lastPlainOk ? "text-green-700" : "text-red-700";
    plainSummaryEl.innerHTML = `<p class="text-lg font-semibold ${headlineClass}">${plain.headline}</p>
      ${plain.foundLine ? `<p class="mt-3 text-text-secondary">${plain.foundLine}</p>` : ""}`;

    if (plain.mixedMonthHtml) {
      mixedMonthBox.classList.remove("hidden");
      mixedMonthBox.hidden = false;
      mixedMonthBox.innerHTML = `<p class="text-text-secondary">${plain.mixedMonthHtml}</p>
        <button type="button" id="a4200-copy-service-btn" class="min-h-10 rounded-md border border-amber-300 bg-white px-4 py-2 text-sm font-semibold text-primary hover:border-accent">
          Copiază mesajul pentru service
        </button>`;
      document.getElementById("a4200-copy-service-btn")?.addEventListener("click", async () => {
        if (!plain.serviceTechnicianMessage) return;
        try {
          await navigator.clipboard.writeText(plain.serviceTechnicianMessage);
          const btn = document.getElementById("a4200-copy-service-btn");
          if (btn) btn.textContent = "Mesaj copiat în clipboard";
        } catch {
          /* ignore */
        }
      });
    } else {
      mixedMonthBox.classList.add("hidden");
      mixedMonthBox.hidden = true;
      mixedMonthBox.innerHTML = "";
    }

    if (plain.infoLines.length > 0) {
      infoLinesEl.classList.remove("hidden");
      infoLinesEl.innerHTML = plain.infoLines.map((l) => `<li>${l}</li>`).join("");
    } else {
      infoLinesEl.classList.add("hidden");
      infoLinesEl.innerHTML = "";
    }

    if (plain.missingLines.length > 0) {
      missingListEl.classList.remove("hidden");
      missingListEl.innerHTML = plain.missingLines.map((l) => `<li>${l}</li>`).join("");
    } else {
      missingListEl.classList.add("hidden");
      missingListEl.innerHTML = "";
    }

    if (!lastPlainOk) {
      step2Hint.textContent =
        "Rezolvă problemele de mai sus (sau deschide Detalii tehnice), apoi încarcă din nou arhiva de la service.";
    } else {
      step2Hint.textContent = "Poți continua la generarea PDF și semnare.";
    }
    lastPdfMonthNote = plain.pdfMonthNote;
    updatePrimaryButton();
  }

  let lastPdfMonthNote: string | null = null;

  function renderPdfGroupCards(groups: GroupCheckResult[], pdfMonthNote: string | null) {
    const ready = groups.filter((g) => g.readyForPdf);
    const multi = ready.length > 1;
    if (ready.length === 0) {
      pdfGroupsEl.classList.add("hidden");
      pdfGroupsEl.hidden = true;
      pdfGroupsEl.innerHTML = "";
      return;
    }
    pdfGroupsEl.classList.remove("hidden");
    pdfGroupsEl.hidden = false;
    const note = pdfMonthNote
      ? `<p class="mb-3 text-xs text-text-muted">${pdfMonthNote}</p>`
      : "";
    pdfGroupsEl.innerHTML =
      note +
      ready
        .map((g) => {
          const cardLabel = groupCardLabel(g.group.days, g.group.opis.nrRapI, g.group.opis.nrRapF);
          return `<article class="rounded-xl border border-border-light bg-surface p-4" data-group-key="${g.group.key}">
          <p class="font-semibold text-primary">${cardLabel}</p>
          <button type="button" class="a4200-gen-pdf-btn mt-3 min-h-10 rounded-md bg-accent px-4 py-2 text-sm font-bold text-white hover:bg-accent-hover ${multi ? "" : "hidden"}" data-group-key="${g.group.key}" ${multi ? "" : "hidden"}>
            Generează PDF
          </button>
          <p class="a4200-gen-pdf-status mt-2 text-xs text-text-muted" data-group-key="${g.group.key}"></p>
        </article>`;
        })
        .join("");

    pdfGroupsEl.querySelectorAll(".a4200-gen-pdf-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const key = (btn as HTMLElement).dataset.groupKey;
        if (key) void generatePdfForGroup(key);
      });
    });
  }

  async function runXsd(files: ClassifiedFile[]): Promise<CheckerIssue[]> {
    try {
      const sch = await loadSchemas();
      const { validateXML } = await import("xmllint-wasm");
      const toValidate = files
        .filter((f) => f.xml && (f.kind === "opis" || f.kind === "day"))
        .map((f) => ({
          name: f.name,
          xml: f.xml!,
          schema: f.kind === "opis" ? sch.a4200 : sch.a4203,
        }));
      return await validateAgainstXsd(validateXML, toValidate);
    } catch {
      const e = explainXsdMessage("indisponibil");
      return [
        {
          ...e,
          code: "XSD_SKIPPED",
          title: "Validarea XSD nu a rulat în browser",
          ceInseamna: "Nu am putut încărca validatorul din browser (memorie sau rețea).",
          ceFaci: "Rulează Validare în DUKIntegrator. Verificările de opis și de zile au rulat local.",
        },
      ];
    }
  }

  async function runChecks(fileList: File[]) {
    plainSummaryEl.innerHTML = `<p class="text-text-muted">Se analizează ${fileList.length} fișier(e)…</p>`;
    const { files } = await ingestFileList(fileList);
    lastClassified = files;
    const { uploadIssues, groups } = runFullUploadChecks(files);
    const xsd = await runXsd(files);
    lastGroups = enrichGroupsWithXsd(groups, xsd);
    lastIssues = [...uploadIssues, ...lastGroups.flatMap((g) => g.issues)];
    renderPlainStep2(uploadIssues, lastGroups);
    renderTechnicalSummary(files, lastIssues);
    renderZTable(files);
    renderTechnicalIssues(lastIssues);
    trackToolUsed("a4200", "check", { result: lastPlainOk ? "ok" : "errors" });
  }

  function onFilesSelected(fileList: FileList | File[]) {
    const arr = [...fileList];
    lastUploadFiles = arr;
    resetStep3State();
    fileHint.textContent =
      arr.length > 0 ? `${arr.length} fișier(e) selectate. Apasă „Verifică arhiva”.` : "";
    updatePrimaryButton();
    updateStep3Ui();
  }

  async function postZipForPdf(zipBytes: Uint8Array): Promise<{ ok: true; blob: Blob; filename?: string } | { ok: false; msg: string }> {
    const res = await fetch(`${PDF_SERVICE_URL}/a4200`, {
      method: "POST",
      headers: { "Content-Type": "application/zip" },
      body: zipBytes,
    });
    if (res.ok) {
      const blob = await res.blob();
      const disposition = res.headers.get("Content-Disposition");
      const filenameMatch = disposition?.match(/filename="([^"]+)"/);
      return { ok: true, blob, filename: filenameMatch?.[1] };
    }
    const ct = res.headers.get("content-type") ?? "";
    let msg = "";
    if (ct.includes("application/json")) {
      const j = await res.json();
      msg = [j.message, j.nextStep].filter(Boolean).join(" — ");
    } else {
      msg = await res.text();
    }
    return { ok: false, msg: msg || `Eroare ${res.status} de la server.` };
  }

  async function generatePdfForGroup(groupKey: string) {
    if (!PDF_SERVICE_URL) return;
    const g = lastGroups.find((x) => x.group.key === groupKey);
    if (!g?.readyForPdf) return;
    const statusEl = pdfGroupsEl.querySelector(`.a4200-gen-pdf-status[data-group-key="${groupKey}"]`);
    if (statusEl) statusEl.textContent = "Se generează PDF-ul…";
    try {
      const names = groupP7bLogicalNames(g.group);
      const payloads = await collectP7bFromFiles(lastUploadFiles, names);
      if (payloads.length === 0) throw new Error("Nu am găsit fișiere .p7b pentru acest export.");
      const result = await postZipForPdf(p7bPayloadsToZip(payloads));
      if (result.ok) {
        const link = document.createElement("a");
        link.className =
          "mt-2 inline-flex min-h-10 items-center rounded-md border border-border px-4 py-2 text-sm font-semibold text-primary hover:border-accent";
        link.download = result.filename ?? "A4200.pdf";
        showActionLink(link as HTMLAnchorElement, URL.createObjectURL(result.blob));
        link.textContent = "Descarcă PDF generat";
        statusEl?.replaceWith(link);
        pdfGenerated = true;
        updateStep3Ui();
        trackToolUsed("a4200", "generate_pdf", { result: "ok" });
      } else {
        if (statusEl) {
          statusEl.textContent = result.msg;
          statusEl.className = "a4200-gen-pdf-status mt-2 text-xs text-red-700";
        }
        trackToolUsed("a4200", "generate_pdf", { result: "errors" });
      }
    } catch {
      if (statusEl) statusEl.textContent = "Nu am putut genera PDF-ul pentru acest export.";
    }
  }

  async function generatePdf() {
    if (!PDF_SERVICE_URL || !lastPlainOk || lastUploadFiles.length === 0) return;
    const ready = lastGroups.filter((g) => g.readyForPdf);
    if (ready.length === 1) {
      await generatePdfForGroup(ready[0].group.key);
      return;
    }
    primaryBtn.disabled = true;
    hideActionLink(pdfDownload);
    if (pdfStatus) {
      pdfStatus.textContent = "Alege exportul pentru care vrei PDF, folosind butoanele de pe carduri.";
      pdfStatus.className = "text-sm text-text-muted";
    }
    primaryBtn.disabled = false;
    updatePrimaryButton();
  }

  signedPdfInput.addEventListener("change", async () => {
    const file = signedPdfInput.files?.[0];
    hideActionLink(anafReadyDownload);
    anafReadyMsg.hidden = true;
    anafReadyMsg.classList.add("hidden");
    step3AnafReady = false;
    updateStep3Ui();
    if (!file) {
      updatePrimaryButton();
      return;
    }
    anafReadyMsg.textContent = "Pregătim fișierul pentru ANAF…";
    anafReadyMsg.hidden = false;
    anafReadyMsg.classList.remove("hidden");
    anafReadyMsg.className = "text-sm text-text-muted";
    const buf = new Uint8Array(await file.arrayBuffer());
    const res = stripPdfLtvIncrement(buf);
    if (!res.ok || !res.stripped) {
      anafReadyMsg.textContent = res.reason ?? "Nu am putut procesa PDF-ul. Încearcă din nou sau contactează-ne.";
      anafReadyMsg.className = "text-sm text-red-700";
      updatePrimaryButton();
      return;
    }
    const blob = new Blob([res.stripped], { type: "application/pdf" });
    showActionLink(anafReadyDownload, URL.createObjectURL(blob));
    anafReadyDownload.download = file.name.replace(/\.pdf$/i, "") + "-anaf.pdf";
    anafReadyMsg.textContent = "Fișierul este gata pentru încărcarea la ANAF. Descarcă-l și continuă la pasul următor.";
    anafReadyMsg.className = "text-sm text-green-700";
    step3AnafReady = true;
    trackToolUsed("a4200", "check", { result: "ok" });
    updatePrimaryButton();
    updateStep3Ui();
  });

  primaryBtn.addEventListener("click", async () => {
    if (currentStep === 1) {
      if (lastUploadFiles.length === 0) {
        fileInput.click();
        return;
      }
      setStep(2);
      await runChecks(lastUploadFiles);
      return;
    }
    if (currentStep === 2) {
      if (lastPlainOk) {
        setStep(3);
        renderPdfGroupCards(lastGroups, lastPdfMonthNote);
      } else {
        setStep(1);
      }
      return;
    }
    if (currentStep === 3) {
      if (step3AnafReady) {
        setStep(4);
        return;
      }
      await generatePdf();
      return;
    }
    if (currentStep === 4) {
      window.open("https://decl.anaf.mfinante.gov.ro/WAS6DUS/", "_blank", "noopener");
    }
  });

  backBtn.addEventListener("click", () => {
    if (currentStep > 1) setStep(currentStep - 1);
  });

  function preventDefaults(e: DragEvent) {
    e.preventDefault();
    e.stopPropagation();
  }

  ["dragenter", "dragover", "dragleave", "drop"].forEach((ev) => {
    drop.addEventListener(ev, preventDefaults);
  });
  drop.addEventListener("dragenter", () => drop.classList.add(...activeClass.split(" ")));
  drop.addEventListener("dragleave", () => drop.classList.remove(...activeClass.split(" ")));
  drop.addEventListener("drop", (e) => {
    drop.classList.remove(...activeClass.split(" "));
    const dt = e.dataTransfer;
    if (dt?.files?.length) onFilesSelected(dt.files);
  });

  fileInput.addEventListener("change", () => {
    if (fileInput.files) onFilesSelected(fileInput.files);
  });
  folderInput.addEventListener("change", () => {
    if (folderInput.files) onFilesSelected(folderInput.files);
  });

  document.getElementById("a4200-decode-btn")?.addEventListener("click", () => {
    const lines = decodeDukErrTxt(errTxt.value);
    dukOut.innerHTML = "";
    for (const line of lines) {
      const div = document.createElement("div");
      div.className = "rounded-md border border-border-light bg-surface p-3 text-sm";
      if (line.explained && line.title) {
        div.innerHTML = `<p class="font-semibold text-primary">${line.title}</p>
          <p class="mt-1 text-text-muted font-mono text-xs">${line.raw}</p>
          <p class="mt-2"><strong>Ce s-a întâmplat:</strong> ${line.ceInseamna}</p>
          <p class="mt-1"><strong>Ce poți face:</strong> ${line.ceFaci}</p>`;
      } else {
        div.innerHTML = `<p class="font-semibold text-primary">Mesaj nerecunoscut</p>
          <p class="mt-1 font-mono text-xs">${line.raw}</p>
          <p class="mt-2">${line.ceFaci ?? "Trimite-ne mesajul prin formularul de contact (fără date personale)."}</p>`;
      }
      dukOut.appendChild(div);
    }
  });

  hideActionLink(pdfDownload);
  hideActionLink(anafReadyDownload);
  updatePrimaryButton();
  updateStep3Ui();
</script>
