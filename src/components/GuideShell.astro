---
// Shell for the /ghid pages and /comparatie: marketing navbar, header, KB content,
// sources, verified date, soft CTA, "not legal advice" note.
import Layout from "../layouts/Layout.astro";
import Navbar from "./Navbar.astro";
import Footer from "./Footer.astro";
import { formatDateRo } from "../lib/mcp/text.ts";

interface Props {
  title: string;
  description: string;
  heading: string;
  lead?: string;
  sources?: { title: string; url?: string }[];
  verifiedOn?: string | null;
  /** utm_campaign for the CTA link. */
  campaign: string;
  breadcrumb?: boolean;
  ctaTitle?: string;
}

const { title, description, heading, lead, sources = [], verifiedOn, campaign, breadcrumb = true, ctaTitle = "Tapselo face asta automat la casa de marcat" } = Astro.props;
const ctaUrl = `/?utm_source=ghid&utm_medium=site&utm_campaign=${encodeURIComponent(campaign)}`;
---

<Layout title={title} description={description}>
  <Navbar />

  <header class="bg-primary pt-28 pb-14 md:pt-32">
    <div class="mx-auto max-w-3xl px-6">
      {breadcrumb && (
        <a href="/ghid" class="text-sm font-medium text-text-on-primary/60 transition-colors hover:text-white">&larr; Ghid pentru magazine</a>
      )}
      <h1 class="mt-3 font-display text-4xl italic text-white sm:text-5xl">{heading}</h1>
      {lead && <p class="mt-4 text-lg leading-relaxed text-text-on-primary/80">{lead}</p>}
      {verifiedOn && <p class="mt-6 text-sm text-text-on-primary/50">Verificat la {formatDateRo(verifiedOn)}</p>}
    </div>
  </header>

  <main class="bg-surface-white py-14">
    <div class="mx-auto max-w-3xl space-y-12 px-6">
      <slot />

      {sources.length > 0 && (
        <section>
          <h2 class="font-display text-3xl italic text-primary">Surse</h2>
          <ul class="mt-4 space-y-2 pl-5 text-text-secondary">
            {sources.map((s) => (
              <li class="list-disc leading-relaxed">
                {s.url ? (
                  <a href={s.url} rel="noopener" target="_blank" class="text-accent hover:text-accent-hover">{s.title || s.url}</a>
                ) : (
                  s.title
                )}
              </li>
            ))}
          </ul>
          {verifiedOn && <p class="mt-4 text-sm text-text-muted">Verificat la {formatDateRo(verifiedOn)}.</p>}
        </section>
      )}

      <section class="rounded-xl border border-border bg-surface p-6 md:p-8">
        <h2 class="font-display text-3xl italic text-primary">{ctaTitle}</h2>
        <p class="mt-3 leading-relaxed text-text-secondary">
          Cote TVA corecte pe bon, cantare Dibal, raport Z si stocuri, intr-un singur program care merge si fara internet.
        </p>
        <a href={ctaUrl} class="mt-5 inline-block rounded-md bg-accent px-5 py-2.5 text-sm font-bold text-white transition-all hover:bg-accent-hover">
          Vezi cum functioneaza
        </a>
      </section>

      <p class="text-sm text-text-muted">
        Pagina are scop informativ si nu este consultanta juridica sau fiscala. Pentru cazul tau, verifica sursele oficiale sau intreaba contabilul.
      </p>
    </div>
  </main>

  <Footer />
</Layout>

<style is:global>
  .kb-prose { color: var(--color-text-secondary); line-height: 1.7; }
  .kb-prose > * + * { margin-top: 1rem; }
  .kb-prose strong { color: var(--color-primary); font-weight: 700; }
  .kb-prose a { color: var(--color-accent); }
  .kb-prose a:hover { color: var(--color-accent-hover); }
  .kb-prose ul { list-style: disc; padding-left: 1.25rem; }
  .kb-prose ol { list-style: decimal; padding-left: 1.25rem; }
  .kb-prose li + li { margin-top: 0.4rem; }
  .kb-prose code { font-family: var(--font-mono); font-size: 0.9em; background: var(--color-surface); padding: 0.1em 0.35em; border-radius: 4px; }
  .kb-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  .kb-table th, .kb-table td { border-bottom: 1px solid var(--color-border-light); padding: 0.5rem 0.6rem; text-align: left; vertical-align: top; }
  .kb-table th { color: var(--color-primary); font-weight: 600; background: var(--color-surface); }
  .kb-table tr:target td { background: var(--color-ticket-light); }
  section[id], div[id], tr[id] { scroll-margin-top: 5rem; }
</style>
