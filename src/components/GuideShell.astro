---
// Shell for the /ghid pages and /comparatie: marketing navbar, header, KB content,
// sources, verified date, soft CTA, "not legal advice" note.
import Layout from "../layouts/Layout.astro";
import Navbar from "./Navbar.astro";
import Footer from "./Footer.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import { formatDateRo } from "../lib/mcp/text.ts";
import { A4200_CHECKER_PATH } from "../lib/articles/schema.ts";
import type { BreadcrumbLink } from "../lib/unelte/jsonld.ts";
import { internalPath } from "../lib/internal-url.ts";
import GuidePageToc from "./GuidePageToc.astro";

function defaultGhidPageToc(pathname: string): boolean {
  const p = pathname.replace(/\/$/, "") || "/";
  if (p === "/ghid" || p === "/ghid/articole") return false;
  return p.startsWith("/ghid/");
}

interface Props {
  title: string;
  description: string;
  heading: string;
  lead?: string;
  sources?: { title: string; url?: string }[];
  verifiedOn?: string | null;
  /** Last content update (YYYY-MM-DD); shown as „Actualizat” and emitted as article:modified_time. */
  updatedOn?: string | null;
  publishedOn?: string | null;
  /** Identifies this page in PostHog cta_click (data-tapselo-cta). */
  campaign: string;
  breadcrumb?: boolean;
  breadcrumbs?: BreadcrumbLink[];
  ctaTitle?: string;
  ctaBody?: string;
  ctaHref?: string;
  /** Secondary CTA above the main Tapselo block (A4200 checker). */
  articleCta?: "a4200" | "default";
  jsonLd?: Record<string, unknown>[];
  /** Narrow column for long-form prose; hub pages use full container width. */
  contentWidth?: "reading" | "full";
  /** Sticky “Pe pagină” TOC from article headings (desktop). Default: /ghid/ articles except hubs. */
  pageToc?: boolean;
  /** Passed to Layout; false drops the site-wide SoftwareApplication JSON-LD. */
  appJsonLd?: boolean;
  /** Built-in closing CTA box; pages with their own final CTA pass false. */
  showCta?: boolean;
  /** Absolute og:image/twitter:image URL; Layout falls back to the site default. */
  ogImage?: string;
  /** „Nu este consultanță juridică” footnote; legal pages (/privacy, /terms…) pass false. */
  adviceNote?: boolean;
}

const {
  title,
  description,
  heading,
  lead,
  sources = [],
  verifiedOn,
  updatedOn,
  publishedOn,
  campaign,
  breadcrumb = true,
  breadcrumbs,
  ctaTitle = "Tapselo face asta automat la casa de marcat",
  ctaBody = "Cote TVA corecte pe bon, cântare Dibal, raport Z și stocuri, într-un singur program care merge și fără internet.",
  ctaHref = internalPath("/#how-it-works"),
  articleCta = "default",
  jsonLd = [],
  contentWidth = "full",
  pageToc: pageTocProp,
  appJsonLd = true,
  showCta = true,
  ogImage,
  adviceNote = true,
} = Astro.props;
const hasByline = Astro.slots.has("byline");

// Render the body once so the TOC column is only reserved when there are headings to list;
// otherwise the page uses the full container instead of a 48rem column next to an empty gap.
const body = await Astro.slots.render("default");
const hasHeadings = /<h[23][\s>]/i.test(body);
const wantsToc = pageTocProp ?? defaultGhidPageToc(Astro.url.pathname);
const pageToc = wantsToc && hasHeadings;
const width = wantsToc && !hasHeadings ? "full" : contentWidth;
const contentInnerClass = width === "reading" ? "site-reading" : "w-full";
const guideLayoutClass =
  pageToc
    ? width === "reading"
      ? "guide-layout guide-layout--reading"
      : "guide-layout guide-layout--full"
    : "";
const ctaUrl = ctaHref;
const a4200CheckerUrl = internalPath(A4200_CHECKER_PATH);
const ctaLocation = `ghid-${campaign}`;
---

<Layout
  title={title}
  description={description}
  jsonLd={jsonLd}
  publishedTime={publishedOn ?? undefined}
  modifiedTime={updatedOn ?? undefined}
  appJsonLd={appJsonLd}
  ogImage={ogImage}
>
  <Navbar />

  <header class="site-hero bg-primary">
    <div class="site-container">
      <div class={contentInnerClass}>
        {breadcrumbs && breadcrumbs.length > 0 ? (
          <Breadcrumbs items={breadcrumbs} />
        ) : (
          breadcrumb && (
            <a href={internalPath("/ghid")} class="text-sm font-medium text-text-on-primary-muted transition-colors hover:text-white">&larr; Ghid pentru magazine</a>
          )
        )}
        <h1 class="mt-3 font-display text-4xl italic text-white sm:text-5xl">{heading}</h1>
        {lead && <p class="mt-4 text-lg leading-relaxed text-text-on-primary/80">{lead}</p>}
        {hasByline ? (
          <div class="mt-6 text-sm text-text-on-primary"><slot name="byline" /></div>
        ) : (updatedOn || verifiedOn) && (
          <p class="mt-6 text-sm text-text-on-primary-muted">
            {updatedOn && <span>Actualizat: <time datetime={updatedOn}>{formatDateRo(updatedOn)}</time></span>}
            {updatedOn && verifiedOn && <span aria-hidden="true"> · </span>}
            {verifiedOn && <span>Verificat la {formatDateRo(verifiedOn)}</span>}
          </p>
        )}
      </div>
    </div>
  </header>

  <main class="bg-surface-white py-14">
    <div class="site-container">
      <div class:list={[guideLayoutClass]}>
        <div class:list={["guide-layout__main", contentInnerClass, "min-w-0 space-y-12"]}>
          <div class="guide-page-content space-y-12" data-guide-toc-root>
            <Fragment set:html={body} />
          </div>

      {sources.length > 0 && (
        <section>
          <h2 class="font-display text-3xl italic text-primary">Surse</h2>
          <ul class="mt-4 space-y-2 pl-5 text-text-secondary">
            {sources.map((s) => (
              <li class="list-disc leading-relaxed">
                {s.url ? (
                  <a href={s.url} rel="noopener" target="_blank" class="text-accent hover:text-accent-hover">{s.title || s.url}</a>
                ) : (
                  s.title
                )}
              </li>
            ))}
          </ul>
          {verifiedOn && <p class="mt-4 text-sm text-text-muted">Verificat la {formatDateRo(verifiedOn)}.</p>}
        </section>
      )}

      {articleCta === "a4200" && (
        <section class="rounded-xl border border-accent/30 bg-accent/5 p-6 md:p-8">
          <h2 class="font-display text-3xl italic text-primary">Verifică A4200 gratuit, în browser</h2>
          <p class="mt-3 leading-relaxed text-text-secondary">
            Asistent în patru pași: verifică exportul de la service, obții PDF-ul și știi cum verifici recipisa ANAF. Verificarea inițială nu trimite fișierele de pe calculator.
          </p>
          <a
            href={a4200CheckerUrl}
            data-tapselo-cta={`${ctaLocation}-a4200`}
            class="mt-5 inline-block rounded-md border border-accent bg-white px-5 py-2.5 text-sm font-bold text-accent transition-all hover:bg-accent hover:text-white"
          >
            Deschide verificarea A4200
          </a>
        </section>
      )}

      {showCta && (
      <section class="rounded-xl border border-border bg-surface p-6 md:p-8">
        <h2 class="font-display text-3xl italic text-primary">{ctaTitle}</h2>
        <p class="mt-3 leading-relaxed text-text-secondary">{ctaBody}</p>
        <a
          href={ctaUrl}
          data-tapselo-cta={ctaLocation}
          class="mt-5 inline-block rounded-md bg-accent px-5 py-2.5 text-sm font-bold text-white transition-all hover:bg-accent-hover"
        >
          Vezi cum funcționează
        </a>
      </section>
      )}

      {adviceNote && (
      <p class="text-sm text-text-muted">
        Pagina are scop informativ și nu este consultanță juridică sau fiscală. Pentru cazul tău, verifică sursele oficiale sau întreabă contabilul.
      </p>
      )}
        </div>
        {pageToc && <GuidePageToc />}
      </div>
    </div>
  </main>

  <Footer />
</Layout>
