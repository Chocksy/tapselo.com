---
import { internalPath } from "../lib/internal-url.ts";
import {
  WifiOff,
  ArrowRight,
  Store,
  Monitor,
  KeyRound,
  RefreshCw,
  Camera,
  BarChart3,
  Laptop,
  ShieldCheck,
} from "@lucide/astro";
import LazyVideo from "./LazyVideo.astro";

const features = [
  {
    slug: "scale",
    title: "Cântar și produse la kg",
    text: "Prețurile pleacă singure în cântarul Dibal. Scanezi eticheta, iar casa citește greutatea din codul de bare.",
  },
  {
    slug: "receiving",
    title: "Recepție marfă din poza facturii",
    text: "Fotografiezi factura cu telefonul și produsele se completează singure. Confirmi, iar NIR-ul și stocul sunt gata.",
  },
  {
    slug: "inventory",
    title: "Inventar cu telefonul",
    text: "Scanezi cu camera și numeri pe loc. Analiza din admin îți arată ce merită verificat.",
  },
  {
    slug: "recipes",
    title: "Rețete și producție",
    text: "Rețeta îți arată costul pe bucată. Notezi ce ai produs, iar ingredientele ies singure din stoc.",
  },
  {
    slug: "customers",
    title: "Clienți și cupoane",
    text: "Ofertele zilei apar direct pe casă. Cuponul se aplică pe loc și vezi cât aduce fiecare.",
  },
  {
    slug: "offers",
    title: "Pagina de oferte",
    text: "Un link al magazinului, cu ofertele zilei. Clienții îl deschid din QR, iar foaia A4 pentru vitrină iese dintr-un clic.",
  },
  {
    slug: "campaigns",
    title: "Campanii pe WhatsApp",
    text: "Trimiți oferte pe WhatsApp și email, doar clienților care au acceptat. Mesajul vine cu numele lor și cu cuponul.",
  },
  {
    slug: "orders",
    title: "Comenzi din Messenger cu AI",
    text: "Clientul scrie pe Messenger, iar AI-ul scoate comanda din mesaj. Tu doar o accepți.",
  },
];
---

<section id="features" class="bg-surface py-24">
  <div class="mx-auto max-w-6xl px-6">
    <h2 class="animate-on-scroll font-display text-4xl italic text-primary sm:text-5xl">
      Tot ce ai nevoie.
    </h2>
    <p class="animate-on-scroll animate-delay-100 font-display text-4xl italic text-primary/20 sm:text-5xl">
      Nimic în plus.
    </p>

    <!-- Big feature: offline -->
    <div class="animate-on-scroll mt-14 overflow-hidden rounded-xl bg-primary text-white">
      <div class="grid items-center md:grid-cols-5">
        <div class="p-8 md:col-span-2 md:p-10">
          <WifiOff class="mb-5 h-7 w-7 text-accent" />
          <h3 class="text-2xl font-bold text-white">Vinzi și fără internet</h3>
          <p class="mt-3 text-base leading-relaxed text-text-on-primary">
            Pică netul, casa vinde mai departe. Vânzările se trimit singure când revine conexiunea.
          </p>
        </div>
        <div class="md:col-span-3">
          <LazyVideo slug="offline" label="Casa vinde fără internet, apoi vânzarea apare în admin" />
        </div>
      </div>
    </div>

    <!-- Feature videos -->
    <div class="mt-4 grid gap-4 md:grid-cols-2">
      {features.map((f, i) => (
        <article class:list={["animate-on-scroll overflow-hidden rounded-xl border border-border bg-surface-white", i % 2 === 1 && "animate-delay-100"]}>
          <LazyVideo slug={f.slug} label={f.title} />
          <div class="p-6 md:p-7">
            <h3 class="text-lg font-bold text-primary">{f.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-text-secondary">{f.text}</p>
          </div>
        </article>
      ))}
    </div>

    <p class="animate-on-scroll mt-8">
      <a href={internalPath("/demo")} class="group inline-flex items-center gap-2 text-base font-bold text-accent hover:text-accent-hover">
        Vezi tot turul, pe scurt
        <ArrowRight class="h-4 w-4 transition-transform duration-150 group-hover:translate-x-0.5" />
      </a>
    </p>

    <!-- Feature pills — store-owner language -->
    <div class="animate-on-scroll mt-8 flex flex-wrap gap-2.5">
      {[
        { name: "Mai multe magazine", icon: Store },
        { name: "Ecran pentru clienți", icon: Monitor },
        { name: "Activare în 2 minute", icon: KeyRound },
        { name: "Se actualizează singur", icon: RefreshCw },
        { name: "Import din alt program", icon: Laptop },
        { name: "Scanezi factura cu telefonul", icon: Camera },
        { name: "Rapoarte de profit", icon: BarChart3 },
        { name: "Fără licențe scumpe", icon: ShieldCheck },
      ].map(({ name, icon: Icon }) => (
        <div class="inline-flex items-center gap-2 rounded-md border border-border bg-surface-white px-4 py-2.5 text-sm font-medium text-primary transition-all duration-200 hover:border-accent hover:text-accent hover:-translate-y-0.5">
          <Icon class="h-4 w-4" />
          {name}
        </div>
      ))}
    </div>
  </div>
</section>
