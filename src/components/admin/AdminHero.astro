---
// F1 hero: title, lead, CTAs, then the live admin dashboard (kit) cropped by the band, with the admin phone home on the right.
import PhoneFrame from "./PhoneFrame.astro";
import PhoneAdminHome from "./PhoneAdminHome.astro";
import Mascot from "../Mascot.astro";
const DEMO = "https://app.tapselo.com/?demo=1";
---
<section class="pp-band ah" id="prezentare">
  <div class="site-container ah-text">
    <span class="ah-eb"><i></i>Adminul Tapselo, inclus la orice casă</span>
    <h1 class="pp-h1">Conduci tot magazinul <span>dintr-un singur loc.</span></h1>
    <div class="ah-right">
      <p class="pp-lead">Prețuri, NIR din poza facturii, rețete cu cost pe bucată, clienți, oferte și exportul pentru contabil. Vezi vânzările de la casă pe măsură ce se fac.</p>
      <div class="pp-ctas ah-cta">
        <a class="pp-btn" href={DEMO} data-tapselo-cta="admin-hero">Deschide adminul demo <span aria-hidden="true">&rarr;</span></a>
        <a class="pp-btn2" href="/#pricing">Prețuri</a>
      </div>
      <ul class="ah-av"><li>Orice browser</li><li>Windows, macOS, Linux</li><li>Telefon</li></ul>
    </div>
  </div>
  <div class="ah-guide" aria-hidden="true"></div>
  <div class="site-container">
    <div class="ah-stage">
      <div class="ah-admin" data-fit="1040"><div class="ts-admin" data-screen="dashboard" data-w="1040" role="img" aria-label="Adminul Tapselo: vânzările de azi și paginile principale"></div></div>
      <div class="ah-phone">
        <div class="ah-mascot" data-mascot-spot="admin"><Mascot spot="admin" pose="smile" rest="you" size={112} sizeSm={72} view /></div>
        <PhoneFrame zoom={0.64}><PhoneAdminHome /></PhoneFrame>
      </div>
    </div>
  </div>
</section>

<style>
  .ah { overflow: hidden; border-bottom: 1px solid var(--color-rule); }
  .ah-text { position: relative; z-index: 2; padding-top: clamp(40px, 5vw, 66px); }
  .ah-eb { display: inline-flex; align-items: center; gap: 8px; height: 30px; padding: 0 12px; margin-bottom: 26px; border-radius: 99px; background: var(--color-paper-white); box-shadow: 0 0 0 1px var(--color-rule); font-size: 14px; font-weight: 500; color: var(--color-ink-2); }
  .ah-eb i { width: 7px; height: 7px; border-radius: 50%; background: #10b981; }
  .ah-right { max-width: 600px; margin-top: 30px; }
  .ah-cta { margin-top: 28px; }
  .ah-av { display: flex; flex-wrap: wrap; gap: 8px 18px; margin: 22px 0 0; padding: 0; list-style: none; font: 500 12.5px/1 var(--font-mono); letter-spacing: .02em; color: var(--color-ink-3); }
  .ah-av li { display: flex; align-items: center; gap: 7px; }
  .ah-av li::before { content: ""; width: 5px; height: 5px; border-radius: 50%; background: var(--color-perf); }

  .ah-guide { position: relative; height: 0; margin-top: clamp(24px, 2.5vw, 30px); border-top: 1px dashed var(--color-perf); }
  .ah-stage { position: relative; height: 460px; margin-top: 24px; }
  .ah-admin { position: absolute; left: 0; top: 0; filter: drop-shadow(0 30px 50px rgba(60, 45, 20, .16)); }
  .ah-phone { position: absolute; right: 0; bottom: 45px; z-index: 2; filter: drop-shadow(0 40px 50px rgba(15, 23, 42, .3)); }
  /* J2: Nea Tapselo peeks over the top of the admin phone, from behind it */
  .ah-mascot { position: absolute; right: 26px; bottom: calc(100% - 30px); z-index: -1; }

  @media (max-width: 1199.98px) { .ah-stage { height: 400px; } }
  @media (max-width: 1023.98px) {
    .ah-stage { height: 340px; }
    .ah-phone { bottom: 20px; }
    .ah-phone :global(.pf) { zoom: .45 !important; }
  }
  @media (max-width: 767.98px) {
    .ah-stage { height: 300px; width: 150%; }
    .ah-phone { right: 33.3%; bottom: -70px; }
    .ah-phone :global(.pf) { zoom: .4 !important; }
  }
</style>

<script>
  import "./fit.ts";
</script>
