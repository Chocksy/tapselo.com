---
import Layout from "../layouts/Layout.astro";
import Navbar from "./Navbar.astro";
import Footer from "./Footer.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import { breadcrumbLinks, toolBreadcrumbs, type FaqItem } from "../lib/unelte/jsonld.ts";

interface RelatedLink {
  href: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  heading: string;
  path: string;
  related?: RelatedLink[];
  lead?: string;
  campaign: string;
  ctaTitle?: string;
  ctaBody?: string;
  ctaHref?: string;
  jsonLd?: Record<string, unknown>[];
  faq?: FaqItem[];
}

const {
  title,
  description,
  heading,
  path,
  related = [],
  lead,
  campaign,
  ctaTitle = "Tapselo face asta automat la casa de marcat",
  ctaBody = "Cote TVA corecte pe bon, cântare Dibal, raport Z și stocuri, într-un singur program care merge și fără internet.",
  ctaHref = `/?utm_source=unelte&utm_medium=site&utm_campaign=${encodeURIComponent(campaign)}`,
  jsonLd = [],
  faq = [],
} = Astro.props;

const breadcrumbs = breadcrumbLinks(toolBreadcrumbs(heading, path));
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <Navbar />

  <header class="bg-primary pt-28 pb-14 md:pt-32">
    <div class="mx-auto max-w-5xl px-6">
      <Breadcrumbs items={breadcrumbs} />
      <h1 class="mt-3 font-display text-4xl italic text-white sm:text-5xl">{heading}</h1>
      {lead && <p class="mt-4 text-lg leading-relaxed text-text-on-primary/80">{lead}</p>}
    </div>
  </header>

  <main class="bg-surface-white py-14">
    <div class="mx-auto max-w-5xl space-y-12 px-6">
      <slot />

      {related.length > 0 && (
        <section aria-labelledby="related-title">
          <h2 id="related-title" class="font-display text-2xl italic text-primary">Ghiduri utile</h2>
          <ul class="mt-4 space-y-2">
            {related.map((r) => (
              <li>
                <a href={r.href} class="font-semibold text-accent underline-offset-2 hover:underline">{r.label}</a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {faq.length > 0 && (
        <section>
          <h2 class="font-display text-3xl italic text-primary">Întrebări frecvente</h2>
          <div class="mt-6 space-y-6">
            {faq.map((item) => (
              <div>
                <h3 class="text-lg font-semibold text-primary">{item.q}</h3>
                <p class="mt-2 leading-relaxed text-text-secondary">{item.a}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      <section class="rounded-xl border border-border bg-surface p-6 md:p-8">
        <h2 class="font-display text-3xl italic text-primary">{ctaTitle}</h2>
        <p class="mt-3 leading-relaxed text-text-secondary">{ctaBody}</p>
        <a
          href={ctaHref}
          class="mt-5 inline-block rounded-md bg-accent px-5 py-2.5 text-sm font-bold text-white transition-all hover:bg-accent-hover"
        >
          Vezi cum funcționează
        </a>
      </section>

      <p class="text-sm text-text-secondary">
        Pagina are scop informativ și nu este consultanță juridică sau fiscală. Pentru cazul tău, verifică sursele oficiale sau întreabă contabilul.
      </p>
    </div>
  </main>

  <Footer />
</Layout>

<style is:global>
  .ut-card {
    border-radius: 0.75rem;
    border: 1px solid var(--color-border-light);
    background: var(--color-surface-white);
    padding: 1.25rem;
  }
  @media (min-width: 640px) {
    .ut-card {
      padding: 1.5rem;
    }
  }
  .ut-label {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 0.35rem;
  }
  .ut-input,
  .ut-select,
  .ut-textarea {
    width: 100%;
    border-radius: 0.5rem;
    /* slate-500: 4.76:1 on white (WCAG 1.4.11 needs 3:1 for input borders) */
    border: 1px solid #64748b;
    padding: 0.55rem 0.75rem;
    font-size: 1rem;
    line-height: 1.4;
    color: var(--color-primary);
    background: #fff;
  }
  .ut-input:focus,
  .ut-select:focus,
  .ut-textarea:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }
  .ut-btn {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    padding: 0.5rem 1.1rem;
    font-size: 0.875rem;
    font-weight: 700;
    cursor: pointer;
    border: none;
    transition: background 0.15s;
  }
  .ut-btn-primary {
    background: var(--color-accent);
    color: #fff;
  }
  .ut-btn-primary:hover {
    background: var(--color-accent-hover);
  }
  .ut-btn-secondary {
    background: #fff;
    color: var(--color-accent);
    border: 1px solid var(--color-accent);
  }
  .ut-btn-secondary:hover {
    background: var(--color-accent);
    color: #fff;
  }
  .ut-seg {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .ut-seg button {
    flex: 1;
    min-width: 7rem;
    min-height: 2.75rem;
    border-radius: 0.5rem;
    border: 1px solid #64748b;
    color: var(--color-primary);
    background: #fff;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
  }
  .ut-seg button[aria-pressed="true"] {
    border: 2px solid var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 12%, white);
    color: var(--color-primary);
  }
  .ut-result {
    margin-top: 1rem;
    padding: 1rem;
    border-radius: 0.5rem;
    background: var(--color-surface);
    font-variant-numeric: tabular-nums;
  }
  .ut-result dt {
    font-size: 0.8rem;
    color: var(--color-text-secondary);
  }
  .ut-result dd {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-primary);
    margin: 0 0 0.5rem;
  }
  .ut-hint {
    font-size: 0.8rem;
    color: var(--color-text-secondary);
    margin-top: 0.35rem;
  }
  .ut-err {
    color: #b91c1c;
    font-size: 0.875rem;
    margin-top: 0.5rem;
  }
  .ut-warn {
    margin-top: 0.75rem;
    padding: 0.6rem 0.8rem;
    border: 1px solid #b91c1c;
    border-left-width: 4px;
    border-radius: 0.375rem;
    background: #fef2f2;
    color: #7f1d1d;
    font-size: 0.875rem;
  }
  .ut-btn:focus-visible,
  .ut-seg button:focus-visible,
  .ut-table button:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .ut-del {
    min-height: 2.25rem;
    padding: 0 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-accent);
    background: none;
    border: none;
    cursor: pointer;
  }
  .ut-table-wrap {
    overflow-x: auto;
    margin-top: 1rem;
  }
  .ut-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  .ut-table th,
  .ut-table td {
    border-bottom: 1px solid var(--color-border-light);
    padding: 0.45rem 0.35rem;
    text-align: left;
    vertical-align: top;
  }
  .ut-table th {
    font-weight: 600;
    color: var(--color-primary);
    background: var(--color-surface);
  }
  .ut-table input,
  .ut-table select {
    width: 100%;
    min-width: 4rem;
    border: 1px solid #64748b;
    border-radius: 0.35rem;
    padding: 0.35rem;
    font-size: 0.875rem;
  }
  /* Row tables (registru, NIR) become one card per row on phones; every input keeps its aria-label. */
  @media (max-width: 639px) {
    .ut-stack thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
    .ut-stack,
    .ut-stack tbody,
    .ut-stack tr,
    .ut-stack td {
      display: block;
      width: 100%;
    }
    .ut-stack tr {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem 0.75rem;
      padding: 0.75rem;
      margin-bottom: 0.75rem;
      border: 1px solid var(--color-border-light);
      border-radius: 0.5rem;
    }
    .ut-stack td {
      border: 0;
      padding: 0;
    }
    .ut-stack td[data-wide] {
      grid-column: 1 / -1;
    }
    .ut-stack td[data-label]::before {
      content: attr(data-label);
      display: block;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--color-primary);
      margin-bottom: 0.2rem;
    }
    .ut-stack input,
    .ut-stack select {
      font-size: 1rem;
      padding: 0.5rem;
      max-width: none !important;
    }
  }
</style>
