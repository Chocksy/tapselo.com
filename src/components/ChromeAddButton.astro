---
interface Props {
  href: string;
  /** Extra classes on the anchor (variant is chosen via `variant`). */
  class?: string;
  variant?: "hero" | "card";
  /** PostHog CTA id via data-tapselo-cta */
  ctaId?: string;
}

const {
  href,
  class: extraClass = "",
  variant = "card",
  ctaId = "chrome-web-store",
} = Astro.props;

const base =
  "group inline-flex items-center justify-center gap-2.5 rounded-md font-bold transition-all duration-150 active:scale-[0.98] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent";

const variantClass =
  variant === "hero"
    ? "border border-white/25 bg-white px-6 py-3.5 text-base text-primary shadow-lg shadow-black/20 hover:border-white/40 hover:bg-white/95"
    : "border border-border bg-white px-5 py-2.5 text-sm text-primary shadow-sm hover:border-accent/40 hover:shadow-md";
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  data-tapselo-cta={ctaId}
  class={`${base} ${variantClass} ${extraClass}`}
>
  <svg
    class="h-5 w-5 shrink-0"
    viewBox="0 0 48 48"
    aria-hidden="true"
    focusable="false"
  >
    <path fill="#EA4335" d="M24 9.5c3.54 0 6.78 1.22 9.33 3.24l7-6.82C36.68 2.36 30.66 0 24 0 14.64 0 6.51 5.38 2.56 13.22l8.34 6.46C12.36 13.1 17.74 9.5 24 9.5z" />
    <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
    <path fill="#FBBC05" d="M10.9 28.09c-.4-1.2-.63-2.48-.63-3.82s.23-2.62.63-3.82l-8.34-6.46C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.91l8.34-6.82z" />
    <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-8.34 6.82C6.51 42.62 14.64 48 24 48z" />
    <path fill="none" d="M0 0h48v48H0z" />
  </svg>
  Adaugă în Chrome
</a>
