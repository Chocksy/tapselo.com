---
---

<section class="ut-card" aria-labelledby="markup-title">
  <h2 id="markup-title" class="font-display text-2xl italic text-primary">Calculator adaos comercial</h2>
  <p class="mt-2 text-sm text-text-secondary">
    Calculează prețul de vânzare cu TVA din costul de achiziție fără TVA, sau invers. Poți rotunji la ,49 / ,99 ca la raft.
  </p>

  <div id="markup-tool" class="mt-6 space-y-4">
    <div class="ut-seg" role="group" aria-label="Direcție calcul">
      <button type="button" data-dir="forward" aria-pressed="true">Cost → preț vânzare</button>
      <button type="button" data-dir="reverse" aria-pressed="false">Preț → adaos</button>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label class="ut-label" for="mk-cost" id="mk-cost-label">Cost achiziție fără TVA (lei)</label>
        <input class="ut-input" id="mk-cost" type="text" inputmode="decimal" />
      </div>
      <div id="mk-sale-wrap" class="hidden">
        <label class="ut-label" for="mk-sale">Preț vânzare cu TVA (lei)</label>
        <input class="ut-input" id="mk-sale" type="text" inputmode="decimal" />
      </div>
      <div id="mk-markup-wrap">
        <label class="ut-label" for="mk-markup">Adaos comercial %</label>
        <input class="ut-input" id="mk-markup" type="text" inputmode="decimal" value="30" />
      </div>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label class="ut-label" for="mk-vat">Cotă TVA la vânzare</label>
        <select class="ut-select" id="mk-vat">
          <option value="21">21%</option>
          <option value="11" selected>11%</option>
          <option value="0">0%</option>
        </select>
      </div>
      <div>
        <label class="ut-label" for="mk-round">Rotunjire preț</label>
        <select class="ut-select" id="mk-round">
          <option value="none">Fără rotunjire</option>
          <option value="0.49_0.99">La ,49 sau ,99</option>
          <option value="0.09">La ,x9</option>
        </select>
      </div>
    </div>

    <label class="flex items-center gap-2 text-sm text-text-secondary">
      <input type="checkbox" id="mk-food" />
      Produs alimentar de bază (verificare plafon adaos 300%)
    </label>

    <dl class="ut-result" id="mk-result" aria-live="polite" />

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label class="ut-label" for="mk-store">Magazin (pentru afiș)</label>
        <input class="ut-input" id="mk-store" type="text" maxlength="80" placeholder="Numele magazinului" />
      </div>
      <div>
        <label class="ut-label" for="mk-product">Produs (pentru afiș)</label>
        <input class="ut-input" id="mk-product" type="text" maxlength="80" placeholder="Denumire produs" />
      </div>
    </div>
    <button type="button" class="ut-btn ut-btn-secondary" id="mk-afis">Printează afiș adaos</button>
  </div>
</section>

<script>
  import { calculateShelfPrice, type Rounding } from "../../lib/mcp/answers/shelf-price.ts";
  import { fmtLei } from "../../lib/generators/page.ts";
  import { foodMarkupWarning, renderAfisHtml } from "../../lib/unelte/markup-afis.ts";
  import { openPrintHtml } from "../../lib/unelte/document-export.ts";

  let direction: "forward" | "reverse" = "forward";

  function num(raw: string): number | null {
    const s = raw.trim().replace(/\s/g, "").replace(",", ".");
    if (!s) return null;
    const n = Number(s);
    return Number.isFinite(n) ? n : null;
  }

  function render() {
    const out = document.getElementById("mk-result");
    const food = (document.getElementById("mk-food") as HTMLInputElement).checked;
    const vat = Number((document.getElementById("mk-vat") as HTMLSelectElement).value);
    const rounding = (document.getElementById("mk-round") as HTMLSelectElement).value as Rounding;
    const cost = num((document.getElementById("mk-cost") as HTMLInputElement).value);
    if (cost === null || !(cost > 0)) {
      out!.innerHTML = "<p class=\"text-sm text-text-muted\">Introdu costul pentru rezultat.</p>";
      return;
    }
    try {
      if (direction === "forward") {
        const markup = num((document.getElementById("mk-markup") as HTMLInputElement).value);
        if (markup === null || markup < 0) {
          out!.innerHTML = "<p class=\"ut-err\">Adaos invalid.</p>";
          return;
        }
        const p = calculateShelfPrice({ cost, markup_percent: markup, vat_rate: vat, rounding });
        const warn = food ? foodMarkupWarning(p.markup_percent) : null;
        out!.innerHTML = `
          <dt>Preț vânzare cu TVA</dt><dd>${fmtLei(p.price_with_vat)}</dd>
          <dt>TVA</dt><dd>${fmtLei(p.vat_amount)}</dd>
          <dt>Preț fără TVA</dt><dd>${fmtLei(p.price_without_vat)}</dd>
          <dt>Adaos real</dt><dd>${p.markup_percent.toFixed(2).replace(".", ",")}%</dd>
          <dt>Câștig / bucată</dt><dd>${fmtLei(p.profit)}</dd>
          ${warn ? `<p class="ut-err mt-2">${warn}</p>` : ""}`;
      } else {
        const sale = num((document.getElementById("mk-sale") as HTMLInputElement).value);
        if (sale === null || !(sale > 0)) {
          out!.innerHTML = "<p class=\"text-sm text-text-muted\">Introdu prețul de vânzare cu TVA.</p>";
          return;
        }
        const netSale = sale / (1 + vat / 100);
        const profit = netSale - cost;
        const markup = cost > 0 ? (profit / cost) * 100 : 0;
        const warn = food ? foodMarkupWarning(markup) : null;
        out!.innerHTML = `
          <dt>Adaos din cost</dt><dd>${markup.toFixed(2).replace(".", ",")}%</dd>
          <dt>Marjă din preț fără TVA</dt><dd>${netSale > 0 ? ((profit / netSale) * 100).toFixed(2).replace(".", ",") : "0"}%</dd>
          <dt>Câștig / bucată (fără TVA)</dt><dd>${fmtLei(profit)}</dd>
          ${warn ? `<p class="ut-err mt-2">${warn}</p>` : ""}`;
      }
    } catch (e) {
      out!.innerHTML = `<p class="ut-err">${e instanceof Error ? e.message : "Date invalide."}</p>`;
    }
  }

  document.querySelectorAll<HTMLButtonElement>("[data-dir]").forEach((btn) => {
    btn.addEventListener("click", () => {
      direction = btn.dataset.dir === "reverse" ? "reverse" : "forward";
      document.querySelectorAll("[data-dir]").forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
      document.getElementById("mk-sale-wrap")?.classList.toggle("hidden", direction === "forward");
      document.getElementById("mk-markup-wrap")?.classList.toggle("hidden", direction === "reverse");
      document.getElementById("mk-cost-label")!.textContent =
        direction === "forward" ? "Cost achiziție fără TVA (lei)" : "Cost achiziție fără TVA (lei)";
      render();
    });
  });

  ["mk-cost", "mk-markup", "mk-sale", "mk-vat", "mk-round", "mk-food"].forEach((id) => {
    document.getElementById(id)?.addEventListener("input", render);
    document.getElementById(id)?.addEventListener("change", render);
  });
  render();

  document.getElementById("mk-afis")?.addEventListener("click", () => {
    const store = (document.getElementById("mk-store") as HTMLInputElement).value.trim() || "Magazin";
    const product = (document.getElementById("mk-product") as HTMLInputElement).value.trim() || "Produs";
    const vat = Number((document.getElementById("mk-vat") as HTMLSelectElement).value);
    const rounding = (document.getElementById("mk-round") as HTMLSelectElement).value as Rounding;
    const cost = num((document.getElementById("mk-cost") as HTMLInputElement).value);
    const markup = num((document.getElementById("mk-markup") as HTMLInputElement).value);
    const food = (document.getElementById("mk-food") as HTMLInputElement).checked;
    if (cost === null || markup === null || direction !== "forward") {
      alert("Pentru afiș, folosește modul Cost → preț vânzare cu adaos completat.");
      return;
    }
    try {
      const price = calculateShelfPrice({ cost, markup_percent: markup, vat_rate: vat, rounding });
      openPrintHtml(renderAfisHtml({ productName: product, storeName: store, price, foodRetail: food }));
    } catch {
      alert("Completează costul și adaosul.");
    }
  });
</script>
