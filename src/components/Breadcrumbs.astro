---
import type { BreadcrumbLink } from "../lib/unelte/jsonld.ts";

interface Props {
  items: BreadcrumbLink[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="bc">
  {items.map((item, i) => (
    <>
      {i > 0 && <span class="bc-s" aria-hidden="true">/</span>}
      {item.href ? (
        <a href={item.href}>{item.label}</a>
      ) : (
        <span class="bc-c" aria-current="page">{item.label}</span>
      )}
    </>
  ))}
</nav>

<style is:global>
  .bc { font-size: 14px; line-height: 1.5; color: var(--color-ink-3); }
  .bc a { color: inherit; text-decoration: none; transition: color .15s; }
  .bc a:hover { color: var(--color-ink); }
  .bc-s { margin: 0 9px; color: var(--color-perf); }
  .bc-c { color: var(--color-ink); font-weight: 500; }
</style>
