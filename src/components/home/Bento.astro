        <a class="hm-link" href="#how-it-works">Vezi tot turul <Fragment set:html={arrow} /></a>
      </div>
    </div>

    <div class="grid canvas" data-bento>
      <article class="t dk hero">
        <div class="m">
          <div class="kio"><div data-fit="740"><div class="ts-kiosk" data-layout="scanare" data-w="740"></div></div></div>
          <span class="net" aria-hidden="true"><b></b><span>Offline</span></span>
