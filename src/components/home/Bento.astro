---
// C1 bento in the I1 receipt look: every tile moves (kiosk loop, offline queue, phones, scale label,
// recipe rows, offers clip, Messenger order, campaign checks). Reduced motion shows the finished state.
const arrow = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>`;
// Decorative QR (not a real code): seeded pixels plus the three finder squares.
function qr(n = 25, seed = 7) {
  let s = seed;
  const rnd = () => ((s = (s * 9301 + 49297) % 233280) / 233280);
  const fin = (x: number, y: number) => {
    const f = (a: number, b: number) => a >= 0 && a < 7 && b >= 0 && b < 7;
    for (const [ox, oy] of [[0, 0], [n - 7, 0], [0, n - 7]]) if (f(x - ox, y - oy)) {
      const a = x - ox, b = y - oy;
      return a === 0 || a === 6 || b === 0 || b === 6 || (a > 1 && a < 5 && b > 1 && b < 5) ? 1 : 0;
    }
    return -1;
  };
  let d = "";
  for (let y = 0; y < n; y++) for (let x = 0; x < n; x++) {
    const v = fin(x, y);
    if (v === 1 || (v === -1 && rnd() > 0.52)) d += `M${x} ${y}h1v1h-1z`;
  }
  return `<svg viewBox="-1 -1 ${n + 2} ${n + 2}" shape-rendering="crispEdges" aria-hidden="true"><path fill="#1d1b17" d="${d}"/></svg>`;
}
