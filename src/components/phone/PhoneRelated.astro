---
// G2 related links. Pages the mockup names that do not exist yet point to the closest live page.
const LINKS = [
  { k: "Produs", t: "Casa de marcat", d: "Pe orice calculator, cu bon fiscal pe Datecs.", href: "/program-casa-de-marcat-pe-calculator/", go: "Vezi pagina" },
  { k: "Produs", t: "Admin", d: "Produse, stoc, rapoarte și codurile de activare.", href: "/admin/", go: "Vezi pagina" },
  { k: "Produs", t: "Plata cu cardul", d: "Stripe în admin, Tap to Pay pe iPhone.", href: "/admin/#card", go: "Vezi pagina" },
  { k: "Ghid", t: "Casă de marcat fără internet", d: "Ce cere ANAF când pică netul.", href: "/ghid/articole/casa-de-marcat-fara-internet/", go: "Citește" },
  { k: "Ghid", t: "Erori Datecs", d: "Codurile de eroare ale casei, pe scurt.", href: "/ghid/erori-datecs/", go: "Citește" },
];
---
<section class="pp-band pp-band--white tear-top pr" data-moment="tear" aria-labelledby="pr-h">
  <div class="pp-rails" aria-hidden="true"></div>
  <div class="site-container pr-in">
    <h2 id="pr-h" class="stamp-label pr-h">Funcții și ghiduri înrudite</h2>
    <ul class="pr-l">
      {LINKS.map((l) => (
        <li><a href={l.href}><em>{l.k}</em><b>{l.t}</b><span>{l.d}</span><i>{l.go} <span aria-hidden="true">&rarr;</span></i></a></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .pr-in { padding-block: clamp(64px, 7vw, 96px); }
  .pr-h { margin: 0; font-family: var(--font-mono); font-size: .72rem; font-weight: 500; letter-spacing: .1em; }
  .pr-l { display: grid; grid-template-columns: minmax(0, 1fr); margin: 36px 0 0; padding: 0; list-style: none; border-radius: 10px; background: var(--color-paper-white); box-shadow: 0 0 0 1px var(--color-rule); overflow: hidden; }
  @media (min-width: 640px) { .pr-l { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .pr-l { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
  .pr-l li { box-shadow: -1px 0 0 var(--color-rule), 0 -1px 0 var(--color-rule); }
  .pr-l a { display: flex; flex-direction: column; height: 100%; min-height: 168px; padding: 22px 22px 20px; transition: background-color .15s; }
  .pr-l a:hover { background: var(--color-paper); }
  .pr-l em { font: 500 11px/1 var(--font-mono); font-style: normal; letter-spacing: .07em; text-transform: uppercase; color: var(--color-ink-3); }
  .pr-l b { margin-top: 12px; font-size: 17px; font-weight: 600; line-height: 1.3; color: var(--color-ink); }
  .pr-l a > span { margin-top: 6px; font-size: 14px; line-height: 1.45; color: var(--color-ink-2); }
  .pr-l i { margin-top: auto; padding-top: 14px; font-style: normal; font-size: 14px; font-weight: 600; color: var(--color-accent); }
</style>
