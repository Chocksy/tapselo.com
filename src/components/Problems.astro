<section class="bg-surface py-12 md:py-16 border-b border-border">
  <div class="mx-auto max-w-6xl px-6">
    <div class="grid gap-6 sm:grid-cols-2 md:gap-8">
      <div class="animate-on-scroll">
        <p class="text-sm text-danger/60 line-through decoration-danger/30">Cade netul și nu mai pot vinde</p>
        <p class="mt-1.5 text-lg font-bold text-primary">Vinzi non-stop, datele se trimit singure</p>
      </div>
      <div class="animate-on-scroll animate-delay-100">
        <p class="text-sm text-danger/60 line-through decoration-danger/30">Licențe scumpe la fiecare calculator</p>
        <p class="mt-1.5 text-lg font-bold text-primary">Fără licențe — economie 600 lei pe casă</p>
      </div>
      <div class="animate-on-scroll animate-delay-200">
        <p class="text-sm text-danger/60 line-through decoration-danger/30">Nu știu ce produse îmi aduc profit</p>
        <p class="mt-1.5 text-lg font-bold text-primary">Vezi exact ce se vinde și unde pierzi bani</p>
      </div>
      <div class="animate-on-scroll animate-delay-300">
        <p class="text-sm text-danger/60 line-through decoration-danger/30">Recepția de marfă durează ore întregi</p>
        <p class="mt-1.5 text-lg font-bold text-primary">Fotografiezi factura și se completează singură</p>
      </div>
    </div>
  </div>
</section>
