---
// Floating CTA: on desktop it appears once `startId` has scrolled past (right rail from 1400px,
// where the margin has room; bottom bar below that); on mobile a bottom bar after 25% scroll.
// Hidden while `hideId` (the final CTA) is in view.
interface Props {
  href: string;
  label: string;
  cta: string;
  startId: string;
  hideId: string;
}
const { href, label, cta, startId, hideId } = Astro.props;
---

<div class="floating-cta" data-floating-cta data-start={startId} data-hide={hideId} hidden>
  <a
    href={href}
    data-tapselo-cta={cta}
    class="block rounded-md bg-accent px-5 py-3 text-center text-sm font-bold text-white shadow-lg transition-all hover:bg-accent-hover"
  >{label}</a>
</div>

<script>
  for (const box of document.querySelectorAll<HTMLElement>("[data-floating-cta]")) {
    const start = document.getElementById(box.dataset.start ?? "");
    const hide = document.getElementById(box.dataset.hide ?? "");
    const desktop = window.matchMedia("(min-width: 1024px)");
    let hideInView = false;
    const update = () => {
      const scrolled = window.scrollY / Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
      const past = desktop.matches
        ? !!start && start.getBoundingClientRect().bottom < 0
        : scrolled >= 0.25;
      box.hidden = !past || hideInView;
    };
    if (hide) {
      new IntersectionObserver(([e]) => {
        hideInView = e.isIntersecting;
        update();
      }).observe(hide);
    }
    window.addEventListener("scroll", update, { passive: true });
    desktop.addEventListener("change", update);
    update();
  }
</script>

<style>
  .floating-cta {
    position: fixed;
    z-index: 40;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0.75rem 1rem calc(0.75rem + env(safe-area-inset-bottom));
    background: rgb(255 255 255 / 0.95);
    border-top: 1px solid var(--color-border-light);
  }
  .floating-cta[hidden] { display: none; }
  @media (min-width: 1024px) {
    .floating-cta a { max-width: 20rem; margin: 0 auto; }
  }
  @media (min-width: 1400px) {
    .floating-cta a { max-width: none; }
    .floating-cta {
      left: auto;
      right: 1.5rem;
      bottom: 1.5rem;
      width: 13rem;
      padding: 0;
      background: none;
      border: 0;
    }
  }
</style>
