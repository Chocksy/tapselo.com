---
interface Props {
  class?: string;
}

const { class: className = "h-8 w-8 rounded" } = Astro.props;
---

<picture>
  <source srcset="/logo-64.webp" type="image/webp" />
  <img
    src="/logo-64.png"
    alt=""
    width="64"
    height="64"
    class={className}
    decoding="async"
  />
</picture>
