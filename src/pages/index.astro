---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Kit from "../components/Kit.astro";
import HomeHero from "../components/home/HomeHero.astro";
import SectionRail from "../components/home/SectionRail.astro";
import Chapters from "../components/home/Chapters.astro";
import Bento from "../components/home/Bento.astro";
import Start from "../components/home/Start.astro";
import Equipment from "../components/home/Equipment.astro";
import Reports from "../components/home/Reports.astro";
import Pricing from "../components/home/Pricing.astro";
import Faq from "../components/home/Faq.astro";
import Guides from "../components/home/Guides.astro";
import ContactBlock from "../components/home/ContactBlock.astro";
import { homepageFaqJsonLd } from "../lib/homepage-faq.ts";

const jsonLd = [homepageFaqJsonLd()];
---

<Layout title="Tapselo: casă de marcat pe calculator și iPhone" description="Casa de marcat care merge și fără internet: bon fiscal pe Datecs, cântar Dibal, stoc și rapoarte. Pe Windows, macOS, Linux și iPhone. Gratuit în beta." ogImage="https://tapselo.com/og/home.jpg" jsonLd={jsonLd}>
  <Navbar />
  <Kit />
  <main class="hm">
    <HomeHero />
    <SectionRail />
    <Chapters />
    <Bento />
    <Start />
    <Equipment />
    <Reports />
    <Pricing />
    <Faq />
    <Guides />
    <ContactBlock />
  </main>
  <Footer />
</Layout>

<style is:global>
  /* Homepage-only shared pieces (D1 + I1). Section components keep their own styles. */
  .hm { background: var(--color-paper); color: var(--color-ink); overflow-x: clip; }
  .hm section[id] { scroll-margin-top: calc(var(--bar-h) + 70px); }
  .hm-sec { position: relative; padding-block: clamp(4rem, 8vw, 7rem); }
  .hm-sec.white { background: var(--color-paper-white); --tear: var(--color-paper-white); }
  .hm-sec.line { border-top: 1px solid var(--color-rule); }
  .hm-sec.white + .hm-sec.line { border-top: 0; }
  .hm-head { display: grid; gap: 20px 56px; align-items: end; }
  @media (min-width: 900px) { .hm-head { grid-template-columns: minmax(0, 1fr) minmax(0, 26rem); } }
  .hm .stamp-label { margin: 0 0 20px; }
  .hm-h2 {
    margin: 0;
    font-family: var(--font-sans);
    font-style: normal;
    font-size: clamp(2.25rem, 2.6vw + 1rem, 3.5rem);
    line-height: 1.02;
    font-weight: 600;
    letter-spacing: -0.042em;
    color: var(--color-ink);
    text-wrap: balance;
  }
  .hm-h2 .mut { color: var(--color-ink-2); }
  .hm-h2 + .hm-lead { margin-top: 18px; }
  .hm .nw { white-space: nowrap; }
  .hm-lead { margin: 0; font-size: 17px; line-height: 1.55; color: var(--color-ink-2); text-wrap: pretty; }
  .hm-link { display: inline-flex; align-items: center; gap: 6px; margin-top: 14px; font-size: 15px; font-weight: 600; color: #2563eb; }
  .hm-link:hover { color: #1d4ed8; }
  .hm-link svg { transition: transform 0.3s var(--ease-out-soft); }
  .hm-link:hover svg { transform: translateX(3px); }
  .hm-btn, .hm-btn2 {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-height: 50px;
    padding: 0 22px;
    border-radius: 7px;
    font: 600 16px/1 var(--font-sans);
    white-space: nowrap;
    transition: background-color 0.2s, transform 0.2s var(--ease-out-soft);
  }
  .hm-btn { background: #2563eb; color: #fff; }
  .hm-btn:hover { background: #1d4ed8; }
  .hm-btn2 { background: #ebe5d8; color: var(--color-ink); box-shadow: inset 0 0 0 1px #ddd4c1; }
  .hm-btn2:hover { background: #e3dccc; }
  .hm-btn:active, .hm-btn2:active { transform: scale(0.98); }
  .hm-btn svg { transition: transform 0.25s var(--ease-out-soft); }
  .hm-btn:hover svg { transform: translateX(3px); }
  @media (prefers-reduced-motion: reduce) {
    .hm-btn, .hm-btn2, .hm-btn:active, .hm-btn2:active { transition: none; transform: none; }
  }
</style>

<script>
  import "../components/home/home.ts";
</script>
