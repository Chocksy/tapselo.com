    "@context": "https://schema.org",
    "@type": "Article",
    headline: heading,
    description,
    dateModified: verifiedOn,
    inLanguage: "ro-RO",
    url: canonicalUrl(path),
    mainEntityOfPage: canonicalUrl(path),
    author: {
