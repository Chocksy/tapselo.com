<GuideShell
  title="Certificat de atestare fiscală online din SPV (PF și PJ) — pași, termen, valabilitate | Tapselo"
  description={description}
  heading={heading}
  lead="Certificatul de atestare fiscală de la ANAF se solicită gratuit, inclusiv prin SPV; legea prevede emiterea în maximum 3 zile lucrătoare și o valabilitate de până la 30 de zile (până la 90 de zile pentru anumite persoane fizice fără activitate independentă). Nu confundați certificatul central ANAF cu certificatul local de la primărie."
  sources={sources}
  verifiedOn={verifiedOn}
  campaign="certificat-de-atestare-fiscala"
  breadcrumbs={breadcrumbLinks(crumbs)}
  ctaTitle="Documente de magazin, fără promisiuni nerealiste"
  ctaBody="Tapselo vă ajută cu vânzările, stocurile și bonurile fiscale zilnice — certificatul de atestare fiscală rămâne o cerere separată către ANAF, pe care o depuneți când o instituție o solicită."
  jsonLd={jsonLd}
  contentWidth="reading"
>
  <article class="kb-prose" set:html={markdownToHtml(body)} />

  <section>
    <h2 class="font-display text-3xl italic text-primary">Întrebări frecvente</h2>
    <div class="mt-6 space-y-6">
      {faq.map((item) => (
        <div class="rounded-xl border border-border-light p-5">
          <h3 class="text-lg font-semibold text-primary">{item.q}</h3>
          <p class="mt-2 leading-relaxed text-text-secondary">{item.a}</p>
        </div>
      ))}
    </div>
  </section>
</GuideShell>
