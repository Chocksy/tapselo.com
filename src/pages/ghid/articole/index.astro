---
// /ghid/articole — index of support articles (src/lib/kb/articles.json).
import GuideShell from "../../../components/GuideShell.astro";
import { supportArticles } from "../../../lib/articles/load.ts";
import { articlePath } from "../../../lib/articles/schema.ts";

const card = "block rounded-xl border border-border-light p-5 transition-colors hover:border-accent";

const tagOrder = ["A4200", "ANAF", "DUKIntegrator", "Datecs", "p7b", "Raport Z", "FP-70"];
const tags = [...new Set(supportArticles.flatMap((a) => a.tags))].sort((a, b) => {
  const ia = tagOrder.indexOf(a);
  const ib = tagOrder.indexOf(b);
  if (ia === -1 && ib === -1) return a.localeCompare(b, "ro");
  if (ia === -1) return 1;
  if (ib === -1) return -1;
  return ia - ib;
});

const latestUpdated = supportArticles.reduce((max, a) => (a.updated > max ? a.updated : max), supportArticles[0].updated);
---

<GuideShell
  title="Articole de suport: A4200, Datecs, ANAF | Ghid Tapselo"
  description="Ghiduri practice în română pentru depunerea A4200, exportul fișierelor .p7b, erori DUKIntegrator și raportul Z pe Datecs — cu surse ANAF și verificare gratuită."
  heading="Articole de suport"
  lead="Pași verificați pentru problemele frecvente la casă de marcat și raportarea către ANAF. Fiecare articol are surse oficiale și data verificării."
  campaign="articole"
  verifiedOn={latestUpdated}
  breadcrumbs={[
    { label: "Ghid pentru magazine", href: "/ghid" },
    { label: "Articole de suport" },
  ]}
>
  {tags.map((tag) => {
    const items = supportArticles.filter((a) => a.tags.includes(tag));
    if (items.length === 0) return null;
    return (
      <section>
        <h2 class="font-display text-3xl italic text-primary">{tag}</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          {items.map((a) => (
            <a href={articlePath(a.slug)} class={card}>
              <h3 class="text-primary">{a.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-text-secondary">{a.description}</p>
              <p class="mt-3 text-xs text-text-muted">Actualizat {a.updated}</p>
            </a>
          ))}
        </div>
      </section>
    );
  })}

  <section>
    <h2 class="font-display text-3xl italic text-primary">Toate articolele</h2>
    <ul class="mt-4 space-y-2 pl-5 text-text-secondary">
      {supportArticles.map((a) => (
        <li class="list-disc leading-relaxed">
          <a href={articlePath(a.slug)} class="text-accent hover:text-accent-hover">{a.title}</a>
        </li>
      ))}
    </ul>
  </section>
</GuideShell>
