---
// /ghid/{id}: one page per entry of src/lib/kb/rules.json.
import GuideShell from "../../components/GuideShell.astro";
import { markdownToHtml } from "../../lib/markdown.ts";
import rules from "../../lib/kb/rules.json";
import { internalPath } from "../../lib/internal-url.ts";

export function getStaticPaths() {
  return rules.map((rule) => ({ params: { id: rule.page.replace(/^\/ghid\//, "") }, props: { rule } }));
}

const RELATED_TOOLS: Record<string, { href: string; label: string }> = {
  "cote-tva-casa-de-marcat": { href: internalPath("/unelte/calculator-tva"), label: "Calculator TVA 21% și 11%" },
  "plafoane-numerar": { href: internalPath("/unelte/registru-de-casa"), label: "Generator registru de casă" },
  "registrul-de-casa": { href: internalPath("/unelte/registru-de-casa"), label: "Generator registru de casă" },
  "nir-nota-receptie": { href: internalPath("/unelte/generator-nir"), label: "Generator NIR" },
  "pret-unitar-kg-litru": { href: internalPath("/unelte/calculator-adaos-comercial"), label: "Calculator adaos comercial" },
  "garantie-sgr-bon-fiscal": {
    href: internalPath("/unelte/afise-obligatorii-magazin"),
    label: "Generator afișe obligatorii (SGR, ANPC, program)",
  },
  "raport-z-memorie-fiscala-p7b": {
    href: internalPath("/unelte/afise-obligatorii-magazin"),
    label: "Generator afiș casă de marcat",
  },
};

const { rule } = Astro.props;
const tool = RELATED_TOOLS[rule.id];
---

<GuideShell
  title={`${rule.title} | Ghid Tapselo`}
  description={rule.summary}
  heading={rule.title}
  lead={rule.summary}
  sources={rule.sources}
  verifiedOn={rule.verified_on}
  campaign={rule.id}
>
  <article class="kb-prose" set:html={markdownToHtml(rule.body)} />
  {tool && (
    <p class="rounded-xl border border-border-light p-5 text-sm text-text-secondary">
      Unealtă gratuită:{" "}
      <a href={tool.href} class="font-semibold text-primary underline underline-offset-2 hover:text-accent">{tool.label}</a>
    </p>
  )}
</GuideShell>
