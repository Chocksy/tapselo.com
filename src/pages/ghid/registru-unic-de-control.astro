    url: "https://legislatie.just.ro/Public/DetaliiDocument/29779",
  },
  {
    title: "ANAF — Întrebare–răspuns: achiziție RUC, sediu social, punct de lucru",
    url: "https://chat.anaf.ro/ANAFI.nsf/0/85ABB956125AC786C2257E9000484B15?OpenDocument=",
  },
  {
    title: "ANAF — Program vânzare RUC (exemplu: documente și contravaloare)",
