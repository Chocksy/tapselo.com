<GuideShell
  title="Registrul unic de control (RUC): obligații, amenzi, ANAF | Ghid Tapselo"
  description={description}
  heading={heading}
  lead="Firmele (persoane juridice) înmatriculate la ONRC trebuie să cumpere registrul unic de control de la ANAF, să îl țină la sediu și la punctele de lucru autorizate și să îl arate inspectorilor înainte de fiecare control — altfel riscați amenzile din art. 7–8 ale Legii 252/2003."
  sources={sources}
  verifiedOn={verifiedOn}
  campaign="registru-unic-de-control"
  breadcrumbs={breadcrumbLinks(crumbs)}
  ctaTitle="Evidența zilnică a magazinului, fără birocrație inutilă"
  ctaBody="Tapselo te ajută cu vânzările, stocurile și documentele de casă — ca la control să ai ordine în operațiuni, nu doar registrul unic completat de inspector."
  jsonLd={jsonLd}
>
