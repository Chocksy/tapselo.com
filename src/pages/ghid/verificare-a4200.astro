---
import GuideShell from "../../components/GuideShell.astro";
import A4200Checker from "../../components/A4200Checker.astro";
import { XSD_BUNDLE, VERIFIED_ON } from "../../lib/a4200/constants.ts";

const siteUrl = "https://tapselo.com";
const pageUrl = `${siteUrl}/ghid/verificare-a4200`;

const faq = [
  {
    q: "Ce este declarația A4200?",
    a: "Este pachetul lunar de raportare pentru casa de marcat electronică fiscală (AMEF): un opis al perioadei și câte un fișier pentru fiecare zi fiscală (raport Z).",
  },
  {
    q: "Ce este opisul (registrul)?",
    a: "Fișierul A4200 semnat (de obicei Perioada_raportare.p7b) care spune ce rapoarte Z intră în declarație: nrRapI, nrRapF, CIF și tip AMEF.",
  },
  {
    q: "De ce DUKIntegrator spune că lipsește o zi?",
    a: "Folderul trebuie să conțină toate zilele din intervalul din opis, fără duplicate și fără alte fișiere. Verificatorul de mai sus compară opisul cu lista de .p7b încărcate.",
  },
  {
    q: "Trebuie semnate fișierele?",
    a: "Da, exportul din casă este PKCS#7 (.p7b) semnat cu certificatul AMEF. Pentru depunere folosești DUKIntegrator: Validare + creare PDF semnat cu tokenul tău.",
  },
  {
    q: "Fișierele mele pleacă de pe calculator?",
    a: "Nu. Această pagină rulează în browser; nu încărcăm opisul sau zilele pe server.",
  },
  {
    q: "De ce văd erori XSD la cote 11% sau 21%?",
    a: "Schema XSD publică din 2018 listează alte cote TVA. Validatorul ANAF actualizat (J1.0.5+) le acceptă de obicei; actualizează kitul A4203 în DUKIntegrator.",
  },
  {
    q: "Pot folosi arhive ZIP de la contabil?",
    a: "Da, poți trage un .zip cu .p7b-uri; le extragem local în browser.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Verificare A4200 Tapselo",
    url: pageUrl,
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    inLanguage: "ro",
    isAccessibleForFree: true,
    offers: { "@type": "Offer", price: "0", priceCurrency: "RON" },
    description:
      "Verificare gratuită A4200: opis și zile fiscale înainte de DUKIntegrator, în browser, fără upload.",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
];
---

<GuideShell
  title="Verificare A4200 gratuită: opis și zile fiscale | Tapselo"
  description="Verificare A4200 gratuită în browser: opis și zile fiscale .p7b sau XML, fără upload. Compară cu DUKIntegrator, decodează .err.txt, ghid semnare."
  heading="Verifică fișierele A4200 înainte de DUKIntegrator"
  lead="Încarcă opisul și zilele exportate din Datecs sau alt AMEF. Validăm schema ANAF, potrivim rapoartele Z și explicăm erorile în română — totul local, fără trimitere pe internet."
  sources={[
    { title: "ANAF — Formular A4200", url: "https://static.anaf.ro/static/10/Anaf/Declaratii_R/4200.html" },
    { title: "ANAF — Validator A4203", url: "https://static.anaf.ro/static/10/Anaf/Declaratii_R/4203.html" },
    { title: XSD_BUNDLE.a4200.file, url: XSD_BUNDLE.a4200.url },
    { title: XSD_BUNDLE.a4203.file, url: XSD_BUNDLE.a4203.url },
    { title: "DUKIntegrator", url: "https://static.anaf.ro/static/DUKIntegrator/DUKIntegrator.htm" },
  ]}
  verifiedOn={VERIFIED_ON}
  campaign="verificare-a4200"
  ctaTitle="Tapselo exportă și verifică A4200 direct din casă"
  jsonLd={jsonLd}
>
  <section>
    <A4200Checker />
  </section>

  <section>
    <h2 class="font-display text-3xl italic text-primary">Pași în DUKIntegrator (semnare)</h2>
    <ol class="kb-prose mt-4 list-decimal pl-5">
      <li>Descarcă kitul de la <a href="https://static.anaf.ro/static/DUKIntegrator/DUKIntegrator.htm" rel="noopener" target="_blank">ANAF DUKIntegrator</a> și instalează validatorii A4200 + A4203.</li>
      <li>Copiază într-un folder gol doar opisul și zilele .p7b (cale fără spații, de ex. <code>C:\A4200\</code>).</li>
      <li>Deschide DUKIntegrator, alege declarația <strong>A4200</strong>.</li>
      <li>În listă selectează <strong>doar</strong> fișierul opis (Perioada_raportare.p7b) — zilele sunt citite automat din același folder.</li>
      <li>Rulează <strong>Validare</strong>, apoi <strong>Validare + creare PDF semnat</strong> cu tokenul tău.</li>
      <li>Încarcă PDF-ul semnat pe e-guvernare / SPV conform instrucțiunilor ANAF.</li>
    </ol>
  </section>

  <section>
    <h2 class="font-display text-3xl italic text-primary">Note tehnice (export Datecs)</h2>
    <ul class="kb-prose mt-4 list-disc pl-5 text-sm">
      <li>Exporturile semnate sunt <strong>PKCS#7 (.p7b)</strong> cu XML-ul fiscal în interior; extragem conținutul local, fără verificarea certificatului AMEF în browser.</li>
      <li>Numărul raportului Z este în ultimele 4 caractere ale <code>idM</code> / <code>idR</code> (28 caractere), aliniat cu numele <code>_Zxxxx.p7b</code>.</li>
      <li>Opisul poate să nu aibă <code>an</code>/<code>luna</code>; folosim data din <code>idM</code> și comparăm cu zilele.</li>
      <li>Schema XSD publică (2018) nu listează încă cotele 11% și 21%; validatorul ANAF actualizat le acceptă — actualizează kitul A4203 dacă XSD-ul din browser raportează multe erori de cote.</li>
      <li>Încă de confirmat pe mai multe modele: variante de nume fișier, arhive parțiale, XMLDSig în loc de CMS, și mesaje .err.txt reale pentru extinderea decoderului.</li>
    </ul>
  </section>

  <section>
    <h2 class="font-display text-3xl italic text-primary">Întrebări frecvente</h2>
    <div class="mt-6 space-y-6">
      {faq.map((item) => (
        <div>
          <h3 class="text-lg font-semibold text-primary">{item.q}</h3>
          <p class="mt-2 text-text-secondary leading-relaxed">{item.a}</p>
        </div>
      ))}
    </div>
  </section>
</GuideShell>
