---
import GuideShell from "../../components/GuideShell.astro";
import A4200Checker from "../../components/A4200Checker.astro";
import { VERIFIED_ON } from "../../lib/a4200/constants.ts";
import { A4200_CHECKER_PATH } from "../../lib/articles/schema.ts";
import { breadcrumbLinks, toolBreadcrumbs, toolJsonLd } from "../../lib/unelte/jsonld.ts";

const path = A4200_CHECKER_PATH;
const heading = "Depune A4200 fără să te pierzi în fișiere";

const faq = [
  {
    q: "Ce este declarația A4200?",
    a: "Este raportarea lunară a casei de marcat cu jurnal electronic: un fișier de perioadă și câte un fișier pentru fiecare zi închisă cu raportul Z.",
  },
  {
    q: "Ce fișiere primesc de la service?",
    a: "De obicei o arhivă sau un stick cu fișierul de perioadă (nume tip Perioada_raportare) și fișierele zilnice pentru fiecare raport Z din lună.",
  },
  {
    q: "De ce îmi spune că lipsește o zi?",
    a: "Setul trebuie să conțină toate zilele din intervalul declarat în fișierul de perioadă, fără duplicate. Asistentul de mai sus compară lista din registru cu fișierele încărcate.",
  },
  {
    q: "Fișierele mele pleacă de pe calculator?",
    a: "Verificarea din pașii 1–2 rulează în browser și nu trimite conținutul fișierelor. Doar dacă generezi PDF-ul prin Tapselo, exportul este trimis criptat către server, procesat și șters imediat.",
  },
  {
    q: "Pot folosi arhiva ZIP de la contabil?",
    a: "Da. Poți încărca arhiva .zip; o deschidem local în browser.",
  },
  {
    q: "Am nevoie de A4200 dacă casa nu a transmis Z-urile din cauza internetului?",
    a: "Da, pentru rapoartele Z care nu au ajuns la ANAF. Vezi ghidul Casa de marcat fără internet: bonuri offline, transmitere ANAF și F4110.",
  },
];

const jsonLd = toolJsonLd({
  path,
  heading,
  appName: "Verificare A4200 Tapselo",
  description:
    "Asistent pas cu pas pentru verificarea și depunerea declarației A4200: export de la casă, PDF, semnare și încărcare ANAF.",
  faq,
});
---

<GuideShell
  title="Verificare A4200 gratuită: ghid pas cu pas | Tapselo"
  description="Verifică exportul lunar de la casă, generează PDF-ul, semnează și încarcă la ANAF — asistent în 4 pași, în română, fără jargon."
  heading={heading}
  breadcrumbs={breadcrumbLinks(toolBreadcrumbs(heading, path))}
  lead="Asistent în patru pași pentru magazine: încarcă arhiva de la service, verificăm zilele, obții PDF-ul semnat și știi cum verifici recipisa ANAF."
  sources={[
    { title: "ANAF — Formular A4200", url: "https://static.anaf.ro/static/10/Anaf/Declaratii_R/4200.html" },
    { title: "ANAF — Validator A4203", url: "https://static.anaf.ro/static/10/Anaf/Declaratii_R/4203.html" },
    { title: "DUKIntegrator", url: "https://static.anaf.ro/static/DUKIntegrator/DUKIntegrator.htm" },
  ]}
  verifiedOn={VERIFIED_ON}
  campaign="verificare-a4200"
  ctaTitle="Tapselo exportă și verifică A4200 direct din casă"
  jsonLd={jsonLd}
>
  <section>
    <A4200Checker />
  </section>

  <section>
    <h2 class="font-display text-3xl italic text-primary">Internet întrerupt la casă</h2>
    <p class="mt-4 text-sm leading-relaxed text-text-secondary">
      Dacă casa de marcat a emis bonuri offline, dar rapoartele Z nu au ajuns la ANAF, exportul lunar și declarația A4200
      rămân calea de recuperare.
      <a href="/ghid/articole/casa-de-marcat-fara-internet/" class="text-accent hover:text-accent-hover"
        >Casa de marcat fără internet</a
      > — obligații, F4110 pentru zone fără semnal, amendă pentru neconectare.
    </p>
  </section>

  <section>
    <h2 class="font-display text-3xl italic text-primary">Întrebări frecvente</h2>
    <div class="mt-6 space-y-6">
      {faq.map((item) => (
        <div>
          <h3 class="text-lg font-semibold text-primary">{item.q}</h3>
          <p class="mt-2 text-text-secondary leading-relaxed">{item.a}</p>
        </div>
      ))}
    </div>
  </section>

  <details class="mt-8 rounded-xl border border-border-light p-4 text-sm">
    <summary class="cursor-pointer font-semibold text-primary">Detalii tehnice (validare ANAF)</summary>
    <ul class="kb-prose mt-4 list-disc pl-5 text-text-secondary">
      <li>Exporturile Datecs sunt fișiere semnate PKCS#7 (.p7b) cu XML reconstruit din CMS SignedData.</li>
      <li>Numărul raportului Z este în ultimele 4 caractere ale identificatorului mesajului (idM / idR), aliniat cu numele _Zxxxx.</li>
      <li>Schema XSD publică (2018) poate semnala cote TVA 11% și 21%; validatorul ANAF actualizat le acceptă de obicei.</li>
      <li>Decoderul pentru mesaje DUKIntegrator (.err.txt) este în secțiunea Detalii tehnice a asistentului de mai sus.</li>
    </ul>
  </details>
</GuideShell>
