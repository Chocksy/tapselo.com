---
import GuideShell from "../../components/GuideShell.astro";
import A4200Checker from "../../components/A4200Checker.astro";
import { XSD_BUNDLE, VERIFIED_ON } from "../../lib/a4200/constants.ts";

const siteUrl = "https://tapselo.com";
const pageUrl = `${siteUrl}/ghid/verificare-a4200`;

const faq = [
  {
    q: "Ce este declarația A4200?",
    a: "Este pachetul lunar pentru casa de marcat: un fișier cu descrierea perioadei și câte un fișier pentru fiecare zi fiscală (raport Z).",
  },
  {
    q: "Ce este opisul perioadei?",
    a: "Fișierul exportat de casă (de obicei Perioada_raportare.p7b) care spune ce rapoarte Z intră în declarație și pentru ce firmă.",
  },
  {
    q: "De ce lipsește o zi la verificare?",
    a: "Arhiva trebuie să conțină toate zilele din perioada declarată, fără duplicate. Comparăm opisul cu fișierele încărcate și îți spunem ce lipsește.",
  },
  {
    q: "Trebuie semnate fișierele de la casă?",
    a: "Da, exportul vine semnat de aparat. Pentru depunere la ANAF generezi un PDF, îl semnezi cu certificatul tău digital și îl încarci pe site-ul ANAF.",
  },
  {
    q: "Fișierele mele pleacă de pe calculator?",
    a: "Verificarea din pașii 1–2 rulează în browser și nu trimite opisul sau zilele pe internet. Generarea PDF-ului (pasul 3) trimite fișierele către serverul Tapselo doar dacă apeși acel buton.",
  },
  {
    q: "Pot folosi arhiva ZIP de la contabil?",
    a: "Da. Poți încărca arhiva .zip; extragem fișierele local în browser.",
  },
  {
    q: "Am nevoie de A4200 dacă casa nu a transmis Z-urile din cauza internetului?",
    a: "Da, pentru rapoartele Z netransmise la ANAF. Vezi ghidul Casa de marcat fără internet: bonuri offline, transmitere ANAF și F4110.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Verificare A4200 Tapselo",
    url: pageUrl,
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    inLanguage: "ro",
    isAccessibleForFree: true,
    offers: { "@type": "Offer", price: "0", priceCurrency: "RON" },
    description:
      "Verificare gratuită A4200 în patru pași simpli: încarcă arhiva, verifică zilele, PDF semnat, depunere ANAF.",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
];
---

<GuideShell
  title="Verificare A4200 gratuită: ghid pas cu pas | Tapselo"
  description="Verificare A4200 gratuită în browser: încarcă arhiva de la service, verifică zilele fiscale, generează PDF și depune la ANAF — explicații simple în română."
  heading="Declarația A4200, pas cu pas"
  lead="Patru pași clari pentru comercianți: încarcă arhiva de la service, verificăm zilele, pregătești PDF-ul semnat și îl depui la ANAF. Fără termeni tehnici în fluxul principal."
  sources={[
    { title: "ANAF — Formular A4200", url: "https://static.anaf.ro/static/10/Anaf/Declaratii_R/4200.html" },
    { title: "ANAF — Validator A4203", url: "https://static.anaf.ro/static/10/Anaf/Declaratii_R/4203.html" },
    { title: XSD_BUNDLE.a4200.file, url: XSD_BUNDLE.a4200.url },
    { title: XSD_BUNDLE.a4203.file, url: XSD_BUNDLE.a4203.url },
    { title: "DUKIntegrator", url: "https://static.anaf.ro/static/DUKIntegrator/DUKIntegrator.htm" },
  ]}
  verifiedOn={VERIFIED_ON}
  campaign="verificare-a4200"
  ctaTitle="Tapselo exportă și verifică A4200 direct din casă"
  jsonLd={jsonLd}
>
  <section>
    <A4200Checker />
  </section>

  <section>
    <h2 class="font-display text-3xl italic text-primary">Întrebări frecvente</h2>
    <div class="mt-6 space-y-6">
      {faq.map((item) => (
        <div>
          <h3 class="text-lg font-semibold text-primary">{item.q}</h3>
          <p class="mt-2 text-text-secondary leading-relaxed">{item.a}</p>
        </div>
      ))}
    </div>
  </section>

  <details class="mt-10 rounded-xl border border-border-light bg-surface p-5">
    <summary class="cursor-pointer font-display text-2xl italic text-primary">Detalii tehnice (export Datecs și validare)</summary>
    <div class="kb-prose mt-4 space-y-4 text-sm text-text-secondary">
      <p>
        Dacă AMEF a emis bonuri offline dar rapoartele Z nu au ajuns la ANAF, exportul lunar și declarația A4200 rămân
        calea de recuperare —
        <a href="/ghid/articole/casa-de-marcat-fara-internet" class="text-accent hover:text-accent-hover"
          >Casa de marcat fără internet</a
        >.
      </p>
      <ul class="list-disc pl-5">
        <li>Exporturile Datecs sunt PKCS#7 (.p7b) cu XML în bucăți; le reconstruim din semnătura CMS.</li>
        <li>Numărul raportului Z este în ultimele 4 caractere ale identificatorului idM / idR și în numele fișierului _Zxxxx.p7b.</li>
        <li>Schema XSD publică (2018) nu listează cotele TVA 11% și 21%; validatorul ANAF actualizat le acceptă de obicei.</li>
        <li>Folderul pentru DUKIntegrator local: cale fără spații, doar opisul și zilele .p7b.</li>
      </ul>
    </div>
  </details>
</GuideShell>
