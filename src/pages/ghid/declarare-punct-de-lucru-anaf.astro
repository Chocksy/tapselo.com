const sources = [
  {
    title: "Legea nr. 245/2025 (MO 1.204 / 29.12.2025) — art. 32 alin. (7) Legea 273/2006",
    url: "https://static.anaf.ro/static/10/Anaf/legislatie/L_245_2025.pdf",
  },
  {
    title: "OG nr. 6/2026 (MO 77 / 30.01.2026) — art. 85¹ CPF",
    url: "https://static.anaf.ro/static/10/Anaf/legislatie/OG_6_2026.pdf",
  },
  {
    title: "Cod de procedură fiscală — forma consolidată ANAF",
    url: "https://static.anaf.ro/static/10/Anaf/cod_procedura/Cod_Procedura_Fiscala_2023.htm",
  },
  {
    title: "Formular 060 — OPANAF 508/2026 (PDF + instrucțiuni)",
    url: "https://static.anaf.ro/static/10/Anaf/formulare/D_060_OPANAF_508_2026.pdf",
  },
  {
    title: "Formular 061 — OPANAF 3725/2017",
    url: "https://static.anaf.ro/static/10/Anaf/formulare/061_A9_OPANAF_3725_2017.pdf",
  },
  {
    title: "Catalog formulare ANAF",
