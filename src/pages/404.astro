---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { internalPath } from "../lib/internal-url.ts";
---

<Layout
  title="Pagina nu a fost găsită — Tapselo"
  description="Adresa pe care ai deschis-o nu există pe tapselo.com. Mergi la pagina principală sau la uneltele gratuite pentru comercianți."
  noindex={true}
>
  <Navbar />

  <header class="bg-primary pt-28 pb-14 md:pt-32">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <p class="text-sm font-semibold uppercase tracking-wide text-accent">Eroare 404</p>
      <h1 class="mt-3 font-display text-4xl italic text-white sm:text-5xl">Pagina nu a fost găsită</h1>
      <p class="mt-4 text-lg leading-relaxed text-text-on-primary/80">
        Linkul este greșit, pagina a fost mutată sau nu există. Poți reveni la pagina principală sau la uneltele gratuite.
      </p>
    </div>
  </header>

  <main class="bg-surface-white py-14">
    <div class="mx-auto flex max-w-md flex-col items-center gap-4 px-6">
      <a
        href="/"
        class="ut-btn ut-btn-primary w-full max-w-xs text-center no-underline"
      >
        Pagina principală
      </a>
      <a
        href={internalPath("/unelte")}
        class="ut-btn ut-btn-secondary w-full max-w-xs text-center no-underline"
      >
        Unelte gratuite
      </a>
    </div>
  </main>

  <Footer />
</Layout>

<style is:global>
  .ut-btn {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    padding: 0.5rem 1.1rem;
    font-size: 0.875rem;
    font-weight: 700;
    cursor: pointer;
    border: none;
    transition: background 0.15s;
  }
  .ut-btn-primary {
    background: var(--color-accent);
    color: #fff;
  }
  .ut-btn-primary:hover {
    background: var(--color-accent-hover);
  }
  .ut-btn-secondary {
    background: #fff;
    color: var(--color-accent);
    border: 1px solid var(--color-accent);
  }
  .ut-btn-secondary:hover {
    background: var(--color-accent);
    color: #fff;
  }
</style>
