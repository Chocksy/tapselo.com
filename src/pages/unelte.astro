---
import GuideShell from "../components/GuideShell.astro";

const tools = [
  {
    href: "/ghid/verificare-a4200",
    title: "Verificare A4200",
    description:
      "Asistent în 4 pași: verifică exportul lunar de la casă, obții PDF-ul, semnezi și încarci la ANAF — verificarea inițială în browser, fără încărcare pe server.",
  },
];
---

<GuideShell
  title="Unelte gratuite pentru comercianți | Tapselo"
  description="Unelte gratuite Tapselo: asistent A4200 în browser pentru verificarea exportului de la casă."
  heading="Unelte gratuite"
  lead="Instrumente care rulează în browserul tău. La verificare, nu colectăm conținutul fișierelor fiscale."
  ctaTitle="Vrei export A4200 direct din casă?"
  campaign="unelte"
>
  <ul class="space-y-4">
    {tools.map((t) => (
      <li class="rounded-xl border border-border-light p-5 transition-colors hover:border-accent">
        <a href={t.href} class="block">
          <h2 class="text-lg font-semibold text-primary">{t.title}</h2>
          <p class="mt-2 text-sm text-text-secondary">{t.description}</p>
        </a>
      </li>
    ))}
  </ul>
</GuideShell>
