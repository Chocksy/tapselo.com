---
import { ArrowRight, BadgePercent, Calculator, ClipboardList, FileCheck, NotebookPen, ScanBarcode } from "@lucide/astro";
import GuideShell from "../components/GuideShell.astro";
import { A4200_CHECKER_PATH } from "../lib/articles/schema.ts";
import { barcodeApiBase } from "../lib/unelte/barcode.ts";
import { breadcrumbJsonLd, breadcrumbLinks, type Crumb } from "../lib/unelte/jsonld.ts";

const barcodeEnabled = barcodeApiBase(import.meta.env.PUBLIC_BARCODE_API_URL) !== "";

const crumbs: Crumb[] = [
  { name: "Acasă", path: "/" },
  { name: "Unelte gratuite", path: "/unelte" },
];

const tools = [
  {
    href: "/unelte/calculator-tva",
    title: "Calculator TVA",
    icon: Calculator,
    action: "Deschide calculatorul",
    description:
      "Adaugă sau scoate TVA la 21% și 11%. Calculează preț cu TVA, preț fără TVA și suma TVA." +
      (barcodeEnabled ? " Opțional: cota TVA după codul de bare EAN." : ""),
  },
  {
    href: "/unelte/verificare-cod-de-bare",
    title: "Verificare cod de bare",
    icon: ScanBarcode,
    action: "Deschide verificarea",
    description:
      "Caută un produs după codul EAN-13: țara prefixului (594 = România), cifra de control, denumirea, cota TVA, marca și imaginea.",
  },
  {
    href: "/unelte/registru-de-casa",
    title: "Registru de casă",
    icon: NotebookPen,
    action: "Deschide registrul",
    description:
      "Generator zilnic: sold din ziua precedentă, încasări, plăți, sold final. Export PDF și Excel, cu avertizare la plafonul de 50.000 lei.",
  },
  {
    href: "/unelte/generator-nir",
    title: "Generator NIR",
    icon: ClipboardList,
    action: "Deschide generatorul",
    description:
      "Notă de recepție și constatare de diferențe din datele facturii: liniile de marfă, TVA, adaos, PDF printabil pentru semnături.",
  },
  {
    href: "/unelte/calculator-adaos-comercial",
    title: "Calculator adaos comercial",
    icon: BadgePercent,
    action: "Deschide calculatorul",
    description:
      "De la cost fără TVA la preț de vânzare cu TVA și invers, rotunjire la raft și afiș de preț. Verifică plafonul de 20% pentru alimentele de bază.",
  },
  {
    href: A4200_CHECKER_PATH,
    title: "Verificare A4200",
    icon: FileCheck,
    action: "Deschide verificarea",
    description:
      "Asistent în 4 pași: verifică exportul lunar de la casă, obții PDF-ul, semnezi și încarci la ANAF — verificarea inițială în browser.",
  },
];
---

<GuideShell
  title="Unelte gratuite pentru comercianți | Tapselo"
  description="Unelte gratuite Tapselo: calculator TVA, verificare cod de bare, registru de casă, generator NIR, adaos comercial și verificare A4200 — în browser, în română."
  heading="Unelte gratuite"
  lead="Instrumente care rulează în browserul tău. Nu colectăm conținutul documentelor pe care le generezi local."
  ctaTitle="Vrei mai puțină muncă manuală la casă?"
  campaign="unelte"
  breadcrumbs={breadcrumbLinks(crumbs)}
  jsonLd={[breadcrumbJsonLd(crumbs)]}
>
  <ul class="grid gap-4 sm:grid-cols-2">
    {tools.map(({ href, title, icon: Icon, action, description }) => (
      <li>
        <a
          href={href}
          class="group flex h-full cursor-pointer flex-col rounded-xl border border-border-light bg-surface-white p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-accent hover:shadow-lg hover:shadow-accent/10 focus-visible:-translate-y-0.5 focus-visible:border-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 active:translate-y-0 motion-reduce:translate-none sm:p-6"
        >
          <span
            class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-accent-light text-accent transition-colors group-hover:bg-accent group-hover:text-white group-focus-visible:bg-accent group-focus-visible:text-white"
            aria-hidden="true"
          >
            <Icon class="h-5 w-5" />
          </span>
          <h2 class="mt-4 font-sans text-lg font-semibold not-italic leading-snug tracking-normal text-primary">{title}</h2>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-text-secondary">{description}</p>
          <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-bold text-accent group-hover:text-accent-hover">
            {action}
            <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-1 motion-reduce:translate-none" aria-hidden="true" />
          </span>
        </a>
      </li>
    ))}
  </ul>
</GuideShell>
