---
import GuideShell from "../components/GuideShell.astro";

const tools = [
  {
    href: "/ghid/verificare-a4200",
    title: "Verificare A4200",
    description:
      "Patru pași simpli: încarcă arhiva de la service, verifică zilele fiscale, pregătește PDF-ul semnat și depune la ANAF — verificare locală în browser.",
  },
];
---

<GuideShell
  title="Unelte gratuite pentru comercianți | Tapselo"
  description="Unelte gratuite Tapselo: verificare A4200 pas cu pas în browser, cu explicații în română."
  heading="Unelte gratuite"
  lead="Instrumente care rulează în browserul tău. La verificarea A4200, fișierele de la casă nu sunt trimise pe server decât dacă alegi generarea PDF-ului."
  ctaTitle="Vrei export A4200 direct din casă?"
  campaign="unelte"
>
  <ul class="space-y-4">
    {tools.map((t) => (
      <li class="rounded-xl border border-border-light p-5 transition-colors hover:border-accent">
        <a href={t.href} class="block">
          <h2 class="text-lg font-semibold text-primary">{t.title}</h2>
          <p class="mt-2 text-sm text-text-secondary">{t.description}</p>
        </a>
      </li>
    ))}
  </ul>
</GuideShell>
