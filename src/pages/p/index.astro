---
// /p/{slug}: privacy notice for one store's customer list, built from public_signup_info.
// Static page; public/_redirects rewrites /p/* here and the script reads the slug from the URL.
import PublicShell from "../../components/PublicShell.astro";
---

<PublicShell title="Datele clienților" wide>
  <p id="loading" class="pub-card pub-text">Se încarcă...</p>

  <div id="missing" class="pub-card hidden">
    <p class="pub-text text-xl font-semibold text-primary" id="missing-msg">Nu am găsit acest magazin.</p>
  </div>

  <article id="notice" class="pub-card pub-notice hidden">
    <h1 class="pub-title">Cum folosim datele clienților la <span data-f="store_name"></span></h1>
    <p class="text-sm">Versiunea din 28 septembrie 2026.</p>

    <h3>Cine răspunde de date</h3>
    <p>
      Operatorul datelor este <strong><span data-f="company_name"></span></strong>,
      CUI <span data-f="cui"></span>, adresa <span data-f="address"></span>.
    </p>
    <p class="contact-email-line">Contact pentru date: <a data-f="privacy_email" class="pub-link contact-email" href="#"></a>.</p>
    <p class="contact-store-line" hidden>Contact pentru date: la casa magazinului.</p>

    <h3>Ce date avem</h3>
    <ul>
      <li>numele, numărul de telefon și adresa de email pe care ni le dai;</li>
      <li>ce ai ales: client înscris, oferte pe email, oferte pe WhatsApp, oferte pe baza cumpărăturilor;</li>
      <li>când și unde ți-ai dat acordul și ce text ai văzut atunci;</li>
      <li>cumpărăturile legate de numele tău la casă: produsele, sumele, data și magazinul.</li>
    </ul>

    <h3>De ce le folosim și pe ce bază</h3>
    <ul>
      <li>
        <strong>Client înscris:</strong> te recunoaștem la casă și îți dăm
        <span class="discount-part" hidden>reducerea de <span data-f="discount"></span>% și </span>avantajele
        de client. Baza: contractul dintre tine și magazin (art. 6 alin. 1 lit. b GDPR).
      </li>
      <li>
        <strong>Oferte pe email:</strong> îți trimitem oferte pe email, numai după ce confirmi adresa.
        Baza: acordul tău (art. 6 alin. 1 lit. a GDPR și Legea 506/2004).
      </li>
      <li>
        <strong>Oferte pe WhatsApp:</strong> îți trimitem oferte pe WhatsApp. Baza: acordul tău
        (art. 6 alin. 1 lit. a GDPR și Legea 506/2004).
      </li>
      <li>
        <strong>Oferte pe baza cumpărăturilor:</strong> ne uităm la ce cumperi (produse, date,
        magazin) ca să alegem ofertele potrivite pentru tine. Asta înseamnă profilare (art. 4
        pct. 4 GDPR). Nu luăm decizii automate cu efect juridic asupra ta. Baza: acordul tău.
      </li>
    </ul>
    <p>
      Fiecare acord este separat. Reducerea de client nu depinde de acordul pentru oferte.
      Nu vindem datele tale și nu le dăm altor firme pentru reclame.
    </p>

    <h3>Cât timp le păstrăm</h3>
    <p>
      Păstrăm datele 24 de luni de la ultima cumpărare. Apoi le ștergem automat, împreună cu
      istoricul acordurilor. Bonurile fiscale rămân în evidența contabilă a magazinului cât cere legea,
      fără datele tale de contact.
    </p>

    <h3>Cine ne ajută să le prelucrăm</h3>
    <ul>
      <li>Tapselo (Ciocanel Razvan Tudor PFA, România): programul de casă și evidența clienților.</li>
      <li>Supabase: baza de date, găzduită în Uniunea Europeană.</li>
      <li>Resend: trimiterea mesajelor pe email.</li>
      <li>Meta (WhatsApp): trimiterea mesajelor pe WhatsApp, numai dacă ai ales oferte pe WhatsApp.</li>
    </ul>
    <p>Acești furnizori folosesc datele numai la cererea noastră, pe baza unui contract.</p>

    <h3>Drepturile tale</h3>
    <ul>
      <li>să vezi ce date avem despre tine și să primești o copie;</li>
      <li>să corectezi datele greșite;</li>
      <li>să ceri ștergerea datelor;</li>
      <li>să te opui prelucrării și să ceri limitarea ei;</li>
      <li>să retragi oricând orice acord. Retragerea nu afectează ce s-a făcut înainte.</li>
    </ul>
    <p>
      Te poți dezabona și din orice mesaj cu oferte, cu linkul din josul mesajului.
      <span class="contact-email-line">Pentru restul, scrie la <a data-f="privacy_email" class="pub-link contact-email" href="#"></a>.</span>
      <span class="contact-store-line" hidden>Pentru restul, spune la casa magazinului.</span>
      Răspundem în cel mult o lună.
    </p>

    <h3>Plângeri</h3>
    <p>
      Poți face plângere la Autoritatea Națională de Supraveghere a Prelucrării Datelor cu
      Caracter Personal (ANSPDCP), B-dul G-ral. Gheorghe Magheru 28-30, București,
      <a class="pub-link" href="https://www.dataprotection.ro" rel="noopener noreferrer" target="_blank">www.dataprotection.ro</a>.
    </p>
  </article>
</PublicShell>

<script>
  import { rpc, firstRow, slugFromPath, fillFields, infoFields, type SignupInfo } from "../../lib/supabase-public";

  const $ = (id: string) => document.getElementById(id) as HTMLElement;

  function show(id: "loading" | "missing" | "notice") {
    for (const s of ["loading", "missing", "notice"]) $(s).classList.toggle("hidden", s !== id);
  }

  async function init() {
    const slug = slugFromPath("p");
    if (!slug) return show("missing");

    const res = await rpc<unknown>("public_signup_info", { p_slug: slug });
    if (!res.ok) {
      if (res.kind !== "rejected") $("missing-msg").textContent = res.message;
      return show("missing");
    }

    const info = firstRow<SignupInfo>(res.data);
    if (!info || !info.store_name) return show("missing");

    const f = infoFields(info);
    fillFields(document, f);
    $("shell-store").textContent = f.store_name;
    document.title = `Datele clienților - ${f.store_name}`;
    document.querySelectorAll<HTMLElement>(".discount-part").forEach((el) => (el.hidden = !f.discount));

    const hasEmail = Boolean(f.privacy_email);
    document.querySelectorAll<HTMLElement>(".contact-email-line").forEach((el) => (el.hidden = !hasEmail));
    document.querySelectorAll<HTMLElement>(".contact-store-line").forEach((el) => (el.hidden = hasEmail));
    if (hasEmail) {
      document
        .querySelectorAll<HTMLAnchorElement>("a.contact-email")
        .forEach((a) => (a.href = `mailto:${f.privacy_email}`));
    }
    show("notice");
  }

  void init();
</script>
