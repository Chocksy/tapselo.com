---
// /ai: docs page for the "Tapselo" MCP connector (https://tapselo.com/mcp).
// The tool list comes from the registry (src/lib/mcp/tools.ts). Every tool needs a line in LINES,
// else the build fails, so the page cannot drift from the tools.
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import EmailLink from "../components/EmailLink.astro";
import { internalPath } from "../lib/internal-url.ts";
import { answerTools } from "../lib/mcp/tools.ts";
import { generatorTools } from "../lib/generators/tools.ts";

const LINES: Record<string, string> = {
  search_business_rules:
    "Răspunde la întrebări despre TVA, grupa TVA pe casa de marcat, plafoane, raport Z, e-Factura, SAF-T, NIR, SGR și alergeni, cu surse oficiale.",
  explain_datecs_error: "Explică un cod de eroare de la casa de marcat Datecs și spune ce să faci.",
  dibal_scale_help: "Ajutor pentru cântarele Dibal: format cod de bare, PLU, etichete, rețea și sincronizare cu POS-ul.",
  decode_scale_barcode: "Citește un cod de bare de pe eticheta de cântar: PLU, greutate sau preț și cifra de control.",
  calculate_shelf_price: "Calculează prețul la raft din cost, adaos sau marjă, cota TVA și rotunjire, plus prețul pe kg sau litru.",
  check_company: "Verifică o firmă după CUI în registrul public ANAF: denumire, adresă, TVA, TVA la încasare, e-Factura, stare.",
  check_tax_thresholds: "Compară cifra de afaceri anuală cu plafonul de scutire TVA și cu plafonul de microîntreprindere (curs BNR).",
  open_shop_checklist: "Lista de autorizații și pași pentru un magazin nou: măcelărie, brutărie, cafenea, alimentară și altele.",
  compare_pos_systems: "Compară programe de casă de marcat din România pentru tipul tău de magazin. Comparația este făcută de Tapselo.",
  lookup_products_by_ean: "Caută produse după codul de bare în Open Food Facts: nume, marcă, gramaj, poză. Până la 30 de coduri.",
  create_offer_flyer: "Face un flyer A4 cu ofertele magazinului.",
  create_shelf_labels: "Face etichete de raft A4 (21 pe pagină) cu preț, preț pe kg sau litru și cod de bare.",
  create_nir: "Face o notă de intrare-recepție (NIR) dintr-o factură de la furnizor, cu TVA, adaos și totaluri.",
  create_recipe_sheet: "Face o fișă tehnică pentru o rețetă: ingrediente, cost pe porție și alergeni.",
  create_cash_book: "Face registrul de casă pentru o zi: încasări, plăți și soldul după fiecare înregistrare.",
};

const describe = (name: string): string => {
  const line = LINES[name];
  if (!line) throw new Error(`/ai: missing description for tool ${name}`);
  return line;
};
const groups = [
  { title: "Răspunsuri", lead: "Unelte care răspund pe loc. Nu salvează nimic.", tools: answerTools },
  {
    title: "Documente",
    lead: "Unelte care fac o pagină printabilă pe tapselo.com. Linkul expiră în 30 de zile.",
    tools: generatorTools,
  },
].map((g) => ({ ...g, tools: g.tools.map((t) => ({ name: t.name, title: t.title, line: describe(t.name) })) }));
const extra = Object.keys(LINES).filter((n) => ![...answerTools, ...generatorTools].some((t) => t.name === n));
if (extra.length) throw new Error(`/ai: descriptions for unknown tools: ${extra.join(", ")}`);

const PROMPTS = [
  "Ce grupă TVA pun pentru pâine pe casa de marcat?",
  "Casa de marcat Datecs îmi dă eroarea -111008, ce fac?",
  "Decodează codul de bare 2800123012342",
  "Cost 10 lei fără TVA, adaos 30%, TVA 11%, rotunjit la ,99",
  "Verifică CUI 14399840",
  "Vreau să deschid o măcelărie, ce autorizații îmi trebuie?",
  "Ce program de casă de marcat e bun pentru o brutărie cu rețete?",
  "Fă-mi un flyer cu oferte: Telemea 32 lei/kg redus la 27, Cafea Jacobs 250g 22 lei redus la 18",
  "Fă etichete de raft pentru: Ulei Floriol 1L 11,99 lei, EAN 5941234567890",
  "(cu poza facturii atașată) Fă-mi NIR cu adaos 25%",
];

const MCP_URL = "https://tapselo.com/mcp";
const a = "font-bold text-accent hover:text-accent-hover";
const p = "mt-4 leading-relaxed text-text-secondary";
const li = "list-disc leading-relaxed";
---

<Layout
  title="Tapselo în Claude și ChatGPT | Tapselo"
  description="Conectorul Tapselo pentru Claude și ChatGPT: reguli fiscale, erori Datecs, cântare Dibal, calcul preț, verificare firmă și documente printabile pentru magazinele mici din România."
>
  <Navbar />

  <header class="bg-primary pt-28 pb-14 md:pt-32">
    <div class="mx-auto max-w-5xl px-6">
      <h1 class="font-display text-4xl italic text-white sm:text-5xl">Tapselo în Claude și ChatGPT</h1>
      <p class="mt-4 text-lg leading-relaxed text-text-on-primary/80">
        Un conector care dă asistentului AI reguli verificate și calcule pentru magazinele mici din România, plus
        documente gata de printat.
      </p>
    </div>
  </header>

  <main class="bg-surface-white py-14">
    <div class="mx-auto max-w-5xl space-y-12 px-6">
      <section>
        <h2 class="font-display text-3xl italic text-primary">Ce face</h2>
        <p class={p}>
          Întrebi în Claude sau ChatGPT, în română sau în engleză, iar asistentul folosește uneltele Tapselo. Răspunde
          la întrebări despre TVA și casa de marcat, explică erorile Datecs, citește codurile de bare de la cântarele
          Dibal, calculează prețul la raft, verifică o firmă după CUI și îți spune ce autorizații îți trebuie pentru un
          magazin nou. Poate face și documente printabile: flyer cu oferte, etichete de raft, NIR, fișă tehnică și
          registru de casă.
        </p>
        <p class={p}>Fiecare răspuns are un link către pagina cu detalii sau către documentul creat.</p>
      </section>

      <section>
        <h2 class="font-display text-3xl italic text-primary">Cum îl adaugi în Claude</h2>
        <p class={p}>Din directorul de conectori: În curând în directorul Claude.</p>
        <p class={p}>Manual, ca și conector propriu:</p>
        <ol class="mt-4 space-y-2 pl-5 text-text-secondary">
          <li class="list-decimal leading-relaxed">Deschide Claude și mergi la <strong class="text-primary">Settings &rarr; Connectors</strong>.</li>
          <li class="list-decimal leading-relaxed">Apasă <strong class="text-primary">Add custom connector</strong>.</li>
          <li class="list-decimal leading-relaxed">Nume: <code>Tapselo</code>. URL: <code>{MCP_URL}</code>.</li>
          <li class="list-decimal leading-relaxed">Nu completa nimic la autentificare (OAuth). Conectorul nu cere cont și nu cere logare.</li>
          <li class="list-decimal leading-relaxed">Apasă <strong class="text-primary">Add</strong>, apoi activează conectorul în chat.</li>
        </ol>
        <p class={p}>
          În ChatGPT conectorul va fi disponibil mai târziu, după verificarea aplicațiilor pentru România. Până atunci
          poți folosi aceeași adresă, <code>{MCP_URL}</code>, dacă contul tău permite conectori proprii.
        </p>
      </section>

      <section>
        <h2 class="font-display text-3xl italic text-primary">Unelte</h2>
        {groups.map((g) => (
          <div class="mt-6">
            <h3 class="text-xl font-bold text-primary">{g.title}</h3>
            <p class="mt-1 text-sm text-text-muted">{g.lead}</p>
            <ul class="mt-4 space-y-3">
              {g.tools.map((t) => (
                <li id={t.name} class="rounded-xl border border-border-light p-4">
                  <p class="font-bold text-primary">{t.title}</p>
                  <p class="mt-1 text-sm leading-relaxed text-text-secondary">{t.line}</p>
                  <p class="mt-2 text-xs text-text-muted"><code>{t.name}</code></p>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>

      <section>
        <h2 class="font-display text-3xl italic text-primary">Exemple de întrebări</h2>
        <ol class="mt-4 space-y-2 pl-5 text-text-secondary">
          {PROMPTS.map((q) => <li class="list-decimal leading-relaxed">{q}</li>)}
        </ol>
      </section>

      <section>
        <h2 class="font-display text-3xl italic text-primary">Limite</h2>
        <ul class="mt-4 space-y-2 pl-5 text-text-secondary">
          <li class={li}>Nu ai nevoie de cont. Conectorul nu știe cine ești și nu vede datele magazinului tău.</li>
          <li class={li}>Documentele create expiră după 30 de zile. Salvează-le ca PDF dacă ai nevoie de ele mai târziu.</li>
          <li class={li}>Oricine are linkul unui document îl poate deschide. Nu pune în documente date pe care nu vrei să le arăți.</li>
          <li class={li}>Documentele nu pot conține linkuri sau adrese web.</li>
          <li class={li}>
            Informațiile au scop informativ și nu sunt consultanță juridică sau fiscală. Verifică sursele oficiale sau
            întreabă contabilul.
          </li>
        </ul>
      </section>

      <section>
        <h2 class="font-display text-3xl italic text-primary">Datele tale</h2>
        <p class={p}>
          Conectorul primește doar datele trimise pentru o unealtă (de exemplu un CUI sau lista de produse), nu
          conversația ta. Răspunsurile nu se salvează. Documentele se păstrează 30 de zile, apoi se șterg automat.
          În loguri scriem doar numele uneltei, rezultatul și durata, fără textul tău. Detalii în
          <a href={internalPath("/privacy#asistent-ai")} class={a}>politica de confidențialitate</a>.
        </p>
      </section>

      <section>
        <h2 class="font-display text-3xl italic text-primary">Ajutor</h2>
        <p class={p}>
          Pentru întrebări, erori, ștergerea unui document sau raportarea unei pagini, scrie la
          <EmailLink class={a} />. Pentru un document, trimite și linkul lui.
        </p>
      </section>

      <section id="english" lang="en" class="rounded-xl border border-border bg-surface p-6 md:p-8">
        <h2 class="font-display text-3xl italic text-primary">In English</h2>
        <p class={p}>
          "Tapselo" is an MCP connector for Claude and ChatGPT that helps small shops in Romania. It
          answers questions on Romanian VAT and cash register rules, explains Datecs fiscal printer errors, decodes
          Dibal scale barcodes, does shelf price math, checks a company by CUI in the ANAF registry, lists the permits
          for a new shop, compares POS software (the comparison is made by Tapselo), and looks up products by EAN. It
          also makes printable pages: offer flyers, shelf labels, NIR (goods received notes), recipe sheets and cash
          books.
        </p>
        <p class={p}>
          Add it in Claude: Settings &rarr; Connectors &rarr; Add custom connector, URL <code>{MCP_URL}</code>, no
          sign-in. Documents expire after 30 days and are public to anyone with the link. No account is needed. The
          information is not legal or tax advice. Privacy:
          <a href={internalPath("/privacy#asistent-ai")} class={a}>tapselo.com/privacy#asistent-ai</a>. Support:
          <EmailLink class={a} />.
        </p>
      </section>
    </div>
  </main>

  <Footer />
</Layout>
