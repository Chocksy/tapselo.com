---
// /comparatie: POS / casa de marcat software from src/lib/kb/competitors.json.
import { Check, X } from "@lucide/astro";
import GuideShell from "../components/GuideShell.astro";
import { NEEDS, featureState, orderComparisonVendors, type Competitor } from "../lib/mcp/answers/compare.ts";
import { formatDateRo } from "../lib/mcp/text.ts";
import { vendorLogoPath } from "../lib/kb/vendor-logos.ts";
import competitorsJson from "../lib/kb/competitors.json";
import { internalPath } from "../lib/internal-url.ts";

const vendors = orderComparisonVendors(competitorsJson as (Competitor & { id: string })[]);
const needs = Object.entries(NEEDS) as [keyof typeof NEEDS, { field: string; label: string }][];
const state = (v: Competitor, field: string) => featureState((v as unknown as Record<string, unknown>)[field]);

const dates = vendors.map((v) => v.verified_on).filter((d): d is string => !!d).sort();
const range =
  dates.length === 0 ? "" : dates[0] === dates.at(-1) ? formatDateRo(dates[0]) : `${formatDateRo(dates[0])} - ${formatDateRo(dates.at(-1)!)}`;

const structuredList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Comparație programe casă de marcat și POS România",
  description:
    "Comparație între programe de casă de marcat și POS pentru magazine din România, cu surse publice de la producători.",
  itemListElement: vendors.map((v, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: v.name,
    url: v.url,
  })),
};
---

<GuideShell
  title="Comparație programe casă de marcat și POS pentru magazine | Tapselo"
  description="Programe de casă de marcat și POS din România, comparate după offline, imprimantă fiscală, cântare, rețete, stocuri, comenzi online, recepție marfă din foto, arhivă .p7b, oferte clienți și asistent AI. Date de pe site-urile producătorilor, cu surse."
  heading="Comparație programe de casă de marcat"
  lead="Ce știe fiecare program, după informațiile publice de pe site-ul producătorului."
  ctaTitle="Vrei să vezi Tapselo la lucru?"
  verifiedOn={dates.at(-1) ?? null}
  campaign="comparatie"
  breadcrumb={false}
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredList)} />

  <p class="rounded-xl border border-ticket bg-ticket-light p-4 text-sm text-primary">
    Pagina este făcută de Tapselo, unul dintre producătorii din tabel. Datele vin de pe site-urile producătorilor, verificate la {range}.
    Bifa verde = da, conform site-ului producătorului. X roșu = nu sau neverificat (nu am găsit informația publică).
  </p>
  <p class="text-sm text-text-secondary">
    Cauți un <a href={internalPath("/program-gestiune-magazin/")} class="font-semibold text-accent hover:underline">program de gestiune pentru magazin</a>?
    Vezi cum abordează Tapselo stocurile, recepția și inventarul.
  </p>

  <nav aria-label="Filtre">
    <p class="text-sm font-bold text-primary">Sari la criteriu:</p>
    <div class="mt-3 flex flex-wrap gap-2">
      {needs.map(([key, n]) => (
        <a href={`#criteriu-${key}`} class="rounded-full border border-border px-3 py-1 text-sm text-text-secondary hover:border-accent hover:text-accent">{n.label}</a>
      ))}
    </div>
  </nav>

  <section>
    <h2 class="font-display text-3xl italic text-primary">Tabel comparativ</h2>
    <p class="mt-2 text-sm text-text-muted">
      Pe telefon poți glisa la dreapta; prima coloană (criteriile) rămâne fixă. Coloana Tapselo este evidențiată.
    </p>
    <div class="compare-scroll mt-6">
      <table class="compare-table kb-table">
        <thead>
          <tr>
            <th scope="col" class="compare-sticky compare-sticky-top compare-feature-h">Criteriu</th>
            {vendors.map((v) => {
              const logo = vendorLogoPath(v.id);
              const isTapselo = v.id === "tapselo";
              return (
                <th
                  scope="col"
                  class:list={["compare-sticky-top compare-vendor-h", isTapselo && "compare-tapselo-col"]}
                >
                  <a href={`#${v.id}`} class="compare-vendor-head" title={v.name}>
                    {logo && (
                      <img src={logo} alt="" width={28} height={28} class="vendor-logo" loading="lazy" decoding="async" />
                    )}
                    <span class="compare-vendor-name">{v.name}</span>
                  </a>
                </th>
              );
            })}
          </tr>
        </thead>
        <tbody>
          <tr class="compare-price-row">
            <th scope="row" class="compare-sticky compare-feature-h">Preț de la</th>
            {vendors.map((v) => (
              <td class:list={[v.id === "tapselo" && "compare-tapselo-col", "compare-price-cell"]}>
                <span class="compare-price-text">{v.pricing_from ?? "necunoscut"}</span>
              </td>
            ))}
          </tr>
          {needs.map(([key, n]) => (
            <tr id={`criteriu-${key}`}>
              <th scope="row" class="compare-sticky compare-feature-h">
                <a href={`#are-${key}`} class="text-primary hover:text-accent">{n.label}</a>
              </th>
              {vendors.map((v) => {
                const s = state(v, n.field);
                const isTapselo = v.id === "tapselo";
                const unknown = s === null;
                const yes = s === true;
                return (
                  <td class:list={["compare-icon-cell", isTapselo && "compare-tapselo-col"]}>
                    {yes ? (
                      <Check class="compare-icon compare-icon-yes" aria-hidden="true" />
                    ) : (
                      <span class="compare-icon-wrap" title={unknown ? "Neverificat pe site-ul producătorului" : "Nu"}>
                        <X class="compare-icon compare-icon-no" aria-hidden="true" />
                        <span class="sr-only">{unknown ? "neverificat" : "nu"}</span>
                      </span>
                    )}
                  </td>
                );
              })}
            </tr>
          ))}
          <tr>
            <th scope="row" class="compare-sticky compare-feature-h">Verificat</th>
            {vendors.map((v) => (
              <td class:list={["compare-meta-cell", v.id === "tapselo" && "compare-tapselo-col"]}>
                {v.verified_on ? formatDateRo(v.verified_on) : "—"}
              </td>
            ))}
          </tr>
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-xs text-text-muted">
      X roșu la „nu” sau „neverificat”: treci cu mouse-ul peste icon pentru detalii. Pentru surse complete, vezi detaliile pe producător mai jos.
    </p>
  </section>

  {needs.map(([key, n]) => {
    const yes = vendors.filter((v) => state(v, n.field) === true);
    const unknown = vendors.filter((v) => state(v, n.field) === null);
    return (
      <section id={`are-${key}`}>
        <h2 class="font-display text-3xl italic text-primary">{n.label}</h2>
        <p class="mt-3 text-text-secondary">
          Da: {yes.length ? yes.map((v, j) => (<>{j > 0 && ", "}<a href={`#${v.id}`} class="text-accent hover:text-accent-hover">{v.name}</a></>)) : "niciun program din lista"}.
        </p>
        {unknown.length > 0 && (
          <p class="mt-1 text-sm text-text-muted">Neverificat: {unknown.map((v) => v.name).join(", ")}.</p>
        )}
      </section>
    );
  })}

  <section>
    <h2 class="font-display text-3xl italic text-primary">Detalii pe producător</h2>
    <div class="mt-6 space-y-6">
      {vendors.map((v) => {
        const logo = vendorLogoPath(v.id);
        return (
        <div id={v.id} class:list={["rounded-xl border p-5", v.id === "tapselo" ? "border-accent bg-ticket-light/40 ring-1 ring-accent/30" : "border-border-light"]}>
          <h3 class="text-primary">
            <span class="vendor-cell">
              {logo && (
                <img src={logo} alt="" width={32} height={32} class="vendor-logo" loading="lazy" decoding="async" />
              )}
              <a href={v.url} rel="noopener" target="_blank" class="hover:text-accent">{v.name}</a>
            </span>
          </h3>
          {v.segments && v.segments.length > 0 && <p class="mt-1 text-sm text-text-muted">Pentru: {v.segments.join(", ")}</p>}
          {v.notes && <p class="mt-3 leading-relaxed text-text-secondary">{v.notes}</p>}
          <p class="mt-3 text-sm text-text-secondary">
            <strong class="text-primary">Prețuri:</strong> {v.pricing_public ?? "necunoscut"}
            {v.pricing_from && <> (de la {v.pricing_from})</>}
          </p>
          {v.sources && v.sources.length > 0 && (
            <p class="mt-2 text-sm text-text-muted">
              Surse:{" "}
              {v.sources.map((s, j) => (<>{j > 0 && ", "}<a href={s.url} rel="noopener" target="_blank" class="text-accent hover:text-accent-hover">{s.title}</a></>))}
            </p>
          )}
          <p class="mt-1 text-sm text-text-muted">Verificat la {v.verified_on ? formatDateRo(v.verified_on) : "necunoscut"}.</p>
        </div>
        );
      })}
    </div>
  </section>
</GuideShell>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .vendor-cell {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    vertical-align: middle;
  }
  .vendor-logo {
    border-radius: 6px;
    object-fit: contain;
    flex-shrink: 0;
    background: var(--color-surface-white);
    box-shadow: 0 0 0 1px var(--color-border-light);
  }

  .compare-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    max-width: 100%;
    border: 1px solid var(--color-border-light);
    border-radius: 0.75rem;
    background: var(--color-surface-white);
  }

  .compare-table {
    width: max-content;
    min-width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 0.8125rem;
  }

  .compare-table th,
  .compare-table td {
    border-bottom: 1px solid var(--color-border-light);
    padding: 0.45rem 0.35rem;
    vertical-align: middle;
  }

  .compare-feature-h {
    text-align: left;
    font-weight: 600;
    color: var(--color-primary);
    min-width: 7.25rem;
    max-width: 9.5rem;
    line-height: 1.3;
    padding-left: 0.65rem;
    padding-right: 0.5rem;
  }

  .compare-vendor-h {
    text-align: center;
    font-weight: 600;
    min-width: 4.75rem;
    max-width: 6.5rem;
    background: var(--color-surface);
  }

  .compare-vendor-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-primary);
    text-decoration: none;
  }
  .compare-vendor-head:hover {
    color: var(--color-accent);
  }

  .compare-vendor-name {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 0.65rem;
    line-height: 1.2;
    font-weight: 600;
    hyphens: auto;
  }

  @media (min-width: 768px) {
    .compare-vendor-name {
      font-size: 0.7rem;
      -webkit-line-clamp: 2;
    }
    .compare-vendor-h {
      min-width: 5.5rem;
      max-width: 7.25rem;
    }
  }

  @media (min-width: 1024px) {
    .compare-table {
      width: 100%;
      table-layout: fixed;
    }
    .compare-feature-h {
      width: 11rem;
    }
    .compare-vendor-h {
      width: auto;
    }
    .compare-vendor-name {
      font-size: 0.72rem;
    }
  }

  .compare-sticky {
    position: sticky;
    left: 0;
    z-index: 2;
    background: var(--color-surface-white);
    box-shadow: 1px 0 0 var(--color-border-light);
  }

  .compare-sticky-top {
    position: sticky;
    top: 0;
    z-index: 3;
  }

  .compare-table thead .compare-feature-h {
    z-index: 4;
    background: var(--color-surface);
  }

  .compare-tapselo-col {
    background: color-mix(in srgb, var(--color-accent-light) 55%, var(--color-surface-white));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-accent) 25%, transparent);
  }

  .compare-table thead .compare-tapselo-col {
    background: color-mix(in srgb, var(--color-accent-light) 70%, var(--color-surface));
  }

  .compare-icon-cell {
    text-align: center;
  }

  .compare-icon {
    width: 1.15rem;
    height: 1.15rem;
    margin-inline: auto;
    display: block;
  }

  .compare-icon-yes {
    color: var(--color-success);
    stroke-width: 2.5;
  }

  .compare-icon-no {
    color: var(--color-danger);
    stroke-width: 2.5;
  }

  .compare-icon-wrap {
    display: inline-flex;
    justify-content: center;
    cursor: help;
  }

  .compare-price-row th,
  .compare-price-row td {
    background: var(--color-surface-elevated);
  }

  .compare-price-cell {
    text-align: center;
    font-size: 0.68rem;
    line-height: 1.25;
    font-weight: 600;
    color: var(--color-primary);
  }

  @media (min-width: 768px) {
    .compare-price-cell {
      font-size: 0.72rem;
    }
  }

  .compare-meta-cell {
    text-align: center;
    font-size: 0.65rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .compare-table tbody tr:last-child th,
  .compare-table tbody tr:last-child td {
    border-bottom: none;
  }

  .compare-table tr:target th,
  .compare-table tr:target td {
    background: var(--color-ticket-light);
  }
</style>
