---
// /comparatie: POS / casa de marcat software from src/lib/kb/competitors.json.
// Facts only from the KB; null shows "necunoscut". Filters are plain anchors to per-feature lists.
import GuideShell from "../components/GuideShell.astro";
import { NEEDS, featureState, type Competitor } from "../lib/mcp/answers/compare.ts";
import { formatDateRo } from "../lib/mcp/text.ts";
import { vendorLogoPath } from "../lib/kb/vendor-logos.ts";
import competitorsJson from "../lib/kb/competitors.json";

const vendors = competitorsJson as (Competitor & { id: string })[];
const needs = Object.entries(NEEDS) as [keyof typeof NEEDS, { field: string; label: string }][];
const state = (v: Competitor, field: string) => featureState((v as unknown as Record<string, unknown>)[field]);
const mark = (s: boolean | null) => (s === true ? "da" : s === false ? "nu" : "necunoscut");
const markClass = (s: boolean | null) => (s === true ? "text-success font-medium" : s === false ? "text-text-secondary" : "text-text-muted");

const dates = vendors.map((v) => v.verified_on).filter((d): d is string => !!d).sort();
const range =
  dates.length === 0 ? "" : dates[0] === dates.at(-1) ? formatDateRo(dates[0]) : `${formatDateRo(dates[0])} - ${formatDateRo(dates.at(-1)!)}`;

const structuredList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Comparatie programe casa de marcat si POS Romania",
  description:
    "Comparatie intre programe de casa de marcat si POS pentru magazine din Romania, cu surse publice de la producatori.",
  itemListElement: vendors.map((v, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: v.name,
    url: v.url,
  })),
};
---

<GuideShell
  title="Comparatie programe casa de marcat si POS pentru magazine | Tapselo"
  description="Programe de casa de marcat si POS din Romania, comparate dupa offline, imprimanta fiscala, cantare, retete, stocuri, comenzi online, receptie marfa din foto, arhiva .p7b, oferte clienti si asistent AI. Date de pe site-urile producatorilor, cu surse."
  heading="Comparatie programe de casa de marcat"
  lead="Ce stie fiecare program, dupa informatiile publice de pe site-ul producatorului."
  ctaTitle="Vrei sa vezi Tapselo la lucru?"
  verifiedOn={dates.at(-1) ?? null}
  campaign="comparatie"
  breadcrumb={false}
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredList)} />

  <p class="rounded-xl border border-ticket bg-ticket-light p-4 text-sm text-primary">
    Pagina este facuta de Tapselo, unul dintre producatorii din tabel. Datele vin de pe site-urile producatorilor, verificate la {range}.
    "necunoscut" inseamna ca informatia nu este publica pe site-ul producatorului.
  </p>

  <nav aria-label="Filtre">
    <p class="text-sm font-bold text-primary">Arata programele care au:</p>
    <div class="mt-3 flex flex-wrap gap-2">
      {needs.map(([key, n]) => (
        <a href={`#are-${key}`} class="rounded-full border border-border px-3 py-1 text-sm text-text-secondary hover:border-accent hover:text-accent">{n.label}</a>
      ))}
    </div>
  </nav>

  <section>
    <h2 class="font-display text-3xl italic text-primary">Tabel</h2>
    <div class="mt-6 overflow-x-auto">
      <table class="kb-table">
        <thead>
          <tr>
            <th>Program</th>
            {needs.map(([, n]) => <th>{n.label}</th>)}
            <th>Pret de la</th>
            <th>Verificat</th>
          </tr>
        </thead>
        <tbody>
          {vendors.map((v) => {
            const logo = vendorLogoPath(v.id);
            return (
            <tr>
              <td>
                <span class="vendor-cell">
                  {logo && (
                    <img src={logo} alt="" width={28} height={28} class="vendor-logo" loading="lazy" decoding="async" />
                  )}
                  <a href={`#${v.id}`} class="font-medium text-accent hover:text-accent-hover">{v.name}</a>
                </span>
              </td>
              {needs.map(([, n]) => {
                const s = state(v, n.field);
                return <td class={markClass(s)}>{mark(s)}</td>;
              })}
              <td>{v.pricing_from ?? "necunoscut"}</td>
              <td class="whitespace-nowrap">{v.verified_on ? formatDateRo(v.verified_on) : "necunoscut"}</td>
            </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>

  {needs.map(([key, n]) => {
    const yes = vendors.filter((v) => state(v, n.field) === true);
    const unknown = vendors.filter((v) => state(v, n.field) === null);
    return (
      <section id={`are-${key}`}>
        <h2 class="font-display text-3xl italic text-primary">{n.label}</h2>
        <p class="mt-3 text-text-secondary">
          Da: {yes.length ? yes.map((v, j) => (<>{j > 0 && ", "}<a href={`#${v.id}`} class="text-accent hover:text-accent-hover">{v.name}</a></>)) : "niciun program din lista"}.
        </p>
        {unknown.length > 0 && (
          <p class="mt-1 text-sm text-text-muted">Necunoscut: {unknown.map((v) => v.name).join(", ")}.</p>
        )}
      </section>
    );
  })}

  <section>
    <h2 class="font-display text-3xl italic text-primary">Detalii pe producator</h2>
    <div class="mt-6 space-y-6">
      {vendors.map((v) => {
        const logo = vendorLogoPath(v.id);
        return (
        <div id={v.id} class="rounded-xl border border-border-light p-5">
          <h3 class="text-primary">
            <span class="vendor-cell">
              {logo && (
                <img src={logo} alt="" width={32} height={32} class="vendor-logo" loading="lazy" decoding="async" />
              )}
              <a href={v.url} rel="noopener" target="_blank" class="hover:text-accent">{v.name}</a>
            </span>
          </h3>
          {v.segments && v.segments.length > 0 && <p class="mt-1 text-sm text-text-muted">Pentru: {v.segments.join(", ")}</p>}
          {v.notes && <p class="mt-3 leading-relaxed text-text-secondary">{v.notes}</p>}
          <p class="mt-3 text-sm text-text-secondary">
            <strong class="text-primary">Preturi:</strong> {v.pricing_public ?? "necunoscut"}
            {v.pricing_from && <> (de la {v.pricing_from})</>}
          </p>
          {v.sources && v.sources.length > 0 && (
            <p class="mt-2 text-sm text-text-muted">
              Surse:{" "}
              {v.sources.map((s, j) => (<>{j > 0 && ", "}<a href={s.url} rel="noopener" target="_blank" class="text-accent hover:text-accent-hover">{s.title}</a></>))}
            </p>
          )}
          <p class="mt-1 text-sm text-text-muted">Verificat la {v.verified_on ? formatDateRo(v.verified_on) : "necunoscut"}.</p>
        </div>
        );
      })}
    </div>
  </section>
</GuideShell>

<style>
  .vendor-cell {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    vertical-align: middle;
  }
  .vendor-logo {
    border-radius: 6px;
    object-fit: contain;
    flex-shrink: 0;
    background: var(--color-surface-white);
    box-shadow: 0 0 0 1px var(--color-border-light);
  }
</style>
