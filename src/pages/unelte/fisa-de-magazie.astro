---
import ToolShell from "../../components/ToolShell.astro";
import FisaMagazieTool from "../../components/unelte/FisaMagazieTool.astro";
import { internalPath } from "../../lib/internal-url.ts";
import { toolJsonLd } from "../../lib/unelte/jsonld.ts";

const path = "/unelte/fisa-de-magazie/";
const heading = "Fișă de magazie (cod 14-3-8): model PDF";

const OMFP_URL = "https://legislatie.just.ro/Public/DetaliiDocumentAfis/173682";
const NORMS_URL = "https://legislatie.just.ro/Public/DetaliiDocument/173807";

const FISA_PURPOSE =
  "Fișa de magazie servește ca document de evidență a intrărilor, ieșirilor și stocurilor de bunuri materiale.";
const FISA_KEEPING =
  "Fișele de magazie se țin pe fiecare loc de depozitare a valorilor materiale, pe feluri de materiale, ordonate pe conturi, grupe, eventual subgrupe, sau în ordine alfabetică.";
const FISA_CUSTODY =
  "Pentru valori materiale primite spre prelucrare de la terți sau în custodie se întocmesc fișe distincte, care se țin separat de cele aferente propriilor valori materiale.";
const FISA_DOC_BY_DOC = "Înregistrările în fișele de magazie se fac document cu document.";

const faq = [
  {
    q: "Ce este fișa de magazie (cod 14-3-8)?",
    a: `Fișa de magazie poartă codul 14-3-8 în OMFP nr. 2.634/2015. Normele la același ordin spun: „${FISA_PURPOSE}” (sursă: ${NORMS_URL}). În generator completați antetul și mișcările; stocul se calculează automat.`,
  },
  {
    q: "Unde găsesc un model de fișă de magazie?",
    a: `Pe această pagină aveți generatorul gratuit aliniat codului 14-3-8 și butonul „Model gol (PDF)” pentru o foaie tipărită fără date. OMFP nr. 2.634/2015 listează „Fișă de magazie” cu codul 14-3-8 printre documentele financiar-contabile care se păstrează timp de 5 ani (Anexa nr. 4) (sursă: ${OMFP_URL}).`,
  },
  {
    q: "Trebuie să o țin pe fiecare magazie / produs?",
    a: `Normele OMFP nr. 2.634/2015 spun: „${FISA_KEEPING}” „${FISA_CUSTODY}” „${FISA_DOC_BY_DOC}” (sursă: ${NORMS_URL}). Adică o fișă pentru fiecare fel de material, pe fiecare loc de depozitare.`,
  },
  {
    q: "Pot descărca un model gol în PDF?",
    a: "Da — butonul „Model gol (PDF)” de sub titlu sau din generator deschide o fișă 14-3-8 cu antetul tipizatului și rânduri goale, pe care o salvați sau tipăriți din browser, fără să completați câmpurile de mai sus.",
  },
  {
    q: "Pot folosi generatorul fără cont Tapselo?",
    a: "Da. Unealta rulează în browser, datele rămân pe dispozitivul dumneavoastră și nu trimitem conținutul documentului în analytics.",
  },
  {
    q: "Cum leg fișa de magazie de NIR?",
    a: "La recepție, intrarea pe fișă se face pe baza NIR-ului sau a facturii: data, numărul și felul documentului, cantitatea la intrări. Pentru NIR printabil din factură, folosiți generatorul nostru de NIR.",
  },
  {
    q: "Stocul se calculează singur?",
    a: "Da — completați stocul inițial, apoi intrările și ieșirile pe fiecare rând; coloana Stoc și totalul final se actualizează automat înainte de print sau PDF.",
  },
];

const jsonLd = toolJsonLd({
  path,
  heading,
  appName: "Fișă de magazie (cod 14-3-8): model PDF | Tapselo",
  description:
    "Model fișă de magazie gratuit, cod 14-3-8 OMFP 2.634/2015: generator cu stoc automat sau model gol PDF, print în browser.",
  faq,
});
---

<ToolShell
  title="Fișă de magazie (cod 14-3-8) — model PDF | Tapselo"
  description="Model fișă de magazie gratuit, cod 14-3-8 OMFP 2.634/2015: generator 14-3-8, PDF, print și model gol pentru intrări, ieșiri și stoc."
  heading={heading}
  path={path}
  lead={`${FISA_PURPOSE.replace(/^Fișa de magazie/, "Fișa de magazie (cod 14-3-8)").replace(/\.\s*$/, "")} — completați antetul și mișcările în generator, sau descărcați modelul gol în PDF pentru completare manuală.`}
  campaign="fisa-de-magazie"
  ctaTitle="Stocuri și NIR în același program"
  ctaBody="În Tapselo, recepția din poză de factură și vânzările actualizează stocul — ca să nu rescrieți aceleași cantități în Excel."
  related={[
    { href: "/unelte/generator-nir/", label: "Generator NIR" },
    { href: "/ghid/nir-nota-receptie/", label: "NIR: nota de recepție" },
    { href: "/unelte/generator-aviz-de-insotire/", label: "Aviz de însoțire a mărfii" },
  ]}
  jsonLd={jsonLd}
  faq={faq}
>
  <div slot="hero-actions" class="mt-6 flex flex-col gap-2 sm:flex-row sm:flex-wrap sm:items-center">
    <button type="button" class="ut-btn ut-btn-secondary" id="fm-blank-hero">Model gol (PDF)</button>
    <p class="text-sm text-text-on-primary/80 sm:max-w-lg">
      Foaie 14-3-8 cu antet și rânduri goale — salvare sau print din browser, fără date în formular.
    </p>
  </div>

  <FisaMagazieTool />

  <article class="site-prose prose-tapselo space-y-8 text-text-secondary leading-relaxed">
    <section>
      <h2 class="font-display text-2xl italic text-primary">Ce este fișa de magazie</h2>
      <p>
        Fișa de magazie este registrul în care urmăriți, pentru <strong class="text-primary">un singur produs</strong> (sau sortiment)
        și pentru <strong class="text-primary">o magazie</strong>, cum intră și cum iese marfa și ce stoc rămâne după fiecare document.
        OMFP nr. 2.634/2015 o listează ca <strong class="text-primary">„Fișă de magazie”</strong>, cod <strong class="text-primary">14-3-8</strong>,
        printre documentele financiar-contabile care se păstrează timp de 5 ani (Anexa nr. 4) (
        <a href={OMFP_URL} class="font-semibold text-accent hover:underline">legislatie.just.ro — OMFP 2.634/2015</a>).
      </p>
      <p>
        Normele la același ordin prevăd: „{FISA_PURPOSE}” „{FISA_KEEPING}” „{FISA_CUSTODY}” „{FISA_DOC_BY_DOC}”
        (sursă: <a href={NORMS_URL} class="font-semibold text-accent hover:underline">legislatie.just.ro — norme specifice OMFP 2.634/2015</a>).
      </p>
      <p>
        Pentru un magazin mic, fișa de magazie este harta zilnică a raftului: știți dacă stocul din sistem (sau din registru) se leagă de
        NIR-uri, bonuri de consum, avize sau transferuri între gestiuni.
      </p>
    </section>

    <section>
      <h2 class="font-display text-2xl italic text-primary">Cine folosește fișa de magazie</h2>
      <p>
        Fișele se țin acolo unde există <strong class="text-primary">gestiune de stocuri</strong> — magazine alimentare, băcănii, brutării și patiserii
        care recepționează marfă, produc din rețete sau transferă între puncte de lucru. Contabilul poate cere fișe pe hârtie, export din program sau ambele.
      </p>
      <p>
        Dacă folosiți deja un soft de gestiune, rapoartele din program înlocuiesc adesea fișa clasică — dar la controale sau la reconcilierea
        cu NIR-urile, un PDF lizibil pe modelul 14-3-8 rămâne util. Generatorul de mai sus este gratuit și nu înlocuiește politica contabilă
        a firmei dumneavoastră; îl folosiți ca șablon sau arhivă.
      </p>
    </section>

    <section>
      <h2 class="font-display text-2xl italic text-primary">Cum completați formularul 14-3-8</h2>
      <p>Modelul oficial are, în antet:</p>
      <ul class="list-disc space-y-2 pl-5">
        <li><strong class="text-primary">Unitatea</strong> (denumirea firmei);</li>
        <li><strong class="text-primary">Magazia</strong> (locul de depozitare);</li>
        <li><strong class="text-primary">Materialul</strong> (produsul), <strong class="text-primary">U/M</strong> și <strong class="text-primary">preț unitar</strong> unde este cazul;</li>
        <li>pe fiecare rând: <strong class="text-primary">data</strong>, <strong class="text-primary">documentul</strong> (număr și fel), <strong class="text-primary">intrări</strong>, <strong class="text-primary">ieșiri</strong>, <strong class="text-primary">stoc</strong> și coloana pentru <strong class="text-primary">data și semnătura de control</strong>.</li>
      </ul>
      <p>
        În practică, la <strong class="text-primary">intrări</strong> treceți cantitatea din NIR sau din factura de achiziție; la <strong class="text-primary">ieșiri</strong> — vânzări zilnice centralizate, bon de consum pentru producție sau transfer către altă magazie. Stocul se obține rulând soldul: stoc anterior plus intrări minus ieșiri. Generatorul face aritmetica pentru dumneavoastră; pe hârtie puteți verifica manual ultimul rând înainte de semnătură.
      </p>
      <p>
        Pentru recepție, completați întâi <a href={internalPath("/unelte/generator-nir/")} class="font-semibold text-accent hover:underline">nota de recepție (NIR)</a> — cod 14-3-1A din același ordin — apoi copiați pe fișă data, numărul și cantitatea recepționată. Astfel NIR-ul și fișa de magazie spun aceeași poveste.
      </p>
    </section>

    <section>
      <h2 class="font-display text-2xl italic text-primary">Sfaturi pentru magazine mici</h2>
      <ul class="list-disc space-y-2 pl-5">
        <li>Țineți o fișă pentru produsele cu rotație mare sau cu risc de diferențe (lactate, carne, băuturi).</li>
        <li>Notați felul documentului clar: „NIR”, „Aviz”, „Bon consum”, „Transfer” — contabilul recunoaște rapid sursa.</li>
        <li>La sfârșit de lună, comparați stocul din fișă cu inventarul fizic; diferențele le discutați cu echipa și le documentați.</li>
        <li>Folosiți butonul „Model gol (PDF)” dacă vreați doar layout-ul tipărit, fără date, pentru completare manuală la depozit.</li>
      </ul>
    </section>

    <section>
      <h2 class="font-display text-2xl italic text-primary">Confidențialitate</h2>
      <p class="text-sm">
        Numele produselor, prețurile și cantitățile introduse rămân în browser. Analytics-ul Tapselo înregistrează doar că ați folosit unealta
        (acțiuni print sau generate_pdf), fără conținut din formular.
      </p>
    </section>
  </article>
</ToolShell>
