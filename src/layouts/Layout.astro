---
import "../styles/global.css";
import PostHog from "../components/PostHog.astro";
import { OPERATOR_LEGAL_NAME, PFA_CUI } from "../data/site.ts";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Extra JSON-LD objects (WebApplication, Article, HowTo, FAQPage, BreadcrumbList, …). */
  jsonLd?: Record<string, unknown>[];
  /** ISO date for article:published_time (articles only). */
  publishedTime?: string;
  /** ISO date for article:modified_time (articles only). */
  modifiedTime?: string;
  /** Site-wide SoftwareApplication JSON-LD; off on vendor comparison pages. */
  appJsonLd?: boolean;
}

const {
  title = "Tapselo POS — Casa de marcat pentru magazine alimentare",
  description = "Casa de marcat care merge și fără internet. Cu bon fiscal, cântar integrat și rapoarte inteligente. Gata în 20 de minute, pe orice calculator.",
  noindex = false,
  jsonLd = [],
  publishedTime,
  modifiedTime,
  appJsonLd = true,
} = Astro.props;

const siteUrl = "https://tapselo.com";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = `${siteUrl}/og-image.jpg`;
const tapseloAppDescription =
  "Casa de marcat care merge și fără internet. Cu bon fiscal, cântar integrat și rapoarte inteligente. Gata în 20 de minute, pe Windows, macOS sau Linux.";
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Favicon (https://developers.google.com/search/docs/appearance/favicon-in-search) -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#0f172a" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ro_RO" />
    <meta property="og:site_name" content="Tapselo POS" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Structured Data -->
    {appJsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Tapselo POS",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Windows, macOS, Linux",
      "description": tapseloAppDescription,
      "url": siteUrl,
      "image": ogImageUrl,
      "offers": {
        "@type": "Offer",
        "priceCurrency": "RON",
        "description": "gratuit cât timp e în beta, apoi 79/129 lei/lună + TVA"
      },
      "author": {
        "@type": "Organization",
        "name": "Tapselo",
        "legalName": OPERATOR_LEGAL_NAME,
        "taxID": PFA_CUI,
        "url": siteUrl,
        "logo": `${siteUrl}/logo.png`,
        "contactPoint": {
          "@type": "ContactPoint",
          "email": "contact@tapselo.com",
          "contactType": "sales"
        }
      }
    })} />
    )}
    {jsonLd.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}

    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="font-sans antialiased">
    <PostHog />
    <slot />

    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.05, rootMargin: "0px 0px -20px 0px" }
        );

        document.querySelectorAll(".animate-on-scroll").forEach((el) => {
          observer.observe(el);
        });
      });

    </script>
  </body>
</html>
