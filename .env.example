# Base URL of the Coolify-deployed A4200 PDF service (no trailing slash).
# When unset, the “Generează PDF A4200” button is hidden on /ghid/verificare-a4200.
PUBLIC_A4200_PDF_URL=

# Base URL of the barcode -> TVA lookup used on /unelte/calculator-tva (no trailing slash).
# GET {url}/barcodes/:ean. Unset or empty: /api (same-origin Pages Function functions/api/barcodes/[ean].ts).
# Set to "off" to hide the EAN lookup.
PUBLIC_BARCODE_API_URL=

# Meta Pixel ID (numeric). Used ONLY on /demo/; unset or empty: no pixel, no consent banner,
# no demo_started events. Build-time (GitHub Actions variable for deploy.yml).
PUBLIC_META_PIXEL_ID=

# Server-only, set in Cloudflare Pages → Settings → Environment variables (Production), never here:
#   META_CAPI_TOKEN   Conversions API access token (encrypted secret). Unset: /api/meta-capi is a no-op.
#   META_PIXEL_ID     same value as PUBLIC_META_PIXEL_ID
#   META_GRAPH_VERSION (optional, default v24.0), META_TEST_EVENT_CODE (optional, Events Manager tests)
